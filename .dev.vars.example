# Copy this file to .dev.vars (gitignored) to run `astro dev` / `npm run pages:dev`
# against real Google Sheets locally. Never commit the real .dev.vars file.

# Contents of the Google service account JSON key, as a single-line JSON string.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# The spreadsheet ID from its URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SPREADSHEET_ID=1LzjAqTdFRhwvwbbP4F8gEStmU2_Bxqq1vZ-xSPBr3-I

# Shared login password for the internal app (single user for now).
AUTH_PASSWORD=change-me-locally

# HMAC key used to sign session cookies. Must be a different value than
# AUTH_PASSWORD. Generate with: openssl rand -base64 32
SESSION_SIGNING_SECRET=change-me-locally-too
