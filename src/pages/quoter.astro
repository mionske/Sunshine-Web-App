---
import BaseLayout from '../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { findById, listActiveRows } from '../lib/sheets';
import { clientConfig } from '../lib/models/client';
import { propertyConfig, derivePropertyCompatDefaults } from '../lib/models/property';
import { walkthroughConfig } from '../lib/models/walkthrough';
import { walkthroughItemConfig } from '../lib/models/walkthroughItem';
import { seedInitialServices } from '../lib/pricing/services';
import { serviceConfig } from '../lib/models/service';
import { createQuote, updateQuote } from '../lib/pricing/quotes';
import { quoteConfig, type Quote } from '../lib/models/quote';
import { itemsToQuoteCounts, conditionForEngine } from '../lib/pricing/walkthroughToQuote';
import { listPricingConfigs } from '../lib/pricing/config';
import QuoterForm, { type InitialQuoteData } from '../components/QuoterForm';
import type { QuoteCounts, QuoteInput } from '../lib/pricing/types';

let error: string | null = null;
const editQuoteId = Astro.url.searchParams.get('quoteId') ?? '';
const duplicateFromId = Astro.url.searchParams.get('duplicateFrom') ?? '';

function num(form: FormData, key: string): number {
	const value = Number(form.get(key));
	return Number.isFinite(value) ? value : 0;
}

function on(form: FormData, key: string): boolean {
	return form.get(key) === 'on' || form.get(key) === 'true';
}

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	try {
		const counts: QuoteCounts = {
			windowExtStandard: num(form, 'windowExtStandard'),
			windowIntStandard: num(form, 'windowIntStandard'),
			windowExtOversized: num(form, 'windowExtOversized'),
			windowIntOversized: num(form, 'windowIntOversized'),
			windowExtFrenchPane: num(form, 'windowExtFrenchPane'),
			windowIntFrenchPane: num(form, 'windowIntFrenchPane'),
			slidingDoorExt: num(form, 'slidingDoorExt'),
			slidingDoorInt: num(form, 'slidingDoorInt'),
			screenClean: num(form, 'screenClean'),
			trackBasic: num(form, 'trackBasic'),
			trackDeep: num(form, 'trackDeep'),
			skylightExt: num(form, 'skylightExt'),
			skylightInt: num(form, 'skylightInt'),
		};

		// The engine's single difficultAccess boolean is derived from
		// whichever job-specific access flags are checked (see the comment
		// on Quote schema's job-condition fields) — one thing still actually
		// drives the access surcharge, even though the form now captures the
		// granular reasons why for reporting.
		const jobConditions = {
			highInteriorGlass: on(form, 'jobHighInteriorGlass'),
			steepOrUnevenTerrain: on(form, 'jobSteepOrUnevenTerrain'),
			exteriorAccessObstructed: on(form, 'jobExteriorAccessObstructed'),
			furnitureMovementRequired: on(form, 'jobFurnitureMovementRequired'),
			waterAccessDifficult: on(form, 'jobWaterAccessDifficult'),
			siliconeOrStickerResidue: on(form, 'jobSiliconeOrStickerResidue'),
			heavyInteriorResidue: on(form, 'jobHeavyInteriorResidue'),
			otherConditionNotes: String(form.get('jobOtherConditionNotes') ?? ''),
		};
		const difficultAccess =
			jobConditions.highInteriorGlass ||
			jobConditions.steepOrUnevenTerrain ||
			jobConditions.exteriorAccessObstructed ||
			jobConditions.furnitureMovementRequired ||
			jobConditions.waterAccessDifficult;

		const input: QuoteInput = {
			stories: (Number(form.get('stories')) || 1) as 1 | 2 | 3,
			condition: String(form.get('condition') ?? 'light') as 'light' | 'moderate' | 'heavy' | 'firstTime',
			counts,
			hardWater: on(form, 'hardWater'),
			constructionDebris: on(form, 'constructionDebris'),
			difficultAccess,
			manualAdjustment: num(form, 'manualAdjustment'),
			discount: num(form, 'discount'),
			overrideReason: String(form.get('overrideReason') ?? ''),
		};
		const sharedParams = {
			pricingConfigId: String(form.get('pricingConfigId') ?? '') || undefined,
			serviceScope: String(form.get('serviceScope') ?? ''),
			inventoryCoverage: String(form.get('inventoryCoverage') ?? ''),
			laborEstimate: {
				soloHours: String(form.get('laborEstimateSoloHours') ?? ''),
				crewSize: String(form.get('laborEstimateCrewSize') ?? ''),
				confidence: String(form.get('laborEstimateConfidence') ?? ''),
				notes: String(form.get('laborEstimateNotes') ?? ''),
			},
			jobConditions,
			input,
		};

		const submittedQuoteId = String(form.get('quoteId') ?? '');
		if (submittedQuoteId) {
			const existingQuote = await findById(env, quoteConfig, submittedQuoteId);
			if (!existingQuote) throw new Error(`Quote "${submittedQuoteId}" not found`);
			if (existingQuote['Quote Status'] === 'Accepted') {
				throw new Error('This quote is Accepted — change its status away from Accepted first if it needs correcting.');
			}
			await updateQuote(env, submittedQuoteId, sharedParams);
			return Astro.redirect(`/quotes/${submittedQuoteId}`);
		}

		const { quote } = await createQuote(env, {
			clientId: String(form.get('clientId') ?? ''),
			propertyId: String(form.get('propertyId') ?? ''),
			walkthroughId: String(form.get('walkthroughId') ?? '') || undefined,
			...sharedParams,
		});
		return Astro.redirect(`/quotes/${quote['Quote ID']}`);
	} catch (e) {
		error = (e as Error).message;
	}
}

await seedInitialServices(env);
const [clients, properties, pricingConfigs, services, allWalkthroughs, allWalkthroughItems] = await Promise.all([
	listActiveRows(env, clientConfig),
	listActiveRows(env, propertyConfig),
	listPricingConfigs(env),
	listActiveRows(env, serviceConfig),
	listActiveRows(env, walkthroughConfig),
	listActiveRows(env, walkthroughItemConfig),
]);
const clientById = Object.fromEntries(clients.map((c) => [c['Client ID'], c]));
const activeConfigs = pricingConfigs.filter((c) => c.Status === 'Active');
const preselectedPropertyId = Astro.url.searchParams.get('propertyId') ?? '';
const preselectedClientId = Astro.url.searchParams.get('clientId') ?? '';

// Shared by edit mode (?quoteId=X) and duplicate mode (?duplicateFrom=X) —
// everything the form needs to re-populate comes straight from the source
// Quote: the stored Input Snapshot is already the exact QuoteInput shape,
// and the rest (serviceScope, labor estimate, job condition flags) are plain
// Quote columns. Edit mode keeps this quoteId (submits back in place);
// duplicate mode discards it (see quoter.astro's POST handler / QuoterForm's
// quoterMode prop) so the submission creates a brand new Quote instead.
function buildInitialQuoteData(sourceQuote: Quote): InitialQuoteData {
	const snapshot = JSON.parse(sourceQuote['Input Snapshot'] || '{}') as Partial<QuoteInput>;
	return {
		quoteId: sourceQuote['Quote ID'],
		clientId: sourceQuote['Client ID'],
		propertyId: sourceQuote['Property ID'],
		pricingConfigId: sourceQuote['Pricing Config ID'],
		serviceScope: sourceQuote['Service Scope'],
		inventoryCoverage: sourceQuote['Inventory Coverage'],
		counts: snapshot.counts ?? {
			windowExtStandard: 0,
			windowIntStandard: 0,
			windowExtOversized: 0,
			windowIntOversized: 0,
			windowExtFrenchPane: 0,
			windowIntFrenchPane: 0,
			slidingDoorExt: 0,
			slidingDoorInt: 0,
			screenClean: 0,
			trackBasic: 0,
			trackDeep: 0,
			skylightExt: 0,
			skylightInt: 0,
		},
		stories: snapshot.stories ?? 1,
		condition: snapshot.condition ?? 'light',
		hardWater: snapshot.hardWater ?? false,
		constructionDebris: snapshot.constructionDebris ?? false,
		jobHighInteriorGlass: sourceQuote['Job High Interior Glass (Y/N)'] === 'Y',
		jobSteepOrUnevenTerrain: sourceQuote['Job Steep Or Uneven Terrain (Y/N)'] === 'Y',
		jobExteriorAccessObstructed: sourceQuote['Job Exterior Access Obstructed (Y/N)'] === 'Y',
		jobFurnitureMovementRequired: sourceQuote['Job Furniture Movement Required (Y/N)'] === 'Y',
		jobWaterAccessDifficult: sourceQuote['Job Water Access Difficult (Y/N)'] === 'Y',
		jobSiliconeOrStickerResidue: sourceQuote['Job Silicone Or Sticker Residue (Y/N)'] === 'Y',
		jobHeavyInteriorResidue: sourceQuote['Job Heavy Interior Residue (Y/N)'] === 'Y',
		otherConditionNotes: sourceQuote['Job Other Condition Notes'],
		laborSoloHours: sourceQuote['Labor Estimate Solo Hours'],
		laborCrewSize: sourceQuote['Labor Estimate Crew Size'],
		laborConfidence: sourceQuote['Labor Estimate Confidence'],
		laborNotes: sourceQuote['Labor Estimate Notes'],
		manualAdjustment: String(snapshot.manualAdjustment ?? 0),
		discount: String(snapshot.discount ?? 0),
		overrideReason: snapshot.overrideReason ?? sourceQuote['Override Reason'],
	};
}

let initialQuoteData: InitialQuoteData | null = null;
let quoterMode: 'edit' | 'duplicate' = 'edit';
if (editQuoteId && !error) {
	const editingQuote = await findById(env, quoteConfig, editQuoteId);
	if (!editingQuote) {
		error = `Quote "${editQuoteId}" not found.`;
	} else if (editingQuote['Quote Status'] === 'Accepted') {
		error = 'This quote is Accepted — change its status away from Accepted first (see the Quote page) if it needs correcting.';
	} else {
		initialQuoteData = buildInitialQuoteData(editingQuote);
	}
} else if (duplicateFromId && !error) {
	quoterMode = 'duplicate';
	const sourceQuote = await findById(env, quoteConfig, duplicateFromId);
	if (!sourceQuote) {
		error = `Quote "${duplicateFromId}" not found.`;
	} else {
		initialQuoteData = buildInitialQuoteData(sourceQuote);
	}
}

// Quoter redesign: the Quote Inventory card defaults from the property's
// latest completed Walkthrough (via the already-reusable itemsToQuoteCounts)
// rather than the Property's own Windows & Doors counts — that record uses
// a categorically different taxonomy (no interior/exterior split, no
// Standard-vs-Oversized distinction), so it can't be mapped into QuoteCounts
// without guessing. Falls back to blank/manual entry when no qualifying
// walkthrough exists yet.
const INVENTORY_SOURCE_STATUSES = new Set(['Completed', 'Converted to Quote']);
const latestWalkthroughByProperty: Record<string, { walkthroughId: string; walkthroughDate: string; counts: QuoteCounts } | null> = {};
for (const property of properties) {
	const candidates = allWalkthroughs
		.filter((w) => w['Property ID'] === property['Property ID'] && INVENTORY_SOURCE_STATUSES.has(w.Status))
		.sort((a, b) => (b['Walkthrough Date'] || b['Created At']).localeCompare(a['Walkthrough Date'] || a['Created At']));
	const latest = candidates[0];
	if (!latest) {
		latestWalkthroughByProperty[property['Property ID']] = null;
		continue;
	}
	const items = allWalkthroughItems.filter((i) => i['Walkthrough ID'] === latest['Walkthrough ID']);
	latestWalkthroughByProperty[property['Property ID']] = {
		walkthroughId: latest['Walkthrough ID'],
		walkthroughDate: latest['Walkthrough Date'],
		counts: itemsToQuoteCounts(items),
	};
}

// Read-only property summary strip (Quote Header) — reuses the same
// compat-default derivation as the Property Detail page so a
// pre-redesign legacy value still shows correctly translated here too.
// Also carries the raw Access Considerations / Glass Condition flags,
// which the Current Job Conditions card pre-fills from and diffs against
// (see the handoff's "This quote differs from the saved property details"
// notice) — these mirror the exact Property columns 1:1.
const propertySummaryById = Object.fromEntries(
	properties.map((p) => {
		const compat = derivePropertyCompatDefaults(p);
		return [
			p['Property ID'],
			{
				stories: p.Stories,
				totalWindowUnits: p['Total Window Units'],
				totalGlassPanes: p['Total Glass Panes'],
				windowCondition: p['Window Condition'],
				exteriorCleaningMethod: compat.exteriorCleaningMethodValue,
				ladderRequirement: compat.ladderRequirementValue,
				conditionDefault: conditionForEngine(p['Window Condition']),
				highInteriorGlass: p['High Interior Glass (Y/N)'],
				steepOrUnevenTerrain: p['Steep Or Uneven Terrain (Y/N)'],
				exteriorAccessObstructed: p['Exterior Access Obstructed (Y/N)'],
				furnitureMovementRequired: p['Furniture Or Belongings Movement Required (Y/N)'],
				waterSourceFarFromWorkArea: p['Water Source Far From Work Area (Y/N)'],
				siliconeResidue: p['Silicone Adhesive Or Sticker Residue (Y/N)'],
				heavyInteriorResidue: p['Heavy Interior Residue (Y/N)'],
			},
		];
	})
);
---

<BaseLayout title={editQuoteId ? 'Edit quote' : duplicateFromId ? 'Duplicate quote' : 'In-field quoter'}>
	<main>
		<h1>{editQuoteId ? 'Edit quote' : duplicateFromId ? 'Duplicate quote' : 'In-field quoter'}</h1>
		{error && <p role="alert">{error}</p>}

		{(!(editQuoteId || duplicateFromId) || initialQuoteData) && (
			<QuoterForm
				client:load
				clients={clients.map((c) => ({ id: c['Client ID'], firstName: c['First Name'], lastName: c['Last Name'] }))}
				properties={properties.map((p) => ({
					id: p['Property ID'],
					clientId: p['Client ID'],
					address: p['Street Address'],
					propertyType: p['Property Type'],
				}))}
				clientLastNameById={Object.fromEntries(clients.map((c) => [c['Client ID'], c['Last Name']]))}
				propertySummaryById={propertySummaryById}
				latestWalkthroughByProperty={latestWalkthroughByProperty}
				pricingConfigs={activeConfigs}
				services={services}
				preselectedClientId={preselectedClientId}
				preselectedPropertyId={preselectedPropertyId}
				initialQuote={initialQuoteData ?? undefined}
				quoterMode={quoterMode}
			/>
		)}
	</main>
</BaseLayout>
