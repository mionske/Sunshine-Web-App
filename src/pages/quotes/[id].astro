---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { findById, listActiveRows } from '../../lib/sheets';
import { quoteConfig } from '../../lib/models/quote';
import { quoteItemConfig } from '../../lib/models/quoteItem';
import { clientConfig } from '../../lib/models/client';
import { propertyConfig } from '../../lib/models/property';
import { acceptQuote, findJobByQuoteId, updateJobStatus, JOB_STATUSES } from '../../lib/pricing/jobLifecycle';
import { updateRow } from '../../lib/sheets';
import { REVIEW_LEFT_VALUES, MAINTENANCE_FOLLOW_UP_STATUSES } from '../../lib/models/job';
import { googleMapsUrl, fullAddress } from '../../lib/mapsLink';

const { id } = Astro.params;
let error: string | null = null;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = String(form.get('_action') ?? '');
	try {
		if (action === 'accept') {
			const scheduledDate = String(form.get('scheduledDate') ?? '');
			await acceptQuote(env, id!, { scheduledDate: scheduledDate || undefined });
		} else if (action === 'update-job-status') {
			const jobId = String(form.get('jobId') ?? '');
			const status = String(form.get('status') ?? '') as (typeof JOB_STATUSES)[number];
			await updateJobStatus(env, jobId, status, {
				'Actual Time (hrs)': String(form.get('actualTime') ?? ''),
				'Final Price ($)': String(form.get('finalPrice') ?? ''),
				'QB Invoice Link': String(form.get('qbInvoiceLink') ?? ''),
				'Review Requested At': String(form.get('reviewRequestedAt') ?? ''),
				'Review Left': String(form.get('reviewLeft') ?? ''),
				'Next Maintenance Follow-up Date': String(form.get('nextMaintenanceFollowUpDate') ?? ''),
				'Maintenance Follow-up Status': String(form.get('maintenanceFollowUpStatus') ?? ''),
			});
		} else if (action === 'update-qb-estimate-link') {
			await updateRow(env, quoteConfig, id!, { 'QB Estimate Link': String(form.get('qbEstimateLink') ?? '') });
		}
		return Astro.redirect(`/quotes/${id}`);
	} catch (e) {
		error = (e as Error).message;
	}
}

const quote = await findById(env, quoteConfig, id!);
if (!quote) {
	return new Response('Quote not found', { status: 404 });
}

const allItems = await listActiveRows(env, quoteItemConfig);
const items = allItems.filter((i) => i['Quote ID'] === id).sort((a, b) => Number(a['Sort Order']) - Number(b['Sort Order']));

const client = await findById(env, clientConfig, quote['Client ID']);
const property = await findById(env, propertyConfig, quote['Property ID']);
const job = await findJobByQuoteId(env, id!);

const canAccept = quote['Quote Status'] === 'Draft' || quote['Quote Status'] === 'Sent';
---

<BaseLayout title="Quote">
	<main>
		<p><a href="/quoter">← New quote</a></p>
		<h1>
			Quote for {property ? (
				<a href={googleMapsUrl(fullAddress(property))} target="_blank" rel="noopener noreferrer">
					{property['Street Address']}, {property.City}
				</a>
			) : (
				quote['Property ID']
			)}
		</h1>
		<p>
			Client: {client ? `${client['First Name']} ${client['Last Name']}` : quote['Client ID']}<br />
			Status: <span class="badge badge-accent">{quote['Quote Status']}</span>
		</p>
		{error && <p role="alert">{error}</p>}

		<div class="card">
			<table>
				<thead>
					<tr><th>Service</th><th>Qty</th><th>Unit price</th><th>Line total</th></tr>
				</thead>
				<tbody>
					{items.map((i) => (
						<tr>
							<td>{i.Description}</td>
							<td>{i.Quantity}</td>
							<td>${Number(i['Unit Price']).toFixed(2)}</td>
							<td>${Number(i['Line Total']).toFixed(2)}</td>
						</tr>
					))}
				</tbody>
			</table>

			<p class="stat">${Number(quote['Final Quoted Price']).toFixed(2)}</p>
			<p>
				Estimated labor hours: {Number(quote['Estimated Labor Hours']).toFixed(2)}<br />
				Expected revenue per labor hour: ${Number(quote['Expected Revenue Per Labor Hour']).toFixed(2)}<br />
				Target hourly rate: ${quote['Target Hourly Rate']}<br />
				Pricing Config: {quote['Pricing Config ID']} (calculator v{quote['Calculator Version']})
			</p>
		</div>

		<div class="card">
			<h2>QuickBooks</h2>
			{quote['QB Estimate Link'] && (
				<p><a href={quote['QB Estimate Link']} target="_blank" rel="noopener noreferrer">Open in QuickBooks →</a></p>
			)}
			<form method="POST">
				<input type="hidden" name="_action" value="update-qb-estimate-link" />
				<label>QB Estimate Link <input type="url" name="qbEstimateLink" value={quote['QB Estimate Link']} placeholder="https://..." /></label>
				<button type="submit">Save link</button>
			</form>
		</div>

		{canAccept && (
			<div class="card">
				<form method="POST">
					<input type="hidden" name="_action" value="accept" />
					<label>Scheduled date (optional) <input type="date" name="scheduledDate" /></label>
					<button type="submit">Accept quote</button>
				</form>
			</div>
		)}

		{job && (
			<div class="card">
				<h2>Job — <span class="badge">{job['Job Status']}</span></h2>
				<form method="POST">
					<input type="hidden" name="_action" value="update-job-status" />
					<input type="hidden" name="jobId" value={job['Job ID']} />
					<label>
						New status
						<select name="status">
							{JOB_STATUSES.map((s) => <option value={s} selected={s === job['Job Status']}>{s}</option>)}
						</select>
					</label>
					<label>Actual time (hrs) <input type="text" name="actualTime" value={job['Actual Time (hrs)']} /></label>
					<label>Final price ($) <input type="text" name="finalPrice" value={job['Final Price ($)']} /></label>
					<label>QB Invoice Link <input type="url" name="qbInvoiceLink" value={job['QB Invoice Link']} placeholder="https://..." /></label>
					{job['QB Invoice Link'] && (
						<p><a href={job['QB Invoice Link']} target="_blank" rel="noopener noreferrer">Open in QuickBooks →</a></p>
					)}
					<label>Review requested at <input type="date" name="reviewRequestedAt" value={job['Review Requested At']} /></label>
					<label>
						Review left
						<select name="reviewLeft">
							<option value="" selected={!job['Review Left']} />
							{REVIEW_LEFT_VALUES.map((v) => <option value={v} selected={v === job['Review Left']}>{v}</option>)}
						</select>
					</label>
					<label>Next maintenance follow-up date <input type="date" name="nextMaintenanceFollowUpDate" value={job['Next Maintenance Follow-up Date']} /></label>
					<label>
						Maintenance follow-up status
						<select name="maintenanceFollowUpStatus">
							<option value="" selected={!job['Maintenance Follow-up Status']} />
							{MAINTENANCE_FOLLOW_UP_STATUSES.map((v) => <option value={v} selected={v === job['Maintenance Follow-up Status']}>{v}</option>)}
						</select>
					</label>
					<button type="submit">Update job</button>
				</form>
			</div>
		)}
	</main>
</BaseLayout>
