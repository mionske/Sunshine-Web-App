---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { findById, listActiveRows } from '../../lib/sheets';
import { quoteConfig, QUOTE_STATUSES } from '../../lib/models/quote';
import { quoteItemConfig } from '../../lib/models/quoteItem';
import { clientConfig } from '../../lib/models/client';
import { propertyConfig } from '../../lib/models/property';
import { acceptQuote, findJobByQuoteId, updateJobStatus, JOB_STATUSES } from '../../lib/pricing/jobLifecycle';
import { deleteQuote, restoreQuote } from '../../lib/pricing/quotes';
import { updateRow } from '../../lib/sheets';
import { REVIEW_LEFT_VALUES, MAINTENANCE_FOLLOW_UP_STATUSES, jobConfig } from '../../lib/models/job';
import { googleMapsUrl, fullAddress } from '../../lib/mapsLink';
import { formatTimestamp } from '../../lib/format';
import { QBRelinkConfirmationRequiredError } from '../../lib/qb/matching';
import { syncSingleEntity } from '../../lib/qb/sync';
import {
	confirmQBEstimateLink,
	confirmQBInvoiceLink,
	findPaymentsForInvoice,
	findQBEstimateCandidates,
	findQBInvoiceCandidates,
	findStrongJobMatchSuggestion,
	findStrongQuoteMatchSuggestion,
	getLinkedQBEstimate,
	getLinkedQBInvoice,
	qboEstimateWebUrl,
	qboInvoiceWebUrl,
} from '../../lib/qb/recordLinking';

const { id } = Astro.params;
let error: string | null = null;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = String(form.get('_action') ?? '');
	try {
		if (action === 'accept') {
			const scheduledDate = String(form.get('scheduledDate') ?? '');
			await acceptQuote(env, id!, { scheduledDate: scheduledDate || undefined });
		} else if (action === 'update-quote-status') {
			// A plain status correction — never the "Accepted" path, which has
			// its own dedicated Accept-quote form below (it also creates the
			// linked Job; letting this generic dropdown set "Accepted" would
			// leave a Quote in that state with no Job, breaking every other
			// page's "an Accepted quote always has a Job" assumption).
			const status = String(form.get('status') ?? '') as (typeof QUOTE_STATUSES)[number];
			if (status === 'Accepted') {
				throw new Error('Use "Accept quote" below to mark a quote Accepted — it also creates the linked Job.');
			}
			const timestampFieldByStatus: Partial<Record<(typeof QUOTE_STATUSES)[number], string>> = {
				Sent: 'Sent At',
				Declined: 'Declined At',
				Expired: 'Expired At',
			};
			const patch: Record<string, string> = { 'Quote Status': status };
			const timestampField = timestampFieldByStatus[status];
			if (timestampField) patch[timestampField] = new Date().toISOString();
			await updateRow(env, quoteConfig, id!, patch);
		} else if (action === 'update-job-status') {
			const jobId = String(form.get('jobId') ?? '');
			const status = String(form.get('status') ?? '') as (typeof JOB_STATUSES)[number];
			await updateJobStatus(env, jobId, status, {
				'Scheduled Date': String(form.get('scheduledDate') ?? ''),
				'Actual Time (hrs)': String(form.get('actualTime') ?? ''),
				'Final Price ($)': String(form.get('finalPrice') ?? ''),
				'Review Requested At': String(form.get('reviewRequestedAt') ?? ''),
				'Review Left': String(form.get('reviewLeft') ?? ''),
				'Next Maintenance Follow-up Date': String(form.get('nextMaintenanceFollowUpDate') ?? ''),
				'Maintenance Follow-up Status': String(form.get('maintenanceFollowUpStatus') ?? ''),
			});
		} else if (action === 'link-qb-estimate') {
			const qbEstimateId = String(form.get('qbEstimateId') ?? '');
			const confirmRelink = form.get('confirmRelink') === 'on';
			await confirmQBEstimateLink(env, id!, qbEstimateId, { confirmRelink });
		} else if (action === 'dismiss-qb-estimate-suggestion') {
			await updateRow(env, quoteConfig, id!, { 'QB Match Suggestion Dismissed': String(form.get('qbEstimateId') ?? '') });
		} else if (action === 'refresh-qb-estimate') {
			await syncSingleEntity(env, 'Estimate', String(form.get('qbEstimateId') ?? ''));
		} else if (action === 'link-qb-invoice') {
			const jobId = String(form.get('jobId') ?? '');
			const qbInvoiceId = String(form.get('qbInvoiceId') ?? '');
			const confirmRelink = form.get('confirmRelink') === 'on';
			await confirmQBInvoiceLink(env, jobId, qbInvoiceId, { confirmRelink });
		} else if (action === 'dismiss-qb-invoice-suggestion') {
			await updateRow(env, jobConfig, String(form.get('jobId') ?? ''), {
				'QB Match Suggestion Dismissed': String(form.get('qbInvoiceId') ?? ''),
			});
		} else if (action === 'refresh-qb-invoice') {
			await syncSingleEntity(env, 'Invoice', String(form.get('qbInvoiceId') ?? ''));
		} else if (action === 'delete-quote') {
			await deleteQuote(env, id!);
			return Astro.redirect('/quotes');
		} else if (action === 'restore-quote') {
			await restoreQuote(env, id!);
		}
		return Astro.redirect(`/quotes/${id}`);
	} catch (e) {
		if (e instanceof QBRelinkConfirmationRequiredError) {
			error = `${e.message} Check "Confirm re-link" and submit again to proceed.`;
		} else {
			error = (e as Error).message;
		}
	}
}

const quote = await findById(env, quoteConfig, id!);
if (!quote) {
	return new Response('Quote not found', { status: 404 });
}

const allItems = await listActiveRows(env, quoteItemConfig);
const items = allItems.filter((i) => i['Quote ID'] === id).sort((a, b) => Number(a['Sort Order']) - Number(b['Sort Order']));

const client = await findById(env, clientConfig, quote['Client ID']);
const property = await findById(env, propertyConfig, quote['Property ID']);
const job = await findJobByQuoteId(env, id!);

const canAccept = quote['Quote Status'] === 'Draft' || quote['Quote Status'] === 'Sent';

// QuickBooks Estimate summary card data
const linkedEstimate = quote['QB Estimate ID'] ? await getLinkedQBEstimate(env, quote) : null;
const estimateObjectMissing = Boolean(quote['QB Estimate ID']) && !linkedEstimate;
const suggestedEstimate = !quote['QB Estimate ID'] && client ? await findStrongQuoteMatchSuggestion(env, quote, client) : null;
const estimateQuery = Astro.url.searchParams.get('estimateQuery');
const estimateScope = Astro.url.searchParams.get('estimateScope') === 'all' ? 'all' : 'client';
const estimateCandidates =
	!quote['QB Estimate ID'] && estimateQuery !== null
		? await findQBEstimateCandidates(env, {
				qbCustomerId: client?.['QB Customer ID'],
				searchAll: estimateScope === 'all' || !client?.['QB Customer ID'],
				query: estimateQuery,
			})
		: [];
const estimateMismatch =
	linkedEstimate && quote['Final Quoted Price'] && Number(quote['Final Quoted Price']) !== Number(linkedEstimate.Total);

// QuickBooks Invoice summary card data (only relevant once a Job exists)
const linkedInvoice = job?.['QB Invoice ID'] ? await getLinkedQBInvoice(env, job) : null;
const invoiceObjectMissing = Boolean(job?.['QB Invoice ID']) && !linkedInvoice;
const suggestedInvoice = job && !job['QB Invoice ID'] && client ? await findStrongJobMatchSuggestion(env, job, client) : null;
const invoiceQuery = Astro.url.searchParams.get('invoiceQuery');
const invoiceScope = Astro.url.searchParams.get('invoiceScope') === 'all' ? 'all' : 'client';
const invoiceCandidates =
	job && !job['QB Invoice ID'] && invoiceQuery !== null
		? await findQBInvoiceCandidates(env, {
				qbCustomerId: client?.['QB Customer ID'],
				searchAll: invoiceScope === 'all' || !client?.['QB Customer ID'],
				query: invoiceQuery,
			})
		: [];
const invoicePayments = linkedInvoice ? await findPaymentsForInvoice(env, linkedInvoice['QB Invoice ID']) : [];
const invoiceAmountPaid = linkedInvoice ? Number(linkedInvoice.Total) - Number(linkedInvoice.Balance) : 0;
const invoicePaymentDate = invoicePayments
	.map((p) => p['Payment Date'])
	.filter(Boolean)
	.sort()
	.at(-1);
const invoiceMismatch = linkedInvoice && job?.['Final Price ($)'] && Number(job['Final Price ($)']) !== Number(linkedInvoice.Total);
---

<BaseLayout title="Quote">
	<main>
		<p><a href="/quoter">← New quote</a></p>
		<h1>
			Quote for {property ? (
				<a href={googleMapsUrl(fullAddress(property))} target="_blank" rel="noopener noreferrer">
					{property['Street Address']}, {property.City}{property['Unit Identifier'] && <> — Unit {property['Unit Identifier']}</>}
				</a>
			) : (
				quote['Property ID']
			)}
		</h1>
		<p>
			Client: {client ? `${client['First Name']} ${client['Last Name']}` : quote['Client ID']}<br />
			Status: <span class="badge badge-accent">{quote['Quote Status']}</span>
			{quote['Quote Status'] !== 'Accepted' && !quote['Archived At'] && (
				<>
					{' · '}
					<a href={`/quoter?quoteId=${quote['Quote ID']}`}>Edit this quote</a>
				</>
			)}
			{' · '}
			<a href={`/quoter?duplicateFrom=${quote['Quote ID']}`}>Duplicate this quote</a>
			</p>
			{quote['Archived At'] ? (
				<div class="card">
					<p role="alert">This quote was deleted {formatTimestamp(quote['Archived At'])}. It's hidden from lists but still reachable by direct link.</p>
					<form method="POST" onsubmit="return confirm('Restore this quote? It will reappear everywhere in the app.')">
						<input type="hidden" name="_action" value="restore-quote" />
						<button type="submit" class="btn-secondary">Restore this quote</button>
					</form>
				</div>
			) : (
				<>
					<form method="POST" class="inline-field-form">
						<input type="hidden" name="_action" value="update-quote-status" />
						<label>
							Change status
							<select name="status">
								<option value="" disabled selected>— choose —</option>
								{QUOTE_STATUSES.filter((s) => s !== 'Accepted').map((s) => (
									<option value={s} selected={s === quote['Quote Status']}>{s}</option>
								))}
							</select>
						</label>
						<button type="submit" class="btn-secondary">Update status</button>
					</form>
					{quote['Quote Status'] !== 'Accepted' && (
						<form
							method="POST"
							onsubmit="return confirm('Delete this quote? It will be archived and removed from view everywhere in the app.')"
						>
							<input type="hidden" name="_action" value="delete-quote" />
							<button type="submit" class="btn-secondary">Delete this quote</button>
						</form>
					)}
				</>
			)}
			{error && <p role="alert">{error}</p>}

		<div class="card">
			<table>
				<thead>
					<tr><th>Service</th><th>Qty</th><th>Unit price</th><th>Line total</th></tr>
				</thead>
				<tbody>
					{items.map((i) => (
						<tr>
							<td>{i.Description}</td>
							<td>{i.Quantity}</td>
							<td>${Number(i['Unit Price']).toFixed(2)}</td>
							<td>${Number(i['Line Total']).toFixed(2)}</td>
						</tr>
					))}
				</tbody>
			</table>

			<p class="stat">${Number(quote['Final Quoted Price']).toFixed(2)}</p>
			<div class="field-display-grid">
				<div>
					<span class="field-display-label">Estimated labor hours</span>
					<span class="field-display-value">{Number(quote['Estimated Labor Hours']).toFixed(2)}</span>
				</div>
				<div>
					<span class="field-display-label">Expected revenue/labor hr</span>
					<span class="field-display-value">${Number(quote['Expected Revenue Per Labor Hour']).toFixed(2)}</span>
				</div>
				<div>
					<span class="field-display-label">Target hourly rate</span>
					<span class="field-display-value">${quote['Target Hourly Rate']}</span>
				</div>
				<div>
					<span class="field-display-label">Pricing Config</span>
					<span class="field-display-value">{quote['Pricing Config ID']} (v{quote['Calculator Version']})</span>
				</div>
			</div>
			{(Number(quote['Manual Adjustment']) !== 0 || Number(quote.Discount) !== 0) && (
				<div class="field-display-grid">
					<div>
						<span class="field-display-label">Manual adjustment</span>
						<span class="field-display-value">${Number(quote['Manual Adjustment']).toFixed(2)}</span>
					</div>
					<div>
						<span class="field-display-label">Discount</span>
						<span class="field-display-value">${Number(quote.Discount).toFixed(2)}</span>
					</div>
					<div>
						<span class="field-display-label">Adjustment reason</span>
						<span class="field-display-value">{quote['Override Reason'] || '— none given'}</span>
					</div>
				</div>
			)}
		</div>

		{(quote['Service Scope'] || quote['Inventory Coverage'] || quote['Labor Estimate Solo Hours']) && (
			<div class="card">
				<h2>Quote Details</h2>
				{quote['Service Scope'] && <p>Service scope: {quote['Service Scope']}</p>}
				{quote['Inventory Coverage'] && (
					<p>
						Inventory coverage: {quote['Inventory Coverage']}
						{quote['Walkthrough ID'] && <> (from <a href={`/walkthroughs/${quote['Walkthrough ID']}`}>walkthrough</a>)</>}
					</p>
				)}
				{quote['Labor Estimate Solo Hours'] && (
					<p>
						Labor estimate: {quote['Labor Estimate Solo Hours']} solo hrs × {quote['Labor Estimate Crew Size']} crew
						{' '}({(Number(quote['Labor Estimate Solo Hours']) * (quote['Labor Estimate Crew Size'] === '3+' ? 3 : Number(quote['Labor Estimate Crew Size']) || 1)).toFixed(2)} total hrs)
						{quote['Labor Estimate Confidence'] && <> · {quote['Labor Estimate Confidence']} confidence</>}
						{quote['Labor Estimate Notes'] && <><br />{quote['Labor Estimate Notes']}</>}
					</p>
				)}
				{[
					['High interior glass', quote['Job High Interior Glass (Y/N)']],
					['Steep or uneven terrain', quote['Job Steep Or Uneven Terrain (Y/N)']],
					['Obstructed exterior access', quote['Job Exterior Access Obstructed (Y/N)']],
					['Furniture/belongings movement required', quote['Job Furniture Movement Required (Y/N)']],
					['Water unavailable or difficult to access', quote['Job Water Access Difficult (Y/N)']],
					['Silicone/adhesive/sticker residue', quote['Job Silicone Or Sticker Residue (Y/N)']],
					['Heavy interior residue', quote['Job Heavy Interior Residue (Y/N)']],
				]
					.filter(([, v]) => v === 'Y')
					.map(([label]) => <span class="badge">{label}</span>)}
				{quote['Job Other Condition Notes'] && <p>{quote['Job Other Condition Notes']}</p>}
			</div>
		)}

		<div class="card-grid">
			<div class="card">
				<h2>QuickBooks Estimate</h2>
				{linkedEstimate ? (
					<>
						<p>
							Estimate #{linkedEstimate['Doc Number'] || linkedEstimate['QB Estimate ID']}{' '}
							<span class="badge badge-accent">{linkedEstimate.Status}</span>
						</p>
						<div class="field-display-grid">
							<div><span class="field-display-label">Estimate Total</span><span class="field-display-value">${Number(linkedEstimate.Total).toFixed(2)}</span></div>
							<div><span class="field-display-label">Last Synced</span><span class="field-display-value">{formatTimestamp(linkedEstimate['Updated At'])}</span></div>
						</div>
						{estimateMismatch && (
							<p role="alert">
								Historical amount: ${Number(quote['Final Quoted Price']).toFixed(2)} · QuickBooks estimate: ${Number(linkedEstimate.Total).toFixed(2)}
							</p>
						)}
						<p><a href={qboEstimateWebUrl(linkedEstimate['QB Estimate ID'])} target="_blank" rel="noopener noreferrer">View Estimate in QuickBooks ↗</a></p>
						<form method="POST" onsubmit="this.querySelector('button').disabled = true">
							<input type="hidden" name="_action" value="refresh-qb-estimate" />
							<input type="hidden" name="qbEstimateId" value={linkedEstimate['QB Estimate ID']} />
							<button type="submit">Refresh QuickBooks Data</button>
						</form>
					</>
				) : estimateObjectMissing ? (
					<p role="alert">The linked QuickBooks object could not be found.</p>
				) : suggestedEstimate ? (
					<div class="card">
						<p>
							<strong>Potential QuickBooks Match Found</strong><br />
							Estimate #{suggestedEstimate['Doc Number'] || suggestedEstimate['QB Estimate ID']} · $
							{Number(suggestedEstimate.Total).toFixed(2)} · {suggestedEstimate['Txn Date']}
						</p>
						<div class="button-row">
							<form method="POST">
								<input type="hidden" name="_action" value="link-qb-estimate" />
								<input type="hidden" name="qbEstimateId" value={suggestedEstimate['QB Estimate ID']} />
								<button type="submit">Link</button>
							</form>
							<form method="POST">
								<input type="hidden" name="_action" value="dismiss-qb-estimate-suggestion" />
								<input type="hidden" name="qbEstimateId" value={suggestedEstimate['QB Estimate ID']} />
								<button type="submit" class="btn-secondary">Dismiss</button>
							</form>
						</div>
					</div>
				) : (
					<p>No QuickBooks Estimate Linked</p>
				)}
				{!linkedEstimate && (
					<details class="card" open={estimateQuery !== null}>
						<summary>Link Existing Estimate</summary>
						<form method="GET" class="inline-field-form">
							<label>Search <input type="text" name="estimateQuery" value={estimateQuery ?? ''} placeholder="Customer, number, date, total..." /></label>
							{client?.['QB Customer ID'] && (
								<label>
									<input type="checkbox" name="estimateScope" value="all" checked={estimateScope === 'all'} /> Search All QuickBooks Records
								</label>
							)}
							<button type="submit">Search</button>
						</form>
						{estimateQuery !== null && (
							<table>
								<thead><tr><th>Customer</th><th>Number</th><th>Total</th><th>Date</th><th>Status</th><th></th></tr></thead>
								<tbody>
									{estimateCandidates.map(({ estimate, customer }) => (
										<tr>
											<td>{customer?.['Display Name'] || estimate['QB Customer ID']}</td>
											<td>{estimate['Doc Number'] || estimate['QB Estimate ID']}</td>
											<td>${Number(estimate.Total).toFixed(2)}</td>
											<td>{estimate['Txn Date']}</td>
											<td>{estimate.Status}</td>
											<td>
												<form method="POST">
													<input type="hidden" name="_action" value="link-qb-estimate" />
													<input type="hidden" name="qbEstimateId" value={estimate['QB Estimate ID']} />
													{quote['QB Estimate ID'] && quote['QB Estimate ID'] !== estimate['QB Estimate ID'] && (
														<label><input type="checkbox" name="confirmRelink" /> Confirm re-link</label>
													)}
													<button type="submit">Link</button>
												</form>
											</td>
										</tr>
									))}
									{estimateCandidates.length === 0 && <tr><td colspan="6">No matching Estimates found.</td></tr>}
								</tbody>
							</table>
						)}
					</details>
				)}
			</div>

			{canAccept && (
				<div class="card">
					<h2>Accept quote</h2>
					<form method="POST" class="inline-field-form">
						<input type="hidden" name="_action" value="accept" />
						<label>Scheduled date (optional) <input type="date" name="scheduledDate" /></label>
						<button type="submit">Accept quote</button>
					</form>
				</div>
			)}
		</div>

		{job && (
			<div class="card">
				<h2>Job — <span class="badge">{job['Job Status']}</span></h2>
				<p><a href={`/jobs/${job['Job ID']}`}>Open Job Day →</a></p>
				<form method="POST">
					<input type="hidden" name="_action" value="update-job-status" />
					<input type="hidden" name="jobId" value={job['Job ID']} />
					<label>
						New status
						<select name="status">
							{JOB_STATUSES.map((s) => <option value={s} selected={s === job['Job Status']}>{s}</option>)}
						</select>
					</label>
					<div class="pane-grid">
						<label>Scheduled date <input type="date" name="scheduledDate" value={job['Scheduled Date']} /></label>
						<label>Actual time (hrs) <input type="text" name="actualTime" value={job['Actual Time (hrs)']} /></label>
					</div>
					<label>Final price ($) <input type="text" name="finalPrice" value={job['Final Price ($)']} /></label>
					<div class="pane-grid">
						<label>Review requested at <input type="date" name="reviewRequestedAt" value={job['Review Requested At']} /></label>
						<label>
							Review left
							<select name="reviewLeft">
								<option value="" selected={!job['Review Left']} />
								{REVIEW_LEFT_VALUES.map((v) => <option value={v} selected={v === job['Review Left']}>{v}</option>)}
							</select>
						</label>
					</div>
					<label>Next maintenance follow-up date <input type="date" name="nextMaintenanceFollowUpDate" value={job['Next Maintenance Follow-up Date']} /></label>
					<label>
						Maintenance follow-up status
						<select name="maintenanceFollowUpStatus">
							<option value="" selected={!job['Maintenance Follow-up Status']} />
							{MAINTENANCE_FOLLOW_UP_STATUSES.map((v) => <option value={v} selected={v === job['Maintenance Follow-up Status']}>{v}</option>)}
						</select>
					</label>
					<button type="submit">Update job</button>
				</form>
			</div>
		)}

		{job && (
			<div class="card">
				<h2>QuickBooks Invoice</h2>
				{linkedInvoice ? (
					<>
						<p>
							Invoice #{linkedInvoice['Doc Number'] || linkedInvoice['QB Invoice ID']}{' '}
							<span class="badge badge-accent">{linkedInvoice.Status}</span>
						</p>
						<div class="field-display-grid">
							<div><span class="field-display-label">Invoice Total</span><span class="field-display-value">${Number(linkedInvoice.Total).toFixed(2)}</span></div>
							<div><span class="field-display-label">Amount Paid</span><span class="field-display-value">${invoiceAmountPaid.toFixed(2)}</span></div>
							<div><span class="field-display-label">Balance Due</span><span class="field-display-value">${Number(linkedInvoice.Balance).toFixed(2)}</span></div>
							{invoicePaymentDate && <div><span class="field-display-label">Payment Date</span><span class="field-display-value">{invoicePaymentDate}</span></div>}
							<div><span class="field-display-label">Last Synced</span><span class="field-display-value">{formatTimestamp(linkedInvoice['Updated At'])}</span></div>
						</div>
						{invoiceMismatch && (
							<p role="alert">
								Historical amount: ${Number(job['Final Price ($)']).toFixed(2)} · QuickBooks invoice: ${Number(linkedInvoice.Total).toFixed(2)}
							</p>
						)}
						<p><a href={qboInvoiceWebUrl(linkedInvoice['QB Invoice ID'])} target="_blank" rel="noopener noreferrer">View Invoice in QuickBooks ↗</a></p>
						<form method="POST" onsubmit="this.querySelector('button').disabled = true">
							<input type="hidden" name="_action" value="refresh-qb-invoice" />
							<input type="hidden" name="qbInvoiceId" value={linkedInvoice['QB Invoice ID']} />
							<button type="submit">Refresh QuickBooks Data</button>
						</form>
					</>
				) : invoiceObjectMissing ? (
					<p role="alert">The linked QuickBooks object could not be found.</p>
				) : suggestedInvoice ? (
					<div class="card">
						<p>
							<strong>Potential QuickBooks Match Found</strong><br />
							Invoice #{suggestedInvoice['Doc Number'] || suggestedInvoice['QB Invoice ID']} · $
							{Number(suggestedInvoice.Total).toFixed(2)} · {suggestedInvoice['Txn Date']}
						</p>
						<div class="button-row">
							<form method="POST">
								<input type="hidden" name="_action" value="link-qb-invoice" />
								<input type="hidden" name="jobId" value={job['Job ID']} />
								<input type="hidden" name="qbInvoiceId" value={suggestedInvoice['QB Invoice ID']} />
								<button type="submit">Link</button>
							</form>
							<form method="POST">
								<input type="hidden" name="_action" value="dismiss-qb-invoice-suggestion" />
								<input type="hidden" name="jobId" value={job['Job ID']} />
								<input type="hidden" name="qbInvoiceId" value={suggestedInvoice['QB Invoice ID']} />
								<button type="submit" class="btn-secondary">Dismiss</button>
							</form>
						</div>
					</div>
				) : (
					<p>No QuickBooks Invoice Linked</p>
				)}
				{!linkedInvoice && (
					<details class="card" open={invoiceQuery !== null}>
						<summary>Link Existing Invoice</summary>
						<form method="GET" class="inline-field-form">
							<label>Search <input type="text" name="invoiceQuery" value={invoiceQuery ?? ''} placeholder="Customer, number, date, total..." /></label>
							{client?.['QB Customer ID'] && (
								<label>
									<input type="checkbox" name="invoiceScope" value="all" checked={invoiceScope === 'all'} /> Search All QuickBooks Records
								</label>
							)}
							<button type="submit">Search</button>
						</form>
						{invoiceQuery !== null && (
							<table>
								<thead><tr><th>Customer</th><th>Number</th><th>Total</th><th>Date</th><th>Status</th><th></th></tr></thead>
								<tbody>
									{invoiceCandidates.map(({ invoice, customer }) => (
										<tr>
											<td>{customer?.['Display Name'] || invoice['QB Customer ID']}</td>
											<td>{invoice['Doc Number'] || invoice['QB Invoice ID']}</td>
											<td>${Number(invoice.Total).toFixed(2)}</td>
											<td>{invoice['Txn Date']}</td>
											<td>{invoice.Status}</td>
											<td>
												<form method="POST">
													<input type="hidden" name="_action" value="link-qb-invoice" />
													<input type="hidden" name="jobId" value={job['Job ID']} />
													<input type="hidden" name="qbInvoiceId" value={invoice['QB Invoice ID']} />
													{job['QB Invoice ID'] && job['QB Invoice ID'] !== invoice['QB Invoice ID'] && (
														<label><input type="checkbox" name="confirmRelink" /> Confirm re-link</label>
													)}
													<button type="submit">Link</button>
												</form>
											</td>
										</tr>
									))}
									{invoiceCandidates.length === 0 && <tr><td colspan="6">No matching Invoices found.</td></tr>}
								</tbody>
							</table>
						)}
					</details>
				)}
			</div>
		)}
	</main>
</BaseLayout>
