---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { listActiveRows, listArchivedRows, updateRow } from '../../lib/sheets';
import { quoteConfig, QUOTE_STATUSES } from '../../lib/models/quote';
import { clientConfig } from '../../lib/models/client';
import { propertyConfig } from '../../lib/models/property';
import { deleteQuote, restoreQuote } from '../../lib/pricing/quotes';
import { formatTimestamp } from '../../lib/format';

let error: string | null = null;

// Still used by the single-row status dropdown below — Sent/Declined/Expired
// each stamp their own timestamp column when picked.
const TIMESTAMP_FIELD_BY_STATUS: Partial<Record<(typeof QUOTE_STATUSES)[number], string>> = {
	Sent: 'Sent At',
	Declined: 'Declined At',
	Expired: 'Expired At',
};

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = String(form.get('_action') ?? '');
	try {
		if (action === 'update-quote-status') {
			// Same restriction as quotes/[id].astro's own dropdown — "Accepted"
			// stays exclusive to the dedicated Accept-quote flow, which also
			// creates the linked Job.
			const quoteId = String(form.get('quoteId') ?? '');
			const status = String(form.get('status') ?? '') as (typeof QUOTE_STATUSES)[number];
			if (status === 'Accepted') {
				throw new Error('Use the quote\'s own "Accept quote" action to mark it Accepted — it also creates the linked Job.');
			}
			const patch: Record<string, string> = { 'Quote Status': status };
			const timestampField = TIMESTAMP_FIELD_BY_STATUS[status];
			if (timestampField) patch[timestampField] = new Date().toISOString();
			await updateRow(env, quoteConfig, quoteId, patch);
		} else if (action === 'delete-quote') {
			await deleteQuote(env, String(form.get('quoteId') ?? ''));
		} else if (action === 'restore-quote') {
			await restoreQuote(env, String(form.get('quoteId') ?? ''));
		}
	} catch (e) {
		error = (e as Error).message;
	}
}

const showArchived = Astro.url.searchParams.get('archived') === '1';

const [quotes, clients, properties] = await Promise.all([
	showArchived ? listArchivedRows(env, quoteConfig) : listActiveRows(env, quoteConfig),
	listActiveRows(env, clientConfig),
	listActiveRows(env, propertyConfig),
]);
const clientById = Object.fromEntries(clients.map((c) => [c['Client ID'], c]));
const propertyById = Object.fromEntries(properties.map((p) => [p['Property ID'], p]));

quotes.sort((a, b) => (showArchived ? (b['Archived At'] || '').localeCompare(a['Archived At'] || '') : (b['Created At'] || '').localeCompare(a['Created At'] || '')));

// One color per status so the dropdown itself reads at a glance without a
// separate badge — reuses the app's existing semantic colors (brand navy/
// red, plus the success green and warning amber already established for
// field-status/follow-up coloring elsewhere) rather than inventing a new
// palette.
const STATUS_COLORS: Record<(typeof QUOTE_STATUSES)[number], { bg: string; color: string }> = {
	Draft: { bg: '#d8c6ac', color: '#012441' },
	Sent: { bg: '#012441', color: '#fff8ea' },
	Accepted: { bg: '#1a7a4c', color: '#fff8ea' },
	Declined: { bg: '#9d1518', color: '#fff8ea' },
	Expired: { bg: '#92400e', color: '#fff8ea' },
};
---

<BaseLayout title="Quotes">
	<main>
		<h1>Quotes</h1>
		<p>
			Every quote created — from the in-field <a href="/quoter">Quoter</a> or a walkthrough.
			{' · '}
			{showArchived ? <a href="/quotes">← Back to active quotes</a> : <a href="/quotes?archived=1">View deleted/archived quotes →</a>}
		</p>
		{error && <p role="alert">{error}</p>}

		<table>
			<thead>
				<tr>
					<th>Property</th>
					<th>Client</th>
					<th>{showArchived ? 'Status (when deleted)' : 'Status'}</th>
					<th>Final Quoted Price</th>
					{showArchived && <th>Deleted</th>}
					<th></th>
				</tr>
			</thead>
			<tbody>
				{quotes.map((q) => {
					const client = clientById[q['Client ID']];
					const property = propertyById[q['Property ID']];
					return (
						<tr>
							<td>
								{property
									? `${property['Street Address']}, ${property.City}${property['Unit Identifier'] ? ` — Unit ${property['Unit Identifier']}` : ''}`
									: q['Property ID']}
							</td>
							<td>{client ? `${client['First Name']} ${client['Last Name']}` : q['Client ID']}</td>
							<td>
								{showArchived ? (
									<span
										class="badge"
										style={`background-color:${STATUS_COLORS[q['Quote Status']]?.bg ?? '#d8c6ac'}; color:${STATUS_COLORS[q['Quote Status']]?.color ?? '#012441'};`}
									>
										{q['Quote Status']}
									</span>
								) : (
									<form method="POST" class="quote-status-form" style="margin:0;">
										<input type="hidden" name="_action" value="update-quote-status" />
										<input type="hidden" name="quoteId" value={q['Quote ID']} />
										<select
											name="status"
											onchange="this.form.submit()"
											style={`display:inline-block; width:8rem; max-width:8rem; margin-top:0; font-size:0.85rem; padding:0.35rem 0.5rem; font-weight:600; text-align:center; text-align-last:center; background-color:${STATUS_COLORS[q['Quote Status']]?.bg ?? '#d8c6ac'}; color:${STATUS_COLORS[q['Quote Status']]?.color ?? '#012441'}; border-color:${STATUS_COLORS[q['Quote Status']]?.bg ?? '#d8c6ac'};`}
										>
											{QUOTE_STATUSES.map((s) => (
												<option value={s} disabled={s === 'Accepted'} selected={s === q['Quote Status']}>{s}</option>
											))}
										</select>
									</form>
								)}
							</td>
							<td>{q['Final Quoted Price'] ? `$${Number(q['Final Quoted Price']).toFixed(2)}` : '—'}</td>
							{showArchived && <td>{formatTimestamp(q['Archived At'])}</td>}
							<td>
								<a href={`/quotes/${q['Quote ID']}`}>view</a>
								{showArchived ? (
									<>
										{' · '}
										<form
											method="POST"
											style="display:inline"
											onsubmit="return confirm('Restore this quote? It will reappear everywhere in the app.')"
										>
											<input type="hidden" name="_action" value="restore-quote" />
											<input type="hidden" name="quoteId" value={q['Quote ID']} />
											<button type="submit" class="link-button">restore</button>
										</form>
									</>
								) : (
									<>
										{' · '}
										<a href={`/quoter?duplicateFrom=${q['Quote ID']}`}>duplicate</a>
										{q['Quote Status'] !== 'Accepted' && (
											<>
												{' · '}
												<a href={`/quoter?quoteId=${q['Quote ID']}`}>edit</a>
												{' · '}
												<form
													method="POST"
													style="display:inline"
													onsubmit="return confirm('Delete this quote? It will be archived and removed from view everywhere in the app.')"
												>
													<input type="hidden" name="_action" value="delete-quote" />
													<input type="hidden" name="quoteId" value={q['Quote ID']} />
													<button type="submit" class="link-button">delete</button>
												</form>
											</>
										)}
									</>
								)}
							</td>
						</tr>
					);
				})}
				{quotes.length === 0 && <tr><td colspan={showArchived ? 6 : 5}>{showArchived ? 'No deleted quotes.' : 'No quotes yet.'}</td></tr>}
			</tbody>
		</table>
	</main>
</BaseLayout>
