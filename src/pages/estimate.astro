---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Get a ballpark estimate" nav={false}>
	<main>
		<section class="hero">
			<h1>Get a ballpark window cleaning estimate</h1>
			<p>Tell us a bit about your property and we'll give you a price range. Final pricing is confirmed after we take a look at the property in person.</p>
		</section>

		<div class="card estimate-card">
			<form id="estimate-form">
				<label>First name <input type="text" name="firstName" required /></label>
				<label>Last name <input type="text" name="lastName" required /></label>
				<label>Email <input type="email" name="email" /></label>
				<label>Phone <input type="tel" name="phone" inputmode="numeric" placeholder="303-931-3903" /></label>
				<label>Property address <input type="text" name="streetAddress" required /></label>
				<div class="field-trio">
					<label>City <input type="text" name="city" /></label>
					<label>State <input type="text" name="state" maxlength="2" placeholder="CO" /></label>
					<label>Zip <input type="text" name="zip" /></label>
				</div>
				<div class="field-trio-even">
					<label>
						Stories
						<select name="stories">
							<option value="1">1</option>
							<option value="2">2</option>
							<option value="3">3</option>
						</select>
					</label>
					<label>Approx. windows <input type="number" name="approxWindowCount" min="1" required /></label>
					<label>
						Property type
						<select name="propertyType">
							<option value="residential">Residential</option>
							<option value="commercial">Commercial</option>
						</select>
					</label>
				</div>
				<label>How did you hear about us? <input type="text" name="referralSource" /></label>
				<button type="submit">Get my estimate</button>
			</form>

			<div id="estimate-result" role="status"></div>
		</div>
	</main>

	<style>
		.hero {
			text-align: center;
			padding: 2.5rem 0 0.5rem;
		}
		.hero p {
			max-width: 38rem;
			margin: 0 auto;
			color: var(--color-ink-muted);
		}
		.estimate-card {
			max-width: 38rem;
			margin: 0 auto;
		}
		#estimate-result:not(:empty) {
			margin-top: 1rem;
			padding-top: 1rem;
			border-top: 2px solid var(--color-tan);
		}
		.field-trio,
		.field-trio-even {
			grid-column: 1 / -1;
			display: grid;
			gap: 0 1.5rem;
		}
		.field-trio {
			grid-template-columns: 2fr 1fr 1fr;
		}
		.field-trio-even {
			grid-template-columns: repeat(3, 1fr);
		}
		@media (max-width: 500px) {
			.field-trio,
			.field-trio-even {
				grid-template-columns: 1fr;
			}
		}
	</style>

	<script>
		import { formatPhoneDigits } from '../lib/phoneFormat';

		const form = document.getElementById('estimate-form') as HTMLFormElement;
		const result = document.getElementById('estimate-result')!;
		const phone = form.querySelector('input[name="phone"]') as HTMLInputElement;
		phone.addEventListener('input', () => {
			phone.value = formatPhoneDigits(phone.value);
		});

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			result.textContent = 'Calculating…';

			const res = await fetch('/api/estimate', { method: 'POST', body: new FormData(form) });
			const body = await res.json();

			if (!res.ok) {
				result.textContent = body.error ?? 'Something went wrong. Please try again.';
				return;
			}

			result.innerHTML = `<h2>Estimated range: $${body.low.toLocaleString()}–$${body.high.toLocaleString()}</h2><p>${body.message}</p>`;
			form.reset();
		});
	</script>
</BaseLayout>
