---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { listActiveRows, listArchivedRows } from '../../lib/sheets';
import { leadConfig, LEAD_STAGES } from '../../lib/models/lead';
import { deleteLead, restoreLead, duplicateLead } from '../../lib/leads';
import { formatTimestamp } from '../../lib/format';

let error: string | null = null;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = String(form.get('_action') ?? '');
	const leadId = String(form.get('leadId') ?? '');
	try {
		if (action === 'delete-lead') {
			await deleteLead(env, leadId);
		} else if (action === 'restore-lead') {
			await restoreLead(env, leadId);
		} else if (action === 'duplicate-lead') {
			const duplicate = await duplicateLead(env, leadId);
			return Astro.redirect(`/leads/${duplicate['Lead ID']}`);
		}
	} catch (e) {
		error = (e as Error).message;
	}
}

const showArchived = Astro.url.searchParams.get('archived') === '1';
const stageFilter = Astro.url.searchParams.get('stage') ?? '';

let leads = showArchived ? await listArchivedRows(env, leadConfig) : await listActiveRows(env, leadConfig);
if (!showArchived && stageFilter) {
	leads = leads.filter((l) => l.Stage === stageFilter);
}
leads.sort((a, b) =>
	showArchived
		? (b['Closed At'] || b['Archived At'] || '').localeCompare(a['Closed At'] || a['Archived At'] || '')
		: (a['Next Follow-up Date'] || '9999-99-99').localeCompare(b['Next Follow-up Date'] || '9999-99-99')
);

---

<BaseLayout title="Leads">
	<main>
		<div class="card-header-row">
			<h1>Leads</h1>
			<a class="btn" href="/leads/new">+ New lead</a>
		</div>
		<p>
			Cold opportunities that haven't been walked yet — no Client or Property required. Once a lead's quote is accepted, convert it to a Client from its detail page.
			{' · '}
			{showArchived ? <a href="/leads">← Back to active leads</a> : <a href="/leads?archived=1">View won/lost/deleted leads →</a>}
		</p>
		{error && <p role="alert">{error}</p>}

		{!showArchived && (
			<div class="button-row" role="tablist" aria-label="Filter by stage">
				<a href="/leads" class={stageFilter ? 'badge' : 'badge badge-accent'} style="text-decoration: none;">All</a>
				{LEAD_STAGES.filter((s) => s !== 'Won' && s !== 'Lost').map((s) => (
					<a href={`/leads?stage=${encodeURIComponent(s)}`} class={stageFilter === s ? 'badge badge-accent' : 'badge'} style="text-decoration: none;">{s}</a>
				))}
			</div>
		)}

		<table>
			<thead>
				<tr>
					<th>Name</th>
					<th>Stage</th>
					<th>Next follow-up</th>
					<th>Source</th>
					{showArchived && <th>Outcome</th>}
					<th></th>
				</tr>
			</thead>
			<tbody>
				{leads.map((l) => (
					<tr>
						<td><a href={`/leads/${l['Lead ID']}`}>{l['First Name']} {l['Last Name']}</a></td>
						<td><span class="badge">{l.Stage}</span></td>
						<td>{l['Next Follow-up Date'] || '—'}</td>
						<td>{l.Source || '—'}</td>
						{showArchived && <td>{l.Outcome || '—'} {l['Closed At'] && <>({formatTimestamp(l['Closed At'])})</>}</td>}
						<td>
							{showArchived ? (
								<form method="POST" style="display:inline" onsubmit="return confirm('Restore this lead? It will reappear in the active Leads list.')">
									<input type="hidden" name="_action" value="restore-lead" />
									<input type="hidden" name="leadId" value={l['Lead ID']} />
									<button type="submit" class="link-button">restore</button>
								</form>
							) : (
								<>
									<form method="POST" style="display:inline">
										<input type="hidden" name="_action" value="duplicate-lead" />
										<input type="hidden" name="leadId" value={l['Lead ID']} />
										<button type="submit" class="link-button">duplicate</button>
									</form>
									{' · '}
									<form method="POST" style="display:inline" onsubmit="return confirm('Delete this lead? It will be archived and removed from the active list.')">
										<input type="hidden" name="_action" value="delete-lead" />
										<input type="hidden" name="leadId" value={l['Lead ID']} />
										<button type="submit" class="link-button">delete</button>
									</form>
								</>
							)}
						</td>
					</tr>
				))}
				{leads.length === 0 && <tr><td colspan={showArchived ? 6 : 5}>{showArchived ? 'No won, lost, or deleted leads.' : 'No leads yet.'}</td></tr>}
			</tbody>
		</table>

	</main>
</BaseLayout>
