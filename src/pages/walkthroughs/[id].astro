---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { createRow, findById, listActiveRows, updateRow } from '../../lib/sheets';
import { walkthroughConfig } from '../../lib/models/walkthrough';
import { walkthroughItemConfig } from '../../lib/models/walkthroughItem';
import { walkthroughAdjustmentConfig } from '../../lib/models/walkthroughAdjustment';
import { propertyConfig } from '../../lib/models/property';
import { clientConfig } from '../../lib/models/client';
import { createQuoteFromWalkthrough, isGroupedInventoryWalkthrough } from '../../lib/pricing/walkthroughToQuote';
import {
	hasLegacyInventoryDetails,
	migrateGroupsToInventory,
	migrationColumns,
	migrationItemRows,
	readLegacyInventoryDetails,
} from '../../lib/labor/legacyInventory';
import { loadActiveLaborModel } from '../../lib/labor/config';
import {
	SPECIAL_ITEM_LABELS,
	SPECIAL_ITEM_STORY_LABELS,
	STANDARD_FLOORS,
	STANDARD_FLOOR_LABELS,
	specialItemUnitLabel,
	type SpecialItemStory,
	type SpecialItemType,
	type StandardFloor,
} from '../../lib/labor/types';
import type { Walkthrough } from '../../lib/models/walkthrough';

const STANDARD_FLOOR_COLUMNS: Record<StandardFloor, keyof Walkthrough> = {
	first: 'Standard Windows First',
	second: 'Standard Windows Second',
	third: 'Standard Windows Third',
	fourthPlus: 'Standard Windows Fourth Plus',
};

const { id } = Astro.params;
let error: string | null = null;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	try {
		if (form.get('_action') === 'migrate-inventory') {
			// Explicit, never automatic. It leaves the original group rows and
			// the recorded hours and price untouched — it adds a v3 reading
			// alongside them — but it does change how the record reads, so
			// it's the owner's decision to make.
			const existing = await findById(env, walkthroughConfig, id!);
			const rows = (await listActiveRows(env, walkthroughItemConfig)).filter(
				(i) => i['Walkthrough ID'] === id && i['Production Class']
			);
			const model = existing?.['Property ID']
				? await loadActiveLaborModel(env, (await findById(env, propertyConfig, existing['Property ID']))?.['Property Type'] ?? '')
				: null;
			const paneFactors = model
				? Object.fromEntries(Object.entries(model.profiles).map(([k, p]) => [k, p.defaultPaneFactor]))
				: {};
			const migration = migrateGroupsToInventory(
				rows,
				{
					glassPanes: existing?.['Total Glass Panes'] ?? '',
					screens: existing?.['Total Screens'] ?? '',
					tracks: existing?.['Total Tracks'] ?? '',
				},
				paneFactors
			);
			await updateRow(env, walkthroughConfig, id!, migrationColumns(migration, existing?.['Total Window Units'] ?? ''), {
				action: 'migrate-inventory',
			});
			// Added alongside the original group rows, never instead of them.
			for (const row of migrationItemRows(migration, id!)) {
				await createRow(env, walkthroughItemConfig, row, { action: 'migrate-inventory' });
			}
			return Astro.redirect(`/walkthroughs/${id}`);
		}
		const result = await createQuoteFromWalkthrough(env, id!);
		return Astro.redirect(`/quotes/${result.quote['Quote ID']}`);
	} catch (e) {
		error = (e as Error).message;
	}
}

const walkthrough = await findById(env, walkthroughConfig, id!);
if (!walkthrough) {
	return new Response('Walkthrough not found', { status: 404 });
}

const property = walkthrough['Property ID'] ? await findById(env, propertyConfig, walkthrough['Property ID']) : null;
const client = walkthrough['Client ID'] ? await findById(env, clientConfig, walkthrough['Client ID']) : null;
const allItems = await listActiveRows(env, walkthroughItemConfig);
const items = allItems.filter((i) => i['Walkthrough ID'] === id);

// A labor-model walkthrough explains itself from its stored breakdown.
// Anything older shows the summary it actually recorded and is labelled as
// such — never back-filled with numbers it never had.
const grouped = isGroupedInventoryWalkthrough(walkthrough);
const simplified = walkthrough['Inventory Model'] === 'inventory-v3';
const groups = grouped && !simplified ? items.filter((i) => i['Production Class']) : [];
const specialItems = simplified ? items.filter((i) => i['Special Item Type']) : [];

// Shown only for a walkthrough that was MIGRATED from the grouped shape —
// never for one recorded the simplified way, which has nothing to disclose.
const legacyInventory = hasLegacyInventoryDetails(walkthrough) ? readLegacyInventoryDetails(walkthrough) : null;

const adjustments = grouped
	? (await listActiveRows(env, walkthroughAdjustmentConfig)).filter((a) => a['Walkthrough ID'] === id)
	: [];

interface StoredBreakdown {
	breakdown?: Record<string, number>;
	explanation?: string;
	scheduleReasons?: string[];
}

let stored: StoredBreakdown = {};
if (grouped) {
	try {
		stored = JSON.parse(walkthrough['Labor Breakdown (JSON)'] || '{}') as StoredBreakdown;
	} catch {
		// A breakdown that won't parse costs the itemisation, not the page.
		stored = {};
	}
}

const BREAKDOWN_LABELS: Record<string, string> = {
	fixedOverhead: 'Fixed job overhead',
	interiorGlass: 'Interior glass',
	exteriorGlass: 'Exterior glass',
	exteriorFrames: 'Exterior frames and sills',
	screens: 'Screens',
	tracks: 'Tracks',
	interiorAccess: 'Interior access',
	exteriorAccess: 'Exterior access',
	storyLogistics: 'Story logistics',
	condition: 'Component condition',
	restoration: 'Restoration',
	propertyModifiers: 'Property modifiers',
};

function hours(minutes: string | number): string {
	return (Number(minutes || 0) / 60).toFixed(1);
}

const COMPONENT_CONDITION_ROWS = [
	{ label: 'Interior glass', value: walkthrough['Interior Glass Condition'] },
	{ label: 'Exterior glass', value: walkthrough['Exterior Glass Condition'] },
	{ label: 'Frames and sills', value: walkthrough['Exterior Frame Condition'] },
	{ label: 'Screens', value: walkthrough['Screen Condition'] },
	{ label: 'Tracks', value: walkthrough['Track Condition'] },
];
---

<BaseLayout title="Walkthrough">
	<main>
		{property && <p><a href={`/properties/${property['Property ID']}`}>← Property</a></p>}
		<h1>
			Walkthrough — {property
				? `${property['Street Address']}, ${property.City}${property['Unit Identifier'] ? ` — Unit ${property['Unit Identifier']}` : ''}`
				: walkthrough['Property ID']}
		</h1>
		<p>
			<span class="badge badge-accent">{walkthrough.Status}</span>
			{!grouped && <> <span class="badge">Legacy aggregate estimate</span></>}
			{client && <> — {client['First Name']} {client['Last Name']}</>}
			{' '}— {walkthrough['Walkthrough Date']}
		</p>
		{!grouped && (
			<p class="field-hint">
				Recorded before window groups existed, so it holds totals rather than a per-group breakdown. Its numbers are
				preserved exactly as entered — nothing has been back-filled.
			</p>
		)}
		{error && <p role="alert">{error}</p>}

		<div class="card-grid">
			<section class="card">
				<h2>Summary</h2>
				<div class="field-display-grid">
					<div><span class="field-display-label">Stories observed</span><span class="field-display-value">{walkthrough['Story Count Observed'] || '—'}</span></div>
					<div><span class="field-display-label">Window units</span><span class="field-display-value">{walkthrough['Total Window Units'] || '—'}</span></div>
					<div><span class="field-display-label">Glass panes</span><span class="field-display-value">{walkthrough['Total Glass Panes'] || '—'}</span></div>
					<div>
						<span class="field-display-label">Screens</span>
						<span class="field-display-value">
							{walkthrough['Total Screens'] || '—'}{walkthrough['Manual Screen Total'] ? ' (manual)' : ''}
						</span>
					</div>
					<div>
						<span class="field-display-label">Tracks</span>
						<span class="field-display-value">
							{walkthrough['Total Tracks'] || '—'}{walkthrough['Manual Track Total'] ? ' (manual)' : ''}
						</span>
					</div>
					{grouped ? (
						COMPONENT_CONDITION_ROWS.filter((row) => row.value).map((row) => (
							<div><span class="field-display-label">{row.label} condition</span><span class="field-display-value">{row.value}</span></div>
						))
					) : (
						<>
							<div><span class="field-display-label">Exterior condition</span><span class="field-display-value">{walkthrough['Exterior Condition']}</span></div>
							<div><span class="field-display-label">Interior condition</span><span class="field-display-value">{walkthrough['Interior Condition']}</span></div>
							<div><span class="field-display-label">Access difficulty</span><span class="field-display-value">{walkthrough['Access Difficulty']}</span></div>
						</>
					)}
					<div><span class="field-display-label">Water-fed pole suitable</span><span class="field-display-value">{walkthrough['Water-Fed Pole Suitable (Y/N)']}</span></div>
					{walkthrough['Ladder Required'] && <div><span class="field-display-label">Ladder requirement</span><span class="field-display-value">{walkthrough['Ladder Required']}</span></div>}
					<div><span class="field-display-label">Exterior access obstructed</span><span class="field-display-value">{walkthrough['Exterior Access Obstructed (Y/N)']}</span></div>
					<div><span class="field-display-label">Furniture/belongings movement required</span><span class="field-display-value">{walkthrough['Furniture Or Belongings Movement Required (Y/N)']}</span></div>
				</div>
				{walkthrough['Condition Notes'] && <p>Condition notes: {walkthrough['Condition Notes']}</p>}
				{walkthrough['Restoration Notes'] && <p>Restoration notes: {walkthrough['Restoration Notes']}</p>}
				{walkthrough['Temporary Access Notes'] && <p>Temporary access notes: {walkthrough['Temporary Access Notes']}</p>}
				{walkthrough.Notes && <p>{walkthrough.Notes}</p>}
			</section>

			<section class="card">
				<h2>Labor &amp; price</h2>
				{grouped ? (
					<>
						<div class="stats-grid">
							<div>
								<strong>{hours(walkthrough['Productive Labor Minutes'])} h</strong>
								<span class="field-hint">productive labor</span>
							</div>
							<div>
								<strong>{hours(walkthrough['Scheduled Minutes'])} h</strong>
								<span class="field-hint">scheduled time</span>
							</div>
							<div>
								<strong>{walkthrough['Schedule Recommendation'] || '—'}</strong>
								<span class="field-hint">recommendation</span>
							</div>
						</div>
						{stored.explanation && <p>{stored.explanation}</p>}
						{stored.breakdown && (
							<details>
								<summary>Labor breakdown</summary>
								<table>
									<tbody>
										{Object.entries(stored.breakdown)
											.filter(([, minutes]) => minutes > 0)
											.map(([key, minutes]) => (
												<tr>
													<td>{BREAKDOWN_LABELS[key] ?? key}</td>
													<td>{hours(minutes)} h</td>
												</tr>
											))}
									</tbody>
								</table>
							</details>
						)}
						{stored.scheduleReasons && stored.scheduleReasons.length > 0 && (
							<ul>{stored.scheduleReasons.map((reason) => <li class="field-hint">{reason}</li>)}</ul>
						)}
					</>
				) : (
					<p>Estimated on-site labor: {walkthrough['Estimated On-Site Labor Hours']} hours</p>
				)}
				<p>
					Suggested low: ${walkthrough['Suggested Low Price']} — Suggested target:{' '}
					<strong>${walkthrough['Suggested Target Price']}</strong> — Suggested high: ${walkthrough['Suggested High Price']}
				</p>
				{walkthrough['Owner Override Price'] && <p>Owner-selected price: <strong>${walkthrough['Owner Override Price']}</strong></p>}
				<p class="field-hint">
					{grouped && walkthrough['Labor Model Version']
						? `Labor model: ${walkthrough['Labor Model Version']}`
						: 'Legacy count-based estimate'}
				</p>
			</section>
		</div>

		{simplified ? (
			<section class="card">
				<h2>Window inventory</h2>
				<div class="stats-grid">
					{STANDARD_FLOORS.filter((f) => Number(walkthrough[STANDARD_FLOOR_COLUMNS[f]]) > 0).map((f) => (
						<div>
							<strong>{walkthrough[STANDARD_FLOOR_COLUMNS[f]]}</strong>
							<span class="field-hint">{STANDARD_FLOOR_LABELS[f]}</span>
						</div>
					))}
					<div>
						<strong>{walkthrough['Total Glass Panes'] || '0'}</strong>
						<span class="field-hint">glass panes</span>
					</div>
					<div>
						<strong>{walkthrough['Total Screens'] || '0'}</strong>
						<span class="field-hint">screens</span>
					</div>
					<div>
						<strong>{walkthrough['Total Tracks'] || '0'}</strong>
						<span class="field-hint">tracks</span>
					</div>
					{Number(walkthrough['Total Solar Panels']) > 0 && (
						<div>
							<strong>{walkthrough['Total Solar Panels']}</strong>
							<span class="field-hint">solar panels</span>
						</div>
					)}
				</div>

				{specialItems.length > 0 && (
					<>
						<h3>Special windows &amp; doors</h3>
						<table>
							<thead>
								<tr><th>Type</th><th>Qty</th><th>Story</th><th>Notes</th></tr>
							</thead>
							<tbody>
								{specialItems.map((i) => {
									const type = i['Special Item Type'] as SpecialItemType;
									return (
										<tr>
											<td>{SPECIAL_ITEM_LABELS[type] ?? type}</td>
											<td>{i.Quantity} {specialItemUnitLabel(type)}</td>
											<td>{SPECIAL_ITEM_STORY_LABELS[i.Story as SpecialItemStory] ?? i.Story ?? '—'}</td>
											<td>{i.Notes}</td>
										</tr>
									);
								})}
							</tbody>
						</table>
					</>
				)}

				<p class="field-hint">
					Access: {walkthrough['Exterior Access'] || 'not set'} outside
					{walkthrough['Interior Access'] ? `, ${walkthrough['Interior Access']} inside` : ''}. Chosen once for the whole
					property; height is charged separately, per occupied floor.
				</p>

				{legacyInventory && (
					<details>
						<summary>Previous inventory details</summary>
						<p class="field-hint">
							This walkthrough was recorded with the older grouped inventory and converted. The original rows below are
							exactly as they were entered and were never changed — everything the simplified shape has no field for is
							kept here rather than dropped.
						</p>

						{legacyInventory.notes.length > 0 && (
							<ul>
								{legacyInventory.notes.map((note) => (
									<li>{note}</li>
								))}
							</ul>
						)}

						<h4>Original window groups</h4>
						<table>
							<thead>
								<tr><th>Qty</th><th>Class</th><th>Size</th><th>Story</th><th>Interior access</th><th>Exterior access</th><th>Notes</th></tr>
							</thead>
							<tbody>
								{legacyInventory.unmapped.groups.map((g) => (
									<tr>
										<td>{g.Quantity}</td>
										<td>{g['Production Class']}{g['Specialty Description'] ? ` — ${g['Specialty Description']}` : ''}</td>
										<td>{g['Size Class'] || '—'}</td>
										<td>{g.Story || '—'}</td>
										<td>{g['Interior Access'] || '—'}</td>
										<td>{g['Exterior Access'] || '—'}</td>
										<td>{g.Notes}</td>
									</tr>
								))}
								{legacyInventory.unmapped.groups.length === 0 && <tr><td colspan="7">No window groups were recorded.</td></tr>}
							</tbody>
						</table>
					</details>
				)}
			</section>
		) : grouped ? (
			<section class="card">
				<h2>Window groups ({groups.length})</h2>
				<table>
					<thead>
						<tr><th>Qty</th><th>Class</th><th>Size</th><th>Story</th><th>Interior access</th><th>Exterior access</th><th>Notes</th></tr>
					</thead>
					<tbody>
						{groups.map((g) => (
							<tr>
								<td>{g.Quantity}</td>
								<td>{g['Production Class']}{g['Specialty Description'] ? ` — ${g['Specialty Description']}` : ''}</td>
								<td>{g['Size Class'] || '—'}</td>
								<td>{g.Story || '—'}</td>
								<td>{g['Interior Access'] || '—'}</td>
								<td>{g['Exterior Access'] || '—'}</td>
								<td>{g.Notes}</td>
							</tr>
						))}
						{groups.length === 0 && <tr><td colspan="7">No window groups recorded.</td></tr>}
					</tbody>
				</table>

				{groups.length > 0 && (
					<form method="POST">
						<input type="hidden" name="_action" value="migrate-inventory" />
						<p class="field-hint">
							These groups can be converted to the simplified inventory. The conversion is conservative — anything the
							simplified shape can't hold exactly is kept verbatim rather than approximated, and the rows above are never
							changed. The hours and price recorded here stay as they are: they are the estimate that was actually made,
							not something to re-derive from today's logic.
						</p>
						<button type="submit" class="btn-secondary">Convert to simplified inventory</button>
					</form>
				)}
			</section>
		) : (
			<section class="card">
				<h2>Items ({items.length})</h2>
				<table>
					<thead>
						<tr><th>Area</th><th>Type</th><th>Qty</th><th>Ext</th><th>Int</th><th>Screen</th><th>Track</th><th>Condition</th></tr>
					</thead>
					<tbody>
						{items.map((i) => (
							<tr>
								<td>{i.Area}</td>
								<td>{i['Item Type']}{i['Item Type'] === 'Window' ? ` (${i['Size Class']})` : ''}</td>
								<td>{i.Quantity}</td>
								<td>{i['Exterior Included']}</td>
								<td>{i['Interior Included']}</td>
								<td>{i['Screen Included']}</td>
								<td>{i['Track Included']}</td>
								<td>{i.Condition}</td>
							</tr>
						))}
						{items.length === 0 && <tr><td colspan="8">No items recorded.</td></tr>}
					</tbody>
				</table>
			</section>
		)}

		{adjustments.length > 0 && (
			<section class="card">
				<h2>Restoration &amp; property factors</h2>
				<table>
					<thead>
						{/* Severity belongs next to the pane count, because together they
						    ARE the price: restoration costs panes × the rate for that
						    severity. Without it the row reads "12 panes, 144 min" and
						    gives no way to tell light work from a razor job. */}
						<tr><th>Kind</th><th>Item</th><th>Panes</th><th>Severity</th><th>Added time</th><th>Notes</th></tr>
					</thead>
					<tbody>
						{adjustments.map((a) => (
							<tr>
								<td>{a.Kind}</td>
								<td>{a.Label}</td>
								<td>{a['Affected Panes'] || '—'}</td>
								<td>{a.Severity || '—'}</td>
								<td>{a['Additional Minutes'] ? `${a['Additional Minutes']} min` : '—'}</td>
								<td>{a.Notes}</td>
							</tr>
						))}
					</tbody>
				</table>
			</section>
		)}

		{walkthrough['Quote ID'] ? (
			<p><a href={`/quotes/${walkthrough['Quote ID']}`}>View quote →</a></p>
		) : (
			<form method="POST">
				<button type="submit">Create quote from this walkthrough</button>
			</form>
		)}
	</main>
</BaseLayout>
