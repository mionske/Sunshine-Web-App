											<input type="hidden" name="_action" value="save-record" />
											<div class="form-grid">
												<label>
													Property type
													<select name="propertyType" required>
														{PROPERTY_TYPES.map((t) => <option value={t} selected={t === property['Property Type']}>{t}</option>)}
													</select>
												</label>
												<label>Street address<input type="text" name="streetAddress" value={property['Street Address']} /></label>
												<label>City<input type="text" name="city" value={property.City} /></label>
												<label>State<input type="text" name="state" value={property.State} /></label>
												<label>Zip<input type="text" name="zip" value={property.Zip} /></label>
												<label>Square footage<input type="number" min="0" name="squareFootage" value={property['Square Footage']} /></label>
												<label>Stories<input type="number" min="1" name="stories" value={property.Stories} /></label>
												<label>Year built<input type="number" name="yearBuilt" value={property['Year Built']} /></label>
												<label>Building / complex<input type="text" name="buildingComplexName" value={property['Building/Complex Name']} /></label>
												<label>Unit identifier<input type="text" name="unitIdentifier" value={property['Unit Identifier']} /></label>
											</div>
											<div class="button-row">
												<button type="submit">Save</button>
												<a class="plink" href={tabHref('overview')}>Cancel</a>
											</div>
										</form>
									) : (
									<div class="prows">
										{RECORD_ROWS.map((row) => (
											<div class="prow">
												<span>{row.label}</span>
												<span class={row.value ? '' : 'pmissing'}>{row.value || (row.important ? 'Missing' : '—')}</span>
											</div>
										))}
									</div>
									)}
									<div class="pcard-footer">
										<span>Last updated {property['Updated At'] ? formatTimestamp(property['Updated At']) : 'never'} ·</span>
										<a class="plink" href={tabHref('history')}>history</a>
									</div>
								</section>
							</div>
						</>
					)}

					{activeTab === 'access' && (
						<>
							<section class="pcard">
								<div class="pcard-header">
									<h2>Access</h2>
									{editingGroup !== 'access' && <a class="plink" href={editHref('access', 'access')}>Edit</a>}
								</div>
								{editingGroup === 'access' ? (
									<form method="POST">
										<input type="hidden" name="_action" value="save-access" />
										<input type="hidden" name="returnTab" value="access" />
										<p class="field-label">Typical interior access</p>
										<div class="segmented">
											{ACCESS_LEVEL_OPTIONS.map((o) => (
												<label><input type="radio" name="interiorAccessDifficulty" value={o} checked={o === interiorAccess} />{o}</label>
											))}
										</div>
										<p class="field-label">Typical exterior access</p>
										<div class="segmented">
											{ACCESS_LEVEL_OPTIONS.map((o) => (
												<label><input type="radio" name="exteriorAccessDifficulty" value={o} checked={o === exteriorAccess} />{o}</label>
											))}
										</div>
										<p class="field-label">Typical exterior method</p>
										<div class="segmented">
											{EXTERIOR_CLEANING_METHOD_OPTIONS.map((o) => (
												<label><input type="radio" name="exteriorCleaningMethod" value={o} checked={o === exteriorCleaningMethodValue} />{o}</label>
											))}
										</div>
										<p class="field-label">Ladder requirement</p>
										<div class="segmented">
											{LADDER_REQUIREMENT_OPTIONS.map((o) => (
												<label><input type="radio" name="highestLadderRequired" value={o} checked={o === ladderRequirementValue} />{o}</label>
											))}
										</div>
										<div class="button-row">
											<button type="submit">Save</button>
											<a class="plink" href={tabHref('access')}>Cancel</a>
										</div>
									</form>
								) : (
									<div class="prows">
										<div class="prow"><span>Typical interior access</span><span class={interiorAccess ? '' : 'pmissing'}>{interiorAccess || 'Missing'}</span></div>
										<div class="prow"><span>Typical exterior access</span><span class={exteriorAccess ? '' : 'pmissing'}>{exteriorAccess || 'Missing'}</span></div>
										<div class="prow"><span>Typical exterior method</span><span class={exteriorCleaningMethodValue ? '' : 'pmissing'}>{exteriorCleaningMethodValue || 'Missing'}</span></div>
										<div class="prow"><span>Ladder requirement</span><span class={ladderRequirementValue ? '' : 'pmissing'}>{ladderRequirementValue || 'Missing'}</span></div>
									</div>
