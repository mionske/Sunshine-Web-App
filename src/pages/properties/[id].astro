---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { createRow, findById, listActiveRows, logActivity, updateRow } from '../../lib/sheets';
import { readRows } from '../../lib/sheets/rows';
import {
	propertyConfig,
	PROPERTY_TYPES,
	ACCESS_LEVEL_OPTIONS,
	WATER_SOURCE_OPTIONS,
	EXTERIOR_CLEANING_METHOD_OPTIONS,
	LADDER_REQUIREMENT_OPTIONS,
	WINDOW_CONDITION_OPTIONS,
	MAINTENANCE_FREQUENCY_OPTIONS,
	PREFERRED_SERVICE_SEASON_OPTIONS,
} from '../../lib/models/property';
import { clientConfig } from '../../lib/models/client';
import { walkthroughConfig } from '../../lib/models/walkthrough';
import { quoteConfig } from '../../lib/models/quote';
import { jobConfig, type Job } from '../../lib/models/job';
import { pipelineConfig, type Opportunity } from '../../lib/models/pipeline';
import { getActivePricingConfig } from '../../lib/pricing/config';
import { computeJobPerformance, computePropertyPerformance } from '../../lib/pricing/calibration';
import { googleMapsUrl, fullAddress } from '../../lib/mapsLink';

const { id } = Astro.params;
let error: string | null = null;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = String(form.get('_action') ?? '');
	try {
		if (action === 'update-property') {
			await updateRow(env, propertyConfig, id!, {
				'Property Type': String(form.get('propertyType') ?? '') as (typeof PROPERTY_TYPES)[number],
				'Street Address': String(form.get('streetAddress') ?? ''),
				City: String(form.get('city') ?? ''),
				State: String(form.get('state') ?? ''),
				Zip: String(form.get('zip') ?? ''),
				'Year Built': String(form.get('yearBuilt') ?? ''),
				'Square Footage': String(form.get('squareFootage') ?? ''),
				Stories: String(form.get('stories') ?? ''),
				'Interior Access Difficulty': String(form.get('interiorAccessDifficulty') ?? ''),
				'Exterior Access Difficulty': String(form.get('exteriorAccessDifficulty') ?? ''),
				'Roof Access Required (Y/N)': form.get('roofAccessRequired') === 'on' ? 'Y' : 'N',
				'Water Source': String(form.get('waterSource') ?? ''),
				'Exterior Cleaning Method': String(form.get('exteriorCleaningMethod') ?? ''),
				'Ladder Requirement': String(form.get('highestLadderRequired') ?? ''),
				'Hard Water History (Y/N)': form.get('hardWaterStainingPresent') === 'on' ? 'Y' : 'N',
				'Construction Debris (Y/N)': form.get('constructionDebrisPresent') === 'on' ? 'Y' : 'N',
				'Window Condition': String(form.get('windowCondition') ?? ''),
				'Total Window Units': String(form.get('totalWindowUnits') ?? ''),
				'Total Glass Panes': String(form.get('totalGlassPanes') ?? ''),
				'Count - Double Hung': String(form.get('countDoubleHung') ?? ''),
				'Count - Casement': String(form.get('countCasement') ?? ''),
				'Count - Picture': String(form.get('countPicture') ?? ''),
				'Count - Sliding': String(form.get('countSliding') ?? ''),
				'Count - French': String(form.get('countFrench') ?? ''),
				'Count - Awning': String(form.get('countAwning') ?? ''),
				'Count - Skylights': String(form.get('countSkylights') ?? ''),
				'Count - Solar Panels': String(form.get('countSolarPanels') ?? ''),
				'Sliding Glass Door Pane Count': String(form.get('slidingGlassDoorPaneCount') ?? ''),
				'Screen Count': String(form.get('screenCount') ?? ''),
				'Track Count': String(form.get('trackCount') ?? ''),
				'Desired Maintenance Frequency': String(form.get('desiredMaintenanceFrequency') ?? ''),
				'Preferred Service Season': String(form.get('preferredServiceSeason') ?? ''),
				'Next Recommended Service Date': String(form.get('nextRecommendedServiceDate') ?? ''),
				'Maintenance Notes': String(form.get('maintenanceNotes') ?? ''),
				'Next Scheduled Visit': String(form.get('nextScheduledVisit') ?? ''),
				'Last Review Requested Date': String(form.get('lastReviewRequestedDate') ?? ''),
				'Last Review Received Date': String(form.get('lastReviewReceivedDate') ?? ''),
				'Access Notes': String(form.get('accessNotes') ?? ''),
				'Pet Notes': String(form.get('petNotes') ?? ''),
				'General Notes': String(form.get('generalNotes') ?? ''),
				'Building/Complex Name': String(form.get('buildingComplexName') ?? ''),
				'Unit Identifier': String(form.get('unitIdentifier') ?? ''),
			});
		} else if (action === 'add-note') {
			const note = String(form.get('note') ?? '').trim();
			if (note) {
				await logActivity(env, { entityType: 'Property', entityId: id!, action: 'Note added', notes: note });
			}
		}
		return Astro.redirect(`/properties/${id}`);
	} catch (e) {
		error = (e as Error).message;
	}
}

const property = await findById(env, propertyConfig, id!);
if (!property) {
	return new Response('Property not found', { status: 404 });
}

const client = property['Client ID'] ? await findById(env, clientConfig, property['Client ID']) : null;

// One-time compatibility default: if this property predates 'Exterior
// Cleaning Method' but has the legacy 'Water-Fed Pole Suitable (Y/N)'
// checkbox set, pre-select the matching new radio option instead of
// showing nothing selected — never writes anything until the form is
// actually saved.
const exteriorCleaningMethodValue =
	property['Exterior Cleaning Method'] ||
	(property['Water-Fed Pole Suitable (Y/N)'] === 'Y'
		? 'Water-Fed Pole Suitable'
		: property['Water-Fed Pole Suitable (Y/N)'] === 'N'
			? 'Traditional Cleaning Required'
			: '');

const [allQuotes, allJobs, allOpportunities, allWalkthroughs, pricingConfig, activityRows] = await Promise.all([
	listActiveRows(env, quoteConfig),
	listActiveRows(env, jobConfig),
	listActiveRows(env, pipelineConfig),
	listActiveRows(env, walkthroughConfig),
	property['Property Type'] ? getActivePricingConfig(env, property['Property Type']) : Promise.resolve(null),
	readRows(env, 'ActivityLog', { idColumn: 'Activity ID' }),
]);
const propertyWalkthroughs = allWalkthroughs.filter((w) => w['Property ID'] === id);

const streetAddress = property['Street Address'].toLowerCase();
const propertyQuotes = allQuotes.filter((q) => q['Property ID'] === id);
const propertyOpportunities = allOpportunities.filter((o) => o['Property ID'] === id);
// Matched primarily by Property ID; falls back to address-substring matching
// for jobs that predate that column.
const propertyJobs: Job[] = allJobs.filter((j) =>
	j['Property ID'] ? j['Property ID'] === id : j['Property Address'].toLowerCase().includes(streetAddress)
);

const OPEN_OPPORTUNITY_STAGES = new Set(['New Lead', 'Contacted', 'Walkthrough Scheduled', 'Quote Draft', 'Quote Sent', 'Follow-up']);
const ACTIVE_JOB_STATUSES = new Set(['Scheduled', 'In Progress']);
const COMPLETED_JOB_STATUSES = new Set(['Completed', 'Invoiced', 'Paid']);

function derivePropertyStatus(opportunities: Opportunity[], jobs: Job[]): string {
	if (property!['Archived At']) return 'Archived';
	if (jobs.some((j) => COMPLETED_JOB_STATUSES.has(j['Job Status']))) return 'Established Client';
	if (jobs.some((j) => ACTIVE_JOB_STATUSES.has(j['Job Status']))) return 'Active — Job Scheduled';
	if (opportunities.some((o) => OPEN_OPPORTUNITY_STAGES.has(o.Stage))) return 'Prospect';
	return 'New';
}
const propertyStatus = derivePropertyStatus(propertyOpportunities, propertyJobs);

const targetHourlyRate = Number(pricingConfig?.['Target Hourly Rate'] ?? 0);
const jobRows = propertyJobs.map((job) => ({ job, perf: computeJobPerformance(job, targetHourlyRate) }));
const performance = computePropertyPerformance(propertyJobs);

// Timeline: every ActivityLog entry whose Entity ID belongs to this
// property — directly, or via its client/quotes/jobs/opportunities.
const relevantIds = new Set<string>([
	id!,
	...(client ? [client['Client ID']] : []),
	...propertyQuotes.map((q) => q['Quote ID']),
	...propertyJobs.map((j) => j['Job ID']),
	...propertyOpportunities.map((o) => o['Opportunity ID']),
	...propertyWalkthroughs.map((w) => w['Walkthrough ID']),
]);
const quoteIdByJobId = Object.fromEntries(propertyJobs.map((j) => [j['Job ID'], j['Quote ID']]));

function timelineLink(entityType: string, entityId: string): string | null {
	if (entityType === 'Quote') return `/quotes/${entityId}`;
	if (entityType === 'Job') return quoteIdByJobId[entityId] ? `/quotes/${quoteIdByJobId[entityId]}` : null;
	if (entityType === 'Client') return `/clients/${entityId}`;
	if (entityType === 'Walkthrough') return `/walkthroughs/${entityId}`;
	if (entityType === 'Opportunity') return '/pipeline';
	if (entityType === 'PricingConfig') return '/pricing-config';
	if (entityType === 'CalibrationSnapshot') return '/calibration';
	return null;
}

const timeline = activityRows
	.map((r) => r.data)
	.filter((entry) => relevantIds.has(String(entry['Entity ID'] ?? '')))
	.sort((a, b) => String(b.Timestamp ?? '').localeCompare(String(a.Timestamp ?? '')));
---

<BaseLayout title={property['Street Address']}>
	<main>
		<p><a href={`/clients/${property['Client ID']}`}>← Client</a></p>
		<div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
			<h1 style="margin: 0; white-space: nowrap;">
				<a href={googleMapsUrl(fullAddress(property))} target="_blank" rel="noopener noreferrer">
					{property['Street Address']}, {property.City}
				</a>
			</h1>
			<span class="badge badge-accent">{propertyStatus}</span>
		</div>
		{error && <p role="alert">{error}</p>}

		<div class="stats-grid">
			<div class="card">
				<span class="stat-label">Type</span>
				<div class="stat" style="font-size: 1.25rem;">{property['Property Type']}</div>
			</div>
			<div class="card">
				<span class="stat-label">Window Units</span>
				<div class="stat" style="font-size: 1.25rem;">{property['Total Window Units'] || '0'}</div>
			</div>
			<div class="card">
				<span class="stat-label">Glass Panes</span>
				<div class="stat" style="font-size: 1.25rem;">{property['Total Glass Panes'] || '0'}</div>
			</div>
			<div class="card">
				<span class="stat-label">Stories</span>
				<div class="stat" style="font-size: 1.25rem;">{property.Stories || '— not set'}</div>
			</div>
			<div class="card">
				<span class="stat-label">Next Service</span>
				<div class="stat" style={{ fontSize: '1.25rem', color: property['Next Recommended Service Date'] ? undefined : 'var(--color-ink-muted)' }}>
					{property['Next Recommended Service Date'] || '— not set'}
				</div>
			</div>
		</div>

		<p class="field-hint" style="margin-top: -0.75rem;">
			<a href={`/walkthroughs/new?propertyId=${property['Property ID']}`}>Start walkthrough</a>
			{' · '}
			<a href={`/quoter?propertyId=${property['Property ID']}&clientId=${property['Client ID']}`}>Create quote</a>
			{' · '}
			<a href={`/clients/${property['Client ID']}`}>Edit client</a>
			{' · '}
			<a href={`/historical-entry?propertyId=${property['Property ID']}&clientId=${property['Client ID']}`}>Add historical record</a>
			{client?.['Referral Source'] && <> · Referral source: {client['Referral Source']}</>}
		</p>

		<div class="property-layout">
			<div>
				<form method="POST">
					<input type="hidden" name="_action" value="update-property" />

					<section class="card">
						<h2>Address</h2>
						<label>
							Property type
							<select name="propertyType" required>
								{PROPERTY_TYPES.map((t) => <option value={t} selected={t === property['Property Type']}>{t}</option>)}
							</select>
						</label>
						<label>Street address <input type="text" name="streetAddress" value={property['Street Address']} required /></label>
						<label>City <input type="text" name="city" value={property.City} /></label>
						<label>State <input type="text" name="state" maxlength="2" value={property.State} placeholder="CO" /></label>
						<label>Zip <input type="text" name="zip" value={property.Zip} /></label>
						<label>Year built <input type="text" name="yearBuilt" value={property['Year Built']} /></label>
						<label>Square footage <input type="text" name="squareFootage" value={property['Square Footage']} /></label>
						<label>Stories <input type="text" name="stories" value={property.Stories} /></label>
						<label>Building/complex name (optional) <input type="text" name="buildingComplexName" value={property['Building/Complex Name']} /></label>
						<label>Unit identifier (optional) <input type="text" name="unitIdentifier" value={property['Unit Identifier']} /></label>
					</section>

					<details class="card" open>
						<summary>Access &amp; Conditions</summary>
						<div class="card-grid">
							<div>
								<p class="field-label">Interior Access</p>
								<div class="segmented">
									{ACCESS_LEVEL_OPTIONS.map((o) => (
										<label><input type="radio" name="interiorAccessDifficulty" value={o} checked={o === property['Interior Access Difficulty']} /> {o}</label>
									))}
								</div>
							</div>
							<div>
								<p class="field-label">Exterior Access</p>
								<div class="segmented">
									{ACCESS_LEVEL_OPTIONS.map((o) => (
										<label><input type="radio" name="exteriorAccessDifficulty" value={o} checked={o === property['Exterior Access Difficulty']} /> {o}</label>
									))}
								</div>
							</div>
							<div>
								<p class="field-label">Water Source</p>
								<div class="segmented">
									{WATER_SOURCE_OPTIONS.map((o) => (
										<label><input type="radio" name="waterSource" value={o} checked={o === property['Water Source']} /> {o}</label>
									))}
								</div>
							</div>
							<div>
								<p class="field-label">Exterior Cleaning Method</p>
								<div class="segmented">
									{EXTERIOR_CLEANING_METHOD_OPTIONS.map((o) => (
										<label><input type="radio" name="exteriorCleaningMethod" value={o} checked={o === exteriorCleaningMethodValue} /> {o}</label>
									))}
								</div>
							</div>
						</div>
						<label><input type="checkbox" name="roofAccessRequired" checked={property['Roof Access Required (Y/N)'] === 'Y'} /> Roof Access Required</label>
					</details>

					<details class="card" open>
						<summary>Windows &amp; Doors</summary>
						<label>
							Window Units
							<span class="field-hint">Approximate number of window assemblies.</span>
							<input type="number" class="field-numeric" name="totalWindowUnits" value={property['Total Window Units']} />
						</label>
						<label>
							Total Glass Panes
							<span class="field-hint">Total number of individual glass panes.</span>
							<input type="number" class="field-numeric" id="totalPanes" name="totalGlassPanes" value={property['Total Glass Panes']} />
						</label>
						<p id="paneBreakdownStatus" class="field-status"></p>

						<div class="card-grid">
							<div>
								<p class="field-label">Highest Ladder Required</p>
								<div class="segmented">
									{LADDER_REQUIREMENT_OPTIONS.map((o) => (
										<label><input type="radio" name="highestLadderRequired" value={o} checked={o === property['Ladder Requirement']} /> {o}</label>
									))}
								</div>
							</div>
							<div>
								<p class="field-label">Window Condition</p>
								<div class="segmented">
									{WINDOW_CONDITION_OPTIONS.map((o) => (
										<label><input type="radio" name="windowCondition" value={o} checked={o === property['Window Condition']} /> {o}</label>
									))}
								</div>
							</div>
						</div>
						<label><input type="checkbox" name="hardWaterStainingPresent" checked={property['Hard Water History (Y/N)'] === 'Y'} /> Hard Water Staining Present</label>
						<label><input type="checkbox" name="constructionDebrisPresent" checked={property['Construction Debris (Y/N)'] === 'Y'} /> Construction Debris Present</label>

						<p class="field-label" style="margin-top: 1rem;">Pane Breakdown</p>
						<span class="field-hint">These should add up to Total Glass Panes above.</span>
						<div class="count-grid">
							<label>Double Hung <input type="number" class="field-numeric pane-breakdown-field" name="countDoubleHung" value={property['Count - Double Hung']} /></label>
							<label>Casement <input type="number" class="field-numeric pane-breakdown-field" name="countCasement" value={property['Count - Casement']} /></label>
							<label>Picture <input type="number" class="field-numeric pane-breakdown-field" name="countPicture" value={property['Count - Picture']} /></label>
							<label>Sliding Window <input type="number" class="field-numeric pane-breakdown-field" name="countSliding" value={property['Count - Sliding']} /></label>
							<label>French / Divided-Light <input type="number" class="field-numeric pane-breakdown-field" name="countFrench" value={property['Count - French']} /></label>
							<label>Awning <input type="number" class="field-numeric pane-breakdown-field" name="countAwning" value={property['Count - Awning']} /></label>
							<label>Skylight <input type="number" class="field-numeric pane-breakdown-field" name="countSkylights" value={property['Count - Skylights']} /></label>
							<label>Sliding Glass Door <input type="number" class="field-numeric pane-breakdown-field" name="slidingGlassDoorPaneCount" value={property['Sliding Glass Door Pane Count']} /></label>
						</div>

						<p class="field-label">Accessories</p>
						<span class="field-hint">Not included in pane totals.</span>
						<div class="count-grid">
							<label>Screens <input type="number" class="field-numeric" name="screenCount" value={property['Screen Count']} /></label>
							<label>Tracks <input type="number" class="field-numeric" name="trackCount" value={property['Track Count']} /></label>
							<label>Solar Panels <input type="number" class="field-numeric" name="countSolarPanels" value={property['Count - Solar Panels']} /></label>
						</div>
					</details>

					<details class="card" open>
						<summary>Maintenance &amp; Notes</summary>
						<div class="card-grid">
							<label>
								Desired maintenance frequency
								<select name="desiredMaintenanceFrequency">
									<option value="" selected={!property['Desired Maintenance Frequency']} />
									{MAINTENANCE_FREQUENCY_OPTIONS.map((v) => <option value={v} selected={v === property['Desired Maintenance Frequency']}>{v}</option>)}
								</select>
							</label>
							<label>
								Preferred service season
								<select name="preferredServiceSeason">
									<option value="" selected={!property['Preferred Service Season']} />
									{PREFERRED_SERVICE_SEASON_OPTIONS.map((v) => <option value={v} selected={v === property['Preferred Service Season']}>{v}</option>)}
								</select>
							</label>
							<label>Next recommended service date (planning estimate only) <input type="date" name="nextRecommendedServiceDate" value={property['Next Recommended Service Date']} /></label>
							<label>Next scheduled visit <input type="date" name="nextScheduledVisit" value={property['Next Scheduled Visit']} /></label>
							<label>Last review requested date <input type="date" name="lastReviewRequestedDate" value={property['Last Review Requested Date']} /></label>
							<label>Last review received date <input type="date" name="lastReviewReceivedDate" value={property['Last Review Received Date']} /></label>
						</div>
						<label>Maintenance notes <textarea name="maintenanceNotes">{property['Maintenance Notes']}</textarea></label>
						<label>Access notes <textarea name="accessNotes" placeholder="Parking, gate, water source, exterior/interior access">{property['Access Notes']}</textarea></label>
						<label>Pet notes <textarea name="petNotes">{property['Pet Notes']}</textarea></label>
						<label>General notes <textarea name="generalNotes">{property['General Notes']}</textarea></label>
					</details>

					<button type="submit">Save</button>
				</form>
			</div>

			<div>
				<section class="card">
					<h2>Walkthroughs</h2>
					{propertyWalkthroughs.map((w) => (
						<div class="sidebar-row">
							<div class="sidebar-row-main">
								<a href={`/walkthroughs/${w['Walkthrough ID']}`}>{w['Walkthrough Date']}</a>
								<span class="badge">{w.Status}</span>
							</div>
							{w['Suggested Target Price'] && <div class="sidebar-row-meta">${w['Suggested Target Price']} suggested</div>}
						</div>
					))}
					{propertyWalkthroughs.length === 0 && <p>No walkthroughs yet.</p>}
				</section>

				<section class="card">
					<h2>Quotes</h2>
					{propertyQuotes.map((q) => (
						<div class="sidebar-row">
							<div class="sidebar-row-main">
								<a href={`/quotes/${q['Quote ID']}`}>{q['Quote ID'].slice(0, 8)}</a>
								<span class="badge">{q['Quote Status']}</span>
							</div>
							<div class="sidebar-row-meta">
								${q['Final Quoted Price']} · calc v{q['Calculator Version']} · created {q['Created At']}
								{q['Sent At'] && <> · sent {q['Sent At']}</>}
								{q['Accepted At'] && <> · accepted {q['Accepted At']}</>}
							</div>
						</div>
					))}
					{propertyQuotes.length === 0 && <p>No quotes yet.</p>}
				</section>

				<section class="card">
					<h2>Jobs</h2>
					{jobRows.map(({ job, perf }) => (
						<div class="sidebar-row">
							<div class="sidebar-row-main">
								<span>{job['Date Completed']}</span>
								<span class="badge">{job['Job Status']}</span>
							</div>
							<div class="sidebar-row-meta">
								${perf.finalRevenue.toFixed(2)} · {perf.actualHours.toFixed(2)} on-site hrs · ${perf.actualRevenuePerLaborHour.toFixed(2)}/hr
								{job['Callback Required (Y/N)'] === 'Y' && <> · callback</>}
							</div>
							<div class="sidebar-row-meta">
								{job['Quote ID'] && <a href={`/quotes/${job['Quote ID']}`}>View quote</a>}
								{' '}<a href={`/jobs/${job['Job ID']}`}>Job Day</a>
							</div>
						</div>
					))}
					{jobRows.length === 0 && <p>No jobs logged yet.</p>}
				</section>

				{performance.completedJobCount > 0 && (
					<section class="card">
						<h2>Historical property performance</h2>
						{performance.completedJobCount <= 2 && <p><em>Limited history. Treat as directional only.</em></p>}
						<p>
							<span class="stat-label">Completed jobs</span>
							<span class="stat">{performance.completedJobCount}</span>
						</p>
						<ul>
							<li>Included in calibration: {performance.includedCount}</li>
							<li>Excluded from calibration: {performance.excludedCount}</li>
							<li>Average on-site hours: {performance.averageOnSiteHours.toFixed(2)}</li>
							<li>Average final revenue: ${performance.averageFinalRevenue.toFixed(2)}</li>
							<li>Average revenue per on-site hour: ${performance.averageRevenuePerOnSiteHour.toFixed(2)}</li>
							<li>Total callbacks: {performance.totalCallbacks}</li>
							<li>Most recent service date: {performance.mostRecentServiceDate || 'unknown'}</li>
						</ul>
					</section>
				)}

				<section class="card timeline-card">
					<h2>Activity timeline</h2>
					<form method="POST" style="margin-bottom: 1rem;">
						<input type="hidden" name="_action" value="add-note" />
						<label>Add a note <textarea name="note" required></textarea></label>
						<button type="submit">Add note</button>
					</form>
					{timeline.map((entry) => {
						const link = timelineLink(String(entry['Entity Type'] ?? ''), String(entry['Entity ID'] ?? ''));
						return (
							<div class="sidebar-row">
								<div class="sidebar-row-main">
									<span class="badge">{String(entry['Entity Type'] ?? '')}</span>
									<span>{String(entry.Timestamp ?? '')}</span>
								</div>
								<div class="sidebar-row-meta">
									{String(entry.Action ?? '')}
									{entry.Notes ? ` — ${entry.Notes}` : ''}
									{link && <> (<a href={link}>view</a>)</>}
								</div>
							</div>
						);
					})}
					{timeline.length === 0 && <p>No activity recorded yet.</p>}
				</section>
			</div>
		</div>
	</main>

	<script>
		const totalPanesInput = document.getElementById('totalPanes') as HTMLInputElement;
		const breakdownFields = Array.from(document.querySelectorAll('.pane-breakdown-field')) as HTMLInputElement[];
		const status = document.getElementById('paneBreakdownStatus') as HTMLElement;

		function checkPaneBreakdown() {
			const breakdownTotal = breakdownFields.reduce((sum, field) => sum + (Number(field.value) || 0), 0);
			const totalPanes = Number(totalPanesInput.value) || 0;

			if (breakdownTotal === 0 && totalPanes === 0) {
				status.textContent = '';
				status.className = 'field-status';
				return;
			}
			if (breakdownTotal === totalPanes) {
				status.textContent = `✓ Pane breakdown matches total panes`;
				status.className = 'field-status field-status-ok';
			} else {
				status.textContent = `⚠ Pane breakdown totals ${breakdownTotal} of ${totalPanes} panes`;
				status.className = 'field-status mismatch';
			}
		}

		totalPanesInput.addEventListener('input', checkPaneBreakdown);
		breakdownFields.forEach((field) => field.addEventListener('input', checkPaneBreakdown));
		checkPaneBreakdown();
	</script>
</BaseLayout>
