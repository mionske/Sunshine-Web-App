									reference numbers.
								</p>
								<form method="POST" class="pcard-footer">
									<input type="hidden" name="_action" value="update-property" />
									<input type="hidden" name="returnTab" value="inventory" />
									<span class={inventoryVerifiedAt ? 'pdot pdot-ok' : 'pdot'}></span>
									<span>{scaleFooter}</span>
									<input type="text" name="verifiedBy" placeholder="Verified by" value={inventoryVerifiedBy} style="width:11rem;margin:0" />
									<button type="submit" name="markInventoryVerified" value="1" class="plink" style="background:none;border:none;padding:0;width:auto;cursor:pointer">
										Mark inventory verified
									</button>
								</form>
							</section>

							{latestWalkthrough && (
								<section class="pcard">
									<div class="pcard-header"><h2>Latest walkthrough counts</h2></div>
									<div class="prows">
										<div class="prow"><span>Window units</span><span>{latestWalkthrough['Total Window Units'] || '—'}</span></div>
										<div class="prow"><span>Glass panes</span><span>{latestWalkthrough['Total Glass Panes'] || '—'}</span></div>
										<div class="prow"><span>Screens</span><span>{latestWalkthrough['Total Screens'] || '—'}</span></div>
										<div class="prow"><span>Tracks</span><span>{latestWalkthrough['Total Tracks'] || '—'}</span></div>
									</div>
									<div class="pcard-footer">
										<span>Recorded {latestWalkthrough['Walkthrough Date']} — visit-specific, separate from the standing counts above ·</span>
										<a class="plink" href={`/walkthroughs/${latestWalkthrough['Walkthrough ID']}`}>open walkthrough</a>
									</div>
								</section>
							)}
						</>
					)}

					{activeTab === 'photos' && (
						<section class="pcard">
							<div class="pcard-header"><h2>Photos</h2></div>
							<PropertyPhotos client:load propertyId={id} photos={propertyPhotoDtos} categories={PHOTO_CATEGORIES} />
						</section>
					)}

					{activeTab === 'notes' && (
						<section class="pcard">
							<div class="pcard-header">
								<h2>Notes</h2>
								{editingGroup !== 'notes' && <a class="plink" href={editHref('notes', 'notes')}>Edit</a>}
							</div>
							{editingGroup === 'notes' ? (
								<form method="POST">
									<input type="hidden" name="_action" value="save-notes" />
									<input type="hidden" name="returnTab" value="notes" />
									<label>
										Repeat business status
										<select name="repeatBusinessStatus">
											<option value="">Not set</option>
											{REPEAT_BUSINESS_STATUS_OPTIONS.map((v) => (
												<option value={v} selected={v === property['Repeat Business Status']}>{v}</option>
											))}
										</select>
									</label>
									<label>Pet notes<textarea name="petNotes">{property['Pet Notes']}</textarea></label>
									<label>Property notes<textarea name="generalNotes">{property['General Notes']}</textarea></label>
									<div class="button-row">
										<button type="submit">Save</button>
										<a class="plink" href={tabHref('notes')}>Cancel</a>
									</div>
								</form>
							) : (
								<div class="prows">
									<div class="prow"><span>Repeat business</span><span class={property['Repeat Business Status'] ? '' : 'pmissing'}>{property['Repeat Business Status'] || 'Not set'}</span></div>
									<div class="prow"><span>Pet notes</span><span class={property['Pet Notes'] ? '' : 'pmissing'}>{property['Pet Notes'] || 'No pet notes'}</span></div>
									<div class="prow"><span>Property notes</span><span class={property['General Notes'] ? '' : 'pmissing'}>{property['General Notes'] || 'No property notes'}</span></div>
								</div>
							)}
						</section>
					)}

					{activeTab === 'walkthroughs' && (
						<section class="pcard">
							<div class="pcard-header">
								<h2>Walkthroughs</h2>
								<a class="plink" href={`/walkthroughs/new?propertyId=${id}`}>Start new walkthrough</a>
							</div>
							{propertyWalkthroughs.length === 0 ? (
								<p class="pflags-none">No walkthroughs yet.</p>
							) : (
								<table>
									<thead><tr><th>Date</th><th>Status</th><th>Units</th><th>Labor</th><th>Price</th></tr></thead>
									<tbody>
										{propertyWalkthroughs.map((w) => (
											<tr>
												<td><a href={`/walkthroughs/${w['Walkthrough ID']}`}>{w['Walkthrough Date'] || '—'}</a></td>
												<td>{w.Status}{w['Inventory Model'] === 'grouped-v2' ? '' : ' · legacy'}</td>
												<td>{w['Total Window Units'] || '—'}</td>
												<td>{w['Productive Labor Minutes'] ? `${(Number(w['Productive Labor Minutes']) / 60).toFixed(1)} h` : w['Estimated On-Site Labor Hours'] ? `${w['Estimated On-Site Labor Hours']} h` : '—'}</td>
												<td>{w['Owner Override Price'] ? `$${w['Owner Override Price']}` : w['Suggested Target Price'] ? `$${w['Suggested Target Price']}` : '—'}</td>
											</tr>
										))}
									</tbody>
								</table>
							)}
						</section>
					)}

					{activeTab === 'quotes' && (
						<section class="pcard">
							<div class="pcard-header">
								<h2>Quotes</h2>
								<a class="plink" href={`/quoter?propertyId=${id}`}>Create quote</a>
							</div>
							{propertyQuotes.length === 0 ? (
								<p class="pflags-none">No quotes yet.</p>
							) : (
								<table>
									<thead><tr><th>Created</th><th>Status</th><th>Amount</th><th>Labor</th></tr></thead>
									<tbody>
										{propertyQuotes.map((q) => (
											<tr>
												<td><a href={`/quotes/${q['Quote ID']}`}>{(q['Created At'] || '').slice(0, 10)}</a></td>
												<td>{q['Quote Status']}</td>
												<td>${q['Final Quoted Price']}</td>
												<td>{q['Estimated Labor Hours'] ? `${Number(q['Estimated Labor Hours']).toFixed(1)} h` : '—'}</td>
											</tr>
										))}
									</tbody>
								</table>
							)}
						</section>
					)}

					{activeTab === 'jobs' && (
						<>
							<section class="pcard">
								<div class="pcard-header"><h2>Jobs</h2></div>
								{propertyJobs.length === 0 ? (
									<p class="pflags-none">No jobs yet.</p>
								) : (
									<table>
										<thead><tr><th>Scheduled</th><th>Status</th><th>Revenue</th><th>Actual hours</th></tr></thead>
										<tbody>
											{jobRows.map(({ job, perf }) => (
												<tr>
													<td>{job['Quote ID'] ? <a href={`/quotes/${job['Quote ID']}`}>{job['Scheduled Date'] || '—'}</a> : job['Scheduled Date'] || '—'}</td>
													<td>{job['Job Status']}</td>
													<td>{job['Final Price ($)'] ? `$${job['Final Price ($)']}` : '—'}</td>
													<td>{perf.actualHours ? `${perf.actualHours.toFixed(1)} h` : '—'}</td>
												</tr>
											))}
										</tbody>
									</table>
								)}
							</section>
							{performance.completedJobCount > 0 && (
								<section class="pcard">
									<div class="pcard-header"><h2>Historical performance</h2></div>
									<div class="prows">
										<div class="prow"><span>Completed jobs</span><span>{performance.completedJobCount}</span></div>
										<div class="prow"><span>Total revenue</span><span>${performance.totalRevenue.toFixed(2)}</span></div>
										<div class="prow"><span>Average revenue per hour</span><span>${performance.averageRevenuePerHour.toFixed(2)}</span></div>
									</div>
								</section>
							)}
						</>
					)}

					{activeTab === 'history' && (
						<section class="pcard">
							<div class="pcard-header">
								<h2>History</h2>
								<span>
									{TIMELINE_TYPES.map((t) => (
										<>
											<a class="plink" href={`/properties/${id}?tab=history${t ? `&type=${t}` : ''}`} style={t === timelineType ? 'text-decoration:underline' : ''}>
												{t || 'All'}
											</a>{' '}
										</>
									))}
								</span>
							</div>
							<form method="POST">
								<input type="hidden" name="_action" value="add-note" />
								<label>Add a note<input type="text" name="note" placeholder="What happened?" /></label>
								<button type="submit">Add note</button>
							</form>
							{visibleTimeline.length === 0 ? (
								<p class="pflags-none">Nothing recorded yet.</p>
							) : (
								<div class="prows">
									{visibleTimeline.map((entry) => {
										const href = timelineLink(String(entry['Entity Type'] ?? ''), String(entry['Entity ID'] ?? ''));
										return (
											<div class="prow">
												<span>
													<span class="badge">{String(entry['Entity Type'] ?? '')}</span>{' '}
													{String(entry.Action ?? '')}
													{entry.Notes ? ` — ${entry.Notes}` : ''}
													{href && <> · <a class="plink" href={href}>view</a></>}
												</span>
												<span>{entry.Timestamp ? formatTimestamp(String(entry.Timestamp)) : ''}</span>
											</div>
										);
									})}
								</div>
							)}
						</section>
					)}

					{activeTab === 'edit' && (
						<section class="pcard">
							<div class="pcard-header">
								<h2>Edit property</h2>
								<a class="plink" href={tabHref('overview')}>Cancel</a>
							</div>
							<p class="pflags-none">
								Every permanent property field, in one form. Per-card inline editing lands in the next pass — until then
								nothing has been taken away.
							</p>
				<form method="POST">
					<input type="hidden" name="_action" value="update-property" />

					<section class="card">
						<h2>Property Information</h2>
						<label>
							Property type
							<select name="propertyType" required>
								{PROPERTY_TYPES.map((t) => <option value={t} selected={t === property['Property Type']}>{t}</option>)}
							</select>
						</label>
						<label>Street address <input type="text" name="streetAddress" value={property['Street Address']} required /></label>
						<label>City <input type="text" name="city" value={property.City} /></label>
						<label>State <input type="text" name="state" maxlength="2" value={property.State} placeholder="CO" /></label>
						<label>Zip <input type="text" name="zip" value={property.Zip} /></label>
						<label>Year built <input type="text" name="yearBuilt" value={property['Year Built']} /></label>
						<label>Square footage <input type="text" name="squareFootage" value={property['Square Footage']} /></label>
						<label>Stories <input type="text" name="stories" value={property.Stories} /></label>
						<label>Building/complex name (optional) <input type="text" name="buildingComplexName" value={property['Building/Complex Name']} /></label>
						<label>Unit identifier (optional) <input type="text" name="unitIdentifier" value={property['Unit Identifier']} /></label>
					</section>

					<details class="card" open>
						<summary>Permanent Access &amp; Setup</summary>
						<div class="card-grid">
							<div>
								<p class="field-label">Interior Access</p>
								<div class="segmented">
									{ACCESS_LEVEL_OPTIONS.map((o) => (
										<label><input type="radio" name="interiorAccessDifficulty" value={o} checked={o === property['Interior Access Difficulty']} /> {o}</label>
									))}
								</div>
							</div>
							<div>
								<p class="field-label">Exterior Access</p>
								<div class="segmented">
									{ACCESS_LEVEL_OPTIONS.map((o) => (
										<label><input type="radio" name="exteriorAccessDifficulty" value={o} checked={o === property['Exterior Access Difficulty']} /> {o}</label>
									))}
								</div>
							</div>
							<div>
								<p class="field-label">Typical Exterior Method</p>
								<div class="segmented">
									{EXTERIOR_CLEANING_METHOD_OPTIONS.map((o) => (
										<label><input type="radio" name="exteriorCleaningMethod" value={o} checked={o === exteriorCleaningMethodValue} /> {o}</label>
									))}
								</div>
							</div>
							<div>
								<p class="field-label">Ladder Requirement</p>
								<div class="segmented">
									{LADDER_REQUIREMENT_OPTIONS.map((o) => (
										<label><input type="radio" name="highestLadderRequired" value={o} checked={o === ladderRequirementValue} /> {o}</label>
									))}
								</div>
							</div>
						</div>

						<p class="field-label" style="margin-top: 1rem;">Access Considerations</p>
						<label><input type="checkbox" name="roofAccessRequired" checked={property['Roof Access Required (Y/N)'] === 'Y'} /> Roof Access Required</label>
						<label><input type="checkbox" name="highInteriorGlass" checked={property['High Interior Glass (Y/N)'] === 'Y'} /> High Interior Glass</label>
						<label><input type="checkbox" name="steepOrUnevenTerrain" checked={property['Steep Or Uneven Terrain (Y/N)'] === 'Y'} /> Steep Or Uneven Terrain</label>
						<label><input type="checkbox" name="restrictedWorkOrSetupArea" checked={property['Restricted Work Or Setup Area (Y/N)'] === 'Y'} /> Restricted Work Or Setup Area</label>

						<div class="card-grid" style="margin-top: 1rem;">
							<div>
								<p class="field-label">Water Access</p>
								<div class="segmented">
									{WATER_ACCESS_OPTIONS.map((o) => (
										<label><input type="radio" name="waterAccessMethod" value={o} checked={o === waterAccessValue} /> {o}</label>
									))}
								</div>
							</div>
							<div>
								<p class="field-label">Water Supply</p>
								<div class="segmented">
									{WATER_SUPPLY_OPTIONS.map((o) => (
										<label><input type="radio" name="waterSupply" value={o} checked={o === waterSupplyValue} /> {o}</label>
									))}
								</div>
							</div>
							<div>
								<p class="field-label">Parking &amp; Setup</p>
								<div class="segmented">
									{PARKING_AND_SETUP_OPTIONS.map((o) => (
										<label><input type="radio" name="parkingAndSetupDifficulty" value={o} checked={o === parkingAndSetupValue} /> {o}</label>
									))}
								</div>
							</div>
						</div>

						<label><input type="checkbox" name="gateOrEntryRestriction" checked={property['Gate Or Entry Restriction (Y/N)'] === 'Y'} /> Gate Or Entry Restriction</label>
						<label><input type="checkbox" name="longHoseRun" checked={property['Long Hose Run (Y/N)'] === 'Y'} /> Long Hose Run</label>
						<label><input type="checkbox" name="waterSourceFarFromWorkArea" checked={property['Water Source Far From Work Area (Y/N)'] === 'Y'} /> Water Source Far From Work Area</label>

						<label>Access &amp; Setup Notes <textarea name="accessNotes" placeholder="Gate code, parking, spigot location, hose length, roof access route">{accessNotesValue}</textarea></label>
					</details>

					<details class="card" open>
						<summary>Window &amp; Door Inventory</summary>
						<label>
							Window Units
							<span class="field-hint">Approximate number of window assemblies.</span>
							<input type="number" class="field-numeric" name="totalWindowUnits" value={property['Total Window Units']} />
						</label>
						<label>
							Total Glass Panes
							<span class="field-hint">Total number of individual glass panes.</span>
							<input type="number" class="field-numeric" id="totalPanes" name="totalGlassPanes" value={property['Total Glass Panes']} />
						</label>
						<span class="field-hint">
							Window units and panes measure different things and are kept separate — neither is calculated from the other.
							A specific visit records its own counts on the walkthrough; these are the property's standing reference numbers.
						</span>

						<p class="field-label">Accessories</p>
						<div class="count-grid">
							<label>Screens <input type="number" class="field-numeric" name="screenCount" value={property['Screen Count']} /></label>
							<label>Tracks <input type="number" class="field-numeric" name="trackCount" value={property['Track Count']} /></label>
						</div>

						<p class="field-hint" style="margin-top: 1rem;">
							Inventory last verified: {property['Inventory Verified At'] ? new Date(property['Inventory Verified At']).toLocaleDateString() : 'Not verified'}
							{' · '}
							<button type="submit" name="markInventoryVerified" value="1" class="pipeline-card-add-property">Mark Inventory Verified</button>
						</p>
					</details>

					<details class="card">
						<summary>Property Notes</summary>
						<label>
							Repeat business status
							<span class="field-hint">Flags a second property/add-on request from this existing Client — not a new sales pipeline. Leave blank when there's no active repeat-business request.</span>
							<select name="repeatBusinessStatus">
								<option value="" selected={!property['Repeat Business Status']} />
								{REPEAT_BUSINESS_STATUS_OPTIONS.map((v) => <option value={v} selected={v === property['Repeat Business Status']}>{v}</option>)}
							</select>
						</label>
						<label>Pet notes <textarea name="petNotes">{property['Pet Notes']}</textarea></label>
						<label>Property Notes <textarea name="generalNotes">{property['General Notes']}</textarea></label>
					</details>

					<button type="submit">Save</button>
				</form>
						</section>
					)}
				</div>
			</div>
		</div>
	</main>
</BaseLayout>
