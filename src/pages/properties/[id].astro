											<label>Window units<input type="number" min="0" name="totalWindowUnits" value={property['Total Window Units']} /></label>
											<label>Glass panes<input type="number" min="0" name="totalGlassPanes" value={property['Total Glass Panes']} /></label>
											<label>Screens<input type="number" min="0" name="screenCount" value={property['Screen Count']} /></label>
											<label>Tracks<input type="number" min="0" name="trackCount" value={property['Track Count']} /></label>
										</div>
										<div class="button-row">
											<button type="submit">Save</button>
											<a class="plink" href={tabHref('inventory')}>Cancel</a>
										</div>
									</form>
								) : (
									<div class="pmetrics">
										<div class="pmetric"><strong>{grouped(property['Total Window Units']) || '—'}</strong><span>Window units</span></div>
										<div class="pmetric"><strong>{grouped(property['Total Glass Panes']) || '—'}</strong><span>Glass panes</span></div>
										<div class="pmetric"><strong>{grouped(property['Screen Count']) || '—'}</strong><span>Screens</span></div>
										<div class="pmetric"><strong>{grouped(property['Track Count']) || '—'}</strong><span>Tracks</span></div>
									</div>
