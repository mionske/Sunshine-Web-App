---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { createRow, findById, listActiveRows, logActivity, updateRow } from '../../lib/sheets';
import { readRows } from '../../lib/sheets/rows';
import { deleteProperty, restoreProperty, duplicateProperty } from '../../lib/properties';
import {
	propertyConfig,
	PROPERTY_TYPES,
	ACCESS_LEVEL_OPTIONS,
	WATER_ACCESS_OPTIONS,
	WATER_SUPPLY_OPTIONS,
	EXTERIOR_CLEANING_METHOD_OPTIONS,
	LADDER_REQUIREMENT_OPTIONS,
	PARKING_AND_SETUP_OPTIONS,
	REPEAT_BUSINESS_STATUS_OPTIONS,
	derivePropertyCompatDefaults,
} from '../../lib/models/property';
import { clientConfig, type Client } from '../../lib/models/client';
import { walkthroughConfig } from '../../lib/models/walkthrough';
import { quoteConfig } from '../../lib/models/quote';
import { jobConfig, type Job } from '../../lib/models/job';
import { pipelineConfig, OPEN_PIPELINE_STAGES, type Opportunity } from '../../lib/models/pipeline';
import { getActivePricingConfig } from '../../lib/pricing/config';
import { computeJobPerformance, computePropertyPerformance } from '../../lib/pricing/calibration';
import { googleMapsUrl, fullAddress } from '../../lib/mapsLink';
import { formatTimestamp } from '../../lib/format';
import { listPropertyPhotos } from '../../lib/propertyPhotos';
import { PHOTO_CATEGORIES } from '../../lib/models/propertyPhoto';
import {
	PROPERTY_TABS,
	FALLBACK_EDIT_TAB,
	resolvePropertyView,
	type PropertyTabKey,
} from '../../lib/propertyTabs';
import PropertyPhotos from '../../components/PropertyPhotos';

const { id } = Astro.params;
let error: string | null = null;

// Marks a Walkthrough created by the one-time legacy-condition migration
// action below — lets the notice/action detect it already ran for this
// property, without a dedicated schema flag.
const LEGACY_MIGRATION_NOTES_PREFIX = 'Migrated from legacy Property condition data';

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = String(form.get('_action') ?? '');
	try {
		// Checked first and independent of `_action`: the Mark Inventory
		// Verified button lives inside the same <form> as every other field
		// (forms can't nest), so a click submits both this and the hidden
		// `_action=update-property` input — this field's presence, not
		// `_action`, decides which branch runs.
		if (form.get('markInventoryVerified')) {
			await updateRow(env, propertyConfig, id!, {
				'Inventory Verified At': new Date().toISOString(),
				'Inventory Verified By': String(form.get('verifiedBy') ?? '').trim(),
			});
		} else if (action.startsWith('save-')) {
			// Per-group save. updateRow merges the patch over the stored row, so
			// a group only ever writes its own fields — the rest of the property
			// is untouched, which is the whole point of editing one card at a
			// time rather than submitting the entire record.
			const y = (name: string) => (form.get(name) === 'on' ? 'Y' : 'N');
			const s = (name: string) => String(form.get(name) ?? '');

			const GROUP_PATCHES: Record<string, () => Record<string, string>> = {
				'save-record': () => ({
					'Property Type': s('propertyType'),
					'Street Address': s('streetAddress'),
					City: s('city'),
					State: s('state'),
					Zip: s('zip'),
					'Square Footage': s('squareFootage'),
					Stories: s('stories'),
					'Year Built': s('yearBuilt'),
					'Building/Complex Name': s('buildingComplexName'),
					'Unit Identifier': s('unitIdentifier'),
				}),
				'save-access': () => ({
					'Interior Access Difficulty': s('interiorAccessDifficulty'),
					'Exterior Access Difficulty': s('exteriorAccessDifficulty'),
					'Exterior Cleaning Method': s('exteriorCleaningMethod'),
					'Ladder Requirement': s('highestLadderRequired'),
				}),
				'save-considerations': () => ({
					'Roof Access Required (Y/N)': y('roofAccessRequired'),
					'High Interior Glass (Y/N)': y('highInteriorGlass'),
					'Steep Or Uneven Terrain (Y/N)': y('steepOrUnevenTerrain'),
					'Restricted Work Or Setup Area (Y/N)': y('restrictedWorkOrSetupArea'),
					'Long Hose Run (Y/N)': y('longHoseRun'),
					'Gate Or Entry Restriction (Y/N)': y('gateOrEntryRestriction'),
					'Water Source Far From Work Area (Y/N)': y('waterSourceFarFromWorkArea'),
				}),
				'save-water': () => ({
					'Water Access Method': s('waterAccessMethod'),
					'Water Supply': s('waterSupply'),
				}),
				'save-parking': () => ({ 'Parking And Setup Difficulty': s('parkingAndSetupDifficulty') }),
				// Writes the merged value, which is what has been displayed since
				// 'Site Access Notes' was deprecated — saving here is what finally
				// commits that merge to the surviving column.
				'save-access-notes': () => ({ 'Access Notes': s('accessNotes') }),
				'save-inventory': () => ({
					'Total Window Units': s('totalWindowUnits'),
					'Total Glass Panes': s('totalGlassPanes'),
					'Screen Count': s('screenCount'),
					'Track Count': s('trackCount'),
				}),
				'save-notes': () => ({
					'Repeat Business Status': s('repeatBusinessStatus'),
					'Pet Notes': s('petNotes'),
					'General Notes': s('generalNotes'),
				}),
			};

			const patch = GROUP_PATCHES[action];
			if (!patch) throw new Error(`Unknown save action "${action}".`);
			await updateRow(env, propertyConfig, id!, patch() as never, { action });
			return Astro.redirect(`/properties/${id}${form.get('returnTab') ? `?tab=${form.get('returnTab')}` : ''}`);
		} else if (action === 'update-property') {
			await updateRow(env, propertyConfig, id!, {
				'Property Type': String(form.get('propertyType') ?? '') as (typeof PROPERTY_TYPES)[number],
				'Street Address': String(form.get('streetAddress') ?? ''),
				City: String(form.get('city') ?? ''),
				State: String(form.get('state') ?? ''),
				Zip: String(form.get('zip') ?? ''),
				'Year Built': String(form.get('yearBuilt') ?? ''),
				'Square Footage': String(form.get('squareFootage') ?? ''),
				Stories: String(form.get('stories') ?? ''),
				'Interior Access Difficulty': String(form.get('interiorAccessDifficulty') ?? ''),
				'Exterior Access Difficulty': String(form.get('exteriorAccessDifficulty') ?? ''),
				'Roof Access Required (Y/N)': form.get('roofAccessRequired') === 'on' ? 'Y' : 'N',
				'High Interior Glass (Y/N)': form.get('highInteriorGlass') === 'on' ? 'Y' : 'N',
				'Steep Or Uneven Terrain (Y/N)': form.get('steepOrUnevenTerrain') === 'on' ? 'Y' : 'N',
				'Restricted Work Or Setup Area (Y/N)': form.get('restrictedWorkOrSetupArea') === 'on' ? 'Y' : 'N',
				'Water Access Method': String(form.get('waterAccessMethod') ?? ''),
				'Water Supply': String(form.get('waterSupply') ?? ''),
				'Exterior Cleaning Method': String(form.get('exteriorCleaningMethod') ?? ''),
				'Parking And Setup Difficulty': String(form.get('parkingAndSetupDifficulty') ?? ''),
				'Gate Or Entry Restriction (Y/N)': form.get('gateOrEntryRestriction') === 'on' ? 'Y' : 'N',
				'Long Hose Run (Y/N)': form.get('longHoseRun') === 'on' ? 'Y' : 'N',
				'Water Source Far From Work Area (Y/N)': form.get('waterSourceFarFromWorkArea') === 'on' ? 'Y' : 'N',
				'Access Notes': String(form.get('accessNotes') ?? ''),
				'Ladder Requirement': String(form.get('highestLadderRequired') ?? ''),
				'Total Window Units': String(form.get('totalWindowUnits') ?? ''),
				'Total Glass Panes': String(form.get('totalGlassPanes') ?? ''),
				// The per-window-style counts (Count - Double Hung/Casement/
				// Picture/Sliding/French/Awning/Skylights/Solar Panels/Standard,
				// Sliding Glass Door Pane Count) are deliberately no longer
				// written. Identifying every window type in a house was field
				// busywork that nothing downstream ever read — pricing,
				// calibration and reporting all work from window units and
				// panes. The columns stay declared so existing values still
				// round-trip; they are simply never updated again.
				'Screen Count': String(form.get('screenCount') ?? ''),
				'Track Count': String(form.get('trackCount') ?? ''),
				'Repeat Business Status': String(form.get('repeatBusinessStatus') ?? ''),
				'Pet Notes': String(form.get('petNotes') ?? ''),
				'General Notes': String(form.get('generalNotes') ?? ''),
				'Building/Complex Name': String(form.get('buildingComplexName') ?? ''),
				'Unit Identifier': String(form.get('unitIdentifier') ?? ''),
			});

			// Data-ownership separation: copy-on-read-then-write-once migration
			// for the two customer-preference fields that moved to Client — only
			// fills a blank Client field, never overwrites an existing one, and
			// only runs alongside a real Save rather than on every page view.
			const savedProperty = await findById(env, propertyConfig, id!);
			if (savedProperty?.['Client ID']) {
				const linkedClient = await findById(env, clientConfig, savedProperty['Client ID']);
				if (linkedClient) {
					const clientPatch: Partial<Client> = {};
					if (!linkedClient['Desired Maintenance Frequency'] && savedProperty['Desired Maintenance Frequency']) {
						clientPatch['Desired Maintenance Frequency'] = savedProperty['Desired Maintenance Frequency'];
					}
					if (!linkedClient['Preferred Service Season'] && savedProperty['Preferred Service Season']) {
						clientPatch['Preferred Service Season'] = savedProperty['Preferred Service Season'];
					}
					if (Object.keys(clientPatch).length > 0) {
						await updateRow(env, clientConfig, linkedClient['Client ID'], clientPatch);
					}
				}
			}
		} else if (action === 'migrate-legacy-condition') {
			const legacyProperty = await findById(env, propertyConfig, id!);
			if (legacyProperty) {
				await createRow(env, walkthroughConfig, {
					'Client ID': legacyProperty['Client ID'],
					'Property ID': id!,
					'Walkthrough Date': legacyProperty['Updated At']?.slice(0, 10) ?? '',
					Status: 'Completed',
					'Story Count Observed': legacyProperty.Stories,
					'Exterior Condition': legacyProperty['Window Condition'],
					'Hard Water Present (Y/N)': legacyProperty['Hard Water History (Y/N)'],
					'Construction Debris Present (Y/N)': legacyProperty['Construction Debris (Y/N)'],
					'Silicone Adhesive Or Sticker Residue (Y/N)': legacyProperty['Silicone Adhesive Or Sticker Residue (Y/N)'],
					'Heavy Interior Residue (Y/N)': legacyProperty['Heavy Interior Residue (Y/N)'],
					'Oxidized Frames Or Screens (Y/N)': legacyProperty['Oxidized Frames Or Screens (Y/N)'],
					'Condition Varies By Area (Y/N)': legacyProperty['Condition Varies By Area (Y/N)'],
					'Condition Notes': legacyProperty['Condition Notes'],
					'Exterior Access Obstructed (Y/N)': legacyProperty['Exterior Access Obstructed (Y/N)'],
					'Furniture Or Belongings Movement Required (Y/N)': legacyProperty['Furniture Or Belongings Movement Required (Y/N)'],
					Notes: `${LEGACY_MIGRATION_NOTES_PREFIX} — exact observation date unknown (property last updated ${legacyProperty['Updated At']}).`,
				});
			}
		} else if (action === 'add-note') {
			const note = String(form.get('note') ?? '').trim();
			if (note) {
				await logActivity(env, { entityType: 'Property', entityId: id!, action: 'Note added', notes: note });
			}
		} else if (action === 'duplicate-property') {
			const duplicate = await duplicateProperty(env, id!);
			return Astro.redirect(`/properties/${duplicate['Property ID']}`);
		} else if (action === 'delete-property') {
			await deleteProperty(env, id!);
			return Astro.redirect('/properties');
		} else if (action === 'restore-property') {
			await restoreProperty(env, id!);
		}
		return Astro.redirect(`/properties/${id}`);
	} catch (e) {
		error = (e as Error).message;
	}
}

const property = await findById(env, propertyConfig, id!);
if (!property) {
	return new Response('Property not found', { status: 404 });
}

const client = property['Client ID'] ? await findById(env, clientConfig, property['Client ID']) : null;

// One-time compatibility defaults for the enum fields renamed/split during
// past redesigns — see derivePropertyCompatDefaults in lib/models/property.ts
// (shared with the Quoter's read-only property summary). None of these
// ever write to Sheets; the raw legacy value stays exactly as stored until
// the owner actually saves this property. accessNotesValue additionally
// merges the deprecated 'Site Access Notes' into 'Access Notes' for display.
const { exteriorCleaningMethodValue, ladderRequirementValue, waterAccessValue, waterSupplyValue, parkingAndSetupValue, accessNotesValue } =
	derivePropertyCompatDefaults(property);

const [allQuotes, allJobs, allOpportunities, allWalkthroughs, pricingConfig, activityRows] = await Promise.all([
	listActiveRows(env, quoteConfig),
	listActiveRows(env, jobConfig),
	listActiveRows(env, pipelineConfig),
	listActiveRows(env, walkthroughConfig),
	property['Property Type'] ? getActivePricingConfig(env, property['Property Type']) : Promise.resolve(null),
	readRows(env, 'ActivityLog', { idColumn: 'Activity ID' }),
]);
const propertyWalkthroughs = allWalkthroughs.filter((w) => w['Property ID'] === id);

const streetAddress = property['Street Address'].toLowerCase();
const propertyQuotes = allQuotes.filter((q) => q['Property ID'] === id);
const propertyOpportunities = allOpportunities.filter((o) => o['Property ID'] === id);
// Matched primarily by Property ID; falls back to address-substring matching
// for jobs that predate that column.
const propertyJobs: Job[] = allJobs.filter((j) =>
	j['Property ID'] ? j['Property ID'] === id : j['Property Address'].toLowerCase().includes(streetAddress)
);

const OPEN_OPPORTUNITY_STAGES = new Set<string>(OPEN_PIPELINE_STAGES);
const ACTIVE_JOB_STATUSES = new Set(['Scheduled', 'In Progress']);
const COMPLETED_JOB_STATUSES = new Set(['Completed', 'Invoiced', 'Paid']);

function derivePropertyStatus(opportunities: Opportunity[], jobs: Job[]): string {
	if (property!['Archived At']) return 'Archived';
	if (jobs.some((j) => COMPLETED_JOB_STATUSES.has(j['Job Status']))) return 'Established Client';
	if (jobs.some((j) => ACTIVE_JOB_STATUSES.has(j['Job Status']))) return 'Active — Job Scheduled';
	if (opportunities.some((o) => OPEN_OPPORTUNITY_STAGES.has(o.Stage))) return 'Prospect';
	return 'New';
}
const propertyStatus = derivePropertyStatus(propertyOpportunities, propertyJobs);

const targetHourlyRate = Number(pricingConfig?.['Target Hourly Rate'] ?? 0);
const jobRows = propertyJobs.map((job) => ({ job, perf: computeJobPerformance(job, targetHourlyRate) }));
const performance = computePropertyPerformance(propertyJobs);

const propertyPhotos = await listPropertyPhotos(env, id!);
const propertyPhotoDtos = propertyPhotos.map((p) => ({
	id: p['Photo ID'],
	filename: p['Original Filename'],
	contentType: p['Content Type'],
	sizeBytes: p['Size Bytes'],
	caption: p.Caption,
	category: p.Category,
	createdAt: p['Created At'],
}));

// Data-ownership separation: "Next Service" is now derived from real Job
// data instead of a manually-typed Property field — the earliest future
// Scheduled Date among this property's Scheduled jobs, falling back to the
// most recent completed job's already-computed Next Maintenance Follow-up
// Date (see jobLifecycle.ts), never a plain editable field again.
const today = new Date().toISOString().slice(0, 10);
const upcomingScheduledJobs = propertyJobs
	.filter((j) => j['Job Status'] === 'Scheduled' && j['Scheduled Date'] && j['Scheduled Date'] >= today)
	.sort((a, b) => a['Scheduled Date'].localeCompare(b['Scheduled Date']));
const mostRecentCompletedJob = propertyJobs
	.filter((j) => COMPLETED_JOB_STATUSES.has(j['Job Status']) && j['Date Completed'])
	.sort((a, b) => b['Date Completed'].localeCompare(a['Date Completed']))[0];
const nextServiceLabel = upcomingScheduledJobs[0]
	? `Next visit: ${upcomingScheduledJobs[0]['Scheduled Date']}`
	: mostRecentCompletedJob?.['Next Maintenance Follow-up Date']
		? `Next recommended: ${mostRecentCompletedJob['Next Maintenance Follow-up Date']}`
		: 'Not scheduled';

// Data-ownership separation: one-time notice offering to preserve legacy
// Glass Condition / temporary-access data (now deprecated on Property) as a
// real historical Walkthrough, rather than silently discarding it or
// silently pretending it describes today. Never shown again once that
// migration Walkthrough exists for this property.
const hasLegacyConditionData = Boolean(
	property['Window Condition'] ||
		property['Hard Water History (Y/N)'] === 'Y' ||
		property['Construction Debris (Y/N)'] === 'Y' ||
		property['Silicone Adhesive Or Sticker Residue (Y/N)'] === 'Y' ||
		property['Heavy Interior Residue (Y/N)'] === 'Y' ||
		property['Oxidized Frames Or Screens (Y/N)'] === 'Y' ||
		property['Condition Varies By Area (Y/N)'] === 'Y' ||
		property['Condition Notes'] ||
		property['Exterior Access Obstructed (Y/N)'] === 'Y' ||
		property['Furniture Or Belongings Movement Required (Y/N)'] === 'Y'
);
const legacyConditionAlreadyMigrated = propertyWalkthroughs.some((w) => w.Notes.startsWith(LEGACY_MIGRATION_NOTES_PREFIX));
const showLegacyMigrationNotice = hasLegacyConditionData && !legacyConditionAlreadyMigrated;

// Timeline: every ActivityLog entry whose Entity ID belongs to this
// property — directly, or via its client/quotes/jobs/opportunities.
const relevantIds = new Set<string>([
	id!,
	...(client ? [client['Client ID']] : []),
	...propertyQuotes.map((q) => q['Quote ID']),
	...propertyJobs.map((j) => j['Job ID']),
	...propertyOpportunities.map((o) => o['Opportunity ID']),
	...propertyWalkthroughs.map((w) => w['Walkthrough ID']),
]);
const quoteIdByJobId = Object.fromEntries(propertyJobs.map((j) => [j['Job ID'], j['Quote ID']]));

function timelineLink(entityType: string, entityId: string): string | null {
	if (entityType === 'Quote') return `/quotes/${entityId}`;
	if (entityType === 'Job') return quoteIdByJobId[entityId] ? `/quotes/${quoteIdByJobId[entityId]}` : null;
	if (entityType === 'Client') return `/clients/${entityId}`;
	if (entityType === 'Walkthrough') return `/walkthroughs/${entityId}`;
	if (entityType === 'Opportunity') return '/pipeline';
	if (entityType === 'PricingConfig') return '/pricing-config';
	if (entityType === 'CalibrationSnapshot') return '/calibration';
	return null;
}

const timeline = activityRows
	.map((r) => r.data)
	.filter((entry) => relevantIds.has(String(entry['Entity ID'] ?? '')))
	.sort((a, b) => String(b.Timestamp ?? '').localeCompare(String(a.Timestamp ?? '')));

// --- Option 1B workspace ---------------------------------------------------

// Tab and edit-group state live in the URL so they survive a reload, a Save
// redirect and a shared link. Resolution is in lib/propertyTabs.ts so it can
// be tested — see propertyTabs.test.ts.
const TABS = PROPERTY_TABS;
type TabKey = PropertyTabKey;
const { tab: activeTab, editingGroup } = resolvePropertyView(Astro.url.searchParams);

function tabHref(tab: TabKey | typeof FALLBACK_EDIT_TAB): string {
	return tab === 'overview' ? `/properties/${id}` : `/properties/${id}?tab=${tab}`;
}
function editHref(tab: TabKey, group: string): string {
	return `/properties/${id}?tab=${tab}&edit=${group}`;
}

const yes = (value: string) => value === 'Y';

/** The seven permanent setup considerations. Only true ones are shown as
 * chips; the rest are summarised in one muted line, because seven unchecked
 * boxes at rest tell you nothing you didn't already assume. */
const CONSIDERATION_FLAGS = [
	{ label: 'Roof access required', on: yes(property['Roof Access Required (Y/N)']) },
	{ label: 'High interior glass', on: yes(property['High Interior Glass (Y/N)']) },
	{ label: 'Steep terrain', on: yes(property['Steep Or Uneven Terrain (Y/N)']) },
	{ label: 'Restricted setup', on: yes(property['Restricted Work Or Setup Area (Y/N)']) },
	{ label: 'Long hose run', on: yes(property['Long Hose Run (Y/N)']) },
	{ label: 'Gate restriction', on: yes(property['Gate Or Entry Restriction (Y/N)']) },
	{ label: 'Limited water access', on: yes(property['Water Source Far From Work Area (Y/N)']) },
];
const trueFlags = CONSIDERATION_FLAGS.filter((f) => f.on);
const falseFlagLabels = CONSIDERATION_FLAGS.filter((f) => !f.on).map((f) => f.label.toLowerCase());

/** Permanent property difficulty — not this visit's condition, which lives
 * on the walkthrough. */
const interiorAccess = property['Interior Access Difficulty'];
const exteriorAccess = property['Exterior Access Difficulty'];
const difficultySummary =
	exteriorAccess === 'Difficult'
		? 'Hard exterior'
		: interiorAccess === 'Difficult'
			? 'Hard interior'
			: trueFlags.length >= 3
				? 'Complex access'
				: 'Straightforward';
const difficultyIsHard = difficultySummary !== 'Straightforward';

function difficultyFill(value: string): number {
	if (value === 'Difficult') return 100;
	if (value === 'Standard') return 62;
	if (value === 'Easy') return 28;
	return 0;
}

const DIFFICULTY_BARS = [
	{ label: 'Exterior', value: exteriorAccess },
	{ label: 'Interior', value: interiorAccess },
	{ label: 'Parking', value: parkingAndSetupValue === 'Limited' ? 'Standard' : parkingAndSetupValue === 'Difficult' ? 'Difficult' : parkingAndSetupValue === 'Easy' ? 'Easy' : '' },
];

const difficultyFooter = [ladderRequirementValue, exteriorCleaningMethodValue ? `${exteriorCleaningMethodValue.toLowerCase()} method` : '', yes(property['Roof Access Required (Y/N)']) ? 'roof access' : '']
	.filter(Boolean)
	.join(' · ');

/** Four-stage stepper. Each is "done" if the record it represents exists —
 * derived from real rows, never a stored stage field. */
const PIPELINE_STEPS = [
	{ label: 'Prospect', done: true },
	{ label: 'Walkthrough', done: propertyWalkthroughs.length > 0 },
	{ label: 'Quoted', done: propertyQuotes.length > 0 },
	{ label: 'Won', done: propertyJobs.length > 0 },
];
const currentStepIndex = PIPELINE_STEPS.reduce((last, step, i) => (step.done ? i : last), 0);

const latestWalkthrough = [...propertyWalkthroughs].sort((a, b) =>
	(b['Walkthrough Date'] || b['Created At']).localeCompare(a['Walkthrough Date'] || a['Created At'])
)[0];

function pipelineStatusLine(): string {
	if (upcomingScheduledJobs[0]) return `Job scheduled ${upcomingScheduledJobs[0]['Scheduled Date']}.`;
	if (mostRecentCompletedJob) {
		return `Last completed ${mostRecentCompletedJob['Date Completed']}. ${nextServiceLabel === 'Not scheduled' ? 'Next service not scheduled.' : nextServiceLabel + '.'}`;
	}
	if (propertyQuotes.length > 0) {
		const sent = propertyQuotes.find((q) => q['Quote Status'] === 'Sent');
		if (sent) return `Quote sent ${(sent['Sent At'] || '').slice(0, 10)}. Awaiting customer response.`;
		return `${propertyQuotes.length} quote${propertyQuotes.length === 1 ? '' : 's'} on file. No job scheduled yet.`;
	}
	if (latestWalkthrough) return `Walkthrough ${latestWalkthrough.Status.toLowerCase()} ${latestWalkthrough['Walkthrough Date']}. Quote not yet created.`;
	return 'No walkthrough, quote, or job yet. Next service not scheduled.';
}

const inventoryVerifiedAt = property['Inventory Verified At'];
const inventoryVerifiedBy = property['Inventory Verified By'];
const scaleFooter = [
	inventoryVerifiedAt ? `Verified ${formatTimestamp(inventoryVerifiedAt)}${inventoryVerifiedBy ? ` by ${inventoryVerifiedBy}` : ''}` : 'Never verified',
	Number(property['Track Count'] || 0) > 0 ? null : 'tracks not counted',
]
	.filter(Boolean)
	.join(' · ');

/** Fields worth chasing. An empty one that matters reads "Missing"; a
 * genuinely optional one gets an em dash. */
/** Thousands separators on the numbers big enough to need them. A square
 * footage reads as a quantity at a glance with them and as a serial number
 * without. */
function grouped(value: string): string {
	const n = Number(value);
	return value && Number.isFinite(n) ? n.toLocaleString('en-US') : value;
}

const RECORD_ROWS = [
	{ label: 'Square footage', value: grouped(property['Square Footage']), important: false },
	{ label: 'Stories', value: property.Stories, important: true },
	{ label: 'Year built', value: property['Year Built'], important: true },
	{ label: 'Unit / building', value: [property['Building/Complex Name'], property['Unit Identifier']].filter(Boolean).join(' — '), important: false },
];

// `what` is what the number MEANS, so a screen reader says "Access & Setup,
// 2 flagged" rather than running the label into the digit — "Access & Setup2".
const railBadges: Record<TabKey, { text: string; what: string; alert?: boolean } | null> = {
	overview: null,
	access: trueFlags.length > 0 ? { text: String(trueFlags.length), what: 'flagged', alert: true } : null,
	inventory: property['Total Window Units'] ? { text: property['Total Window Units'], what: 'window units' } : null,
	photos: propertyPhotoDtos.length > 0 ? { text: String(propertyPhotoDtos.length), what: 'photos' } : null,
	notes: null,
	walkthroughs: propertyWalkthroughs.length > 0 ? { text: String(propertyWalkthroughs.length), what: 'walkthroughs' } : null,
	quotes: propertyQuotes.length > 0 ? { text: String(propertyQuotes.length), what: 'quotes' } : null,
	jobs: propertyJobs.length > 0 ? { text: String(propertyJobs.length), what: 'jobs' } : null,
	history: timeline.length > 0 ? { text: String(timeline.length), what: 'entries' } : null,
};

// One filter, in the URL like the tab — the timeline is long enough on a
// real property that "show me just the quotes" is a normal thing to want.
const TIMELINE_TYPES = ['', ...Array.from(new Set(timeline.map((e) => String(e['Entity Type'] ?? '')).filter(Boolean))).sort()];
const timelineType = Astro.url.searchParams.get('type') ?? '';
const visibleTimeline = timelineType ? timeline.filter((e) => String(e['Entity Type'] ?? '') === timelineType) : timeline;

const identityMeta = [property['Property Type'], property.Stories ? `${property.Stories} ${property.Stories === '1' ? 'story' : 'stories'}` : '']
	.filter(Boolean)
	.join(' · ');

---
<BaseLayout title={property['Unit Identifier'] ? `${property['Street Address']} — Unit ${property['Unit Identifier']}` : property['Street Address']}>
	<main class="property-workspace">
		<div class="property-frame">
			<!-- Identity bar. The address is plain heading text, not a link to
			     the page you're already on, and not rust — rust is reserved for
			     things you can act on. -->
			<div class="property-identity">
				<div class="property-identity-left">
					<div class="property-identity-heading">
						<h1>{property['Street Address']}{property.City ? `, ${property.City}` : ''}{property['Unit Identifier'] ? ` — Unit ${property['Unit Identifier']}` : ''}</h1>
						<span class="property-status-pill">{propertyStatus}</span>
						{property['Repeat Business Status'] && <span class="property-status-pill">{property['Repeat Business Status']}</span>}
					</div>
					<p class="property-identity-meta">
						{identityMeta}
						{client && (
							<>
								{identityMeta ? ' · ' : ''}
								<a class="plink" href={`/clients/${client['Client ID']}`}>{client['First Name']} {client['Last Name']}</a>
							</>
						)}
					</p>
				</div>
				<div class="property-identity-actions">
					<a class="btn btn-primary" href={`/walkthroughs/new?propertyId=${id}`}>Start walkthrough</a>
					<a class="btn" href={`/quoter?propertyId=${id}`}>Create quote</a>
					<a class="btn" href={tabHref('edit')}>Edit</a>
					<details class="property-overflow">
						<summary>⋯</summary>
						<div>
							{/* Shown only below 900px, where the identity bar drops
							    these two to keep itself on one row. */}
							<a class="overflow-only" href={`/quoter?propertyId=${id}`}>Create quote</a>
							<a class="overflow-only" href={tabHref('edit')}>Edit property</a>
							<a href={googleMapsUrl(fullAddress(property))} target="_blank" rel="noopener noreferrer">Open in Maps</a>
							<a href={`/historical-entry?propertyId=${id}`}>Add historical record</a>
							{client && <a href={`/clients/${client['Client ID']}?edit=1`}>Edit client</a>}
							<form method="POST" onsubmit="return confirm('Duplicate this property?')">
								<input type="hidden" name="_action" value="duplicate-property" />
								<button type="submit">Duplicate property</button>
							</form>
							{property['Archived At'] ? (
								<form method="POST" onsubmit="return confirm('Restore this property? It will reappear everywhere in the app.')">
									<input type="hidden" name="_action" value="restore-property" />
									<button type="submit">Restore property</button>
								</form>
							) : (
								<form method="POST" onsubmit="return confirm('Delete this property? It is archived, not destroyed, and can be restored.')">
									<input type="hidden" name="_action" value="delete-property" />
									<button type="submit">Delete property</button>
								</form>
							)}
						</div>
					</details>
				</div>
			</div>

			<div class="property-shell">
				<nav class="property-rail" aria-label="Property sections">
					{TABS.map((tab, index) => (
						<>
							{index === 5 && <div class="property-rail-divider"></div>}
							<a
								href={tabHref(tab.key)}
								aria-current={activeTab === tab.key ? 'page' : undefined}
								aria-label={railBadges[tab.key] ? `${tab.label}, ${railBadges[tab.key]!.text} ${railBadges[tab.key]!.what}` : undefined}
							>
								<span>{tab.label}</span>
								{railBadges[tab.key] && (
									<span class={railBadges[tab.key]!.alert ? 'property-rail-badge-alert' : 'property-rail-badge'}>
										{railBadges[tab.key]!.text}
									</span>
								)}
							</a>
						</>
					))}
				</nav>

				<div class="property-panel">
					{error && <p role="alert">{error}</p>}
					{property['Archived At'] && (
						<div class="pcard"><p style="margin:0">This property is archived. Restore it from the ⋯ menu to bring it back into every list.</p></div>
					)}
					{showLegacyMigrationNotice && (
						<form method="POST" class="pcard">
							<input type="hidden" name="_action" value="migrate-legacy-condition" />
							<p>Legacy condition information exists on this property. Copy it into a historical walkthrough so it stays attached to a date rather than to the property record?</p>
							<button type="submit">Create historical walkthrough</button>
						</form>
					)}

					{activeTab === 'overview' && (
						<>
							<div class="pcard-row pcard-row-2">
								<section class="pcard">
									<div class="pcard-header"><h2>Scale of work</h2></div>
									<div class="pmetrics">
										<div class="pmetric"><strong>{grouped(property['Total Window Units']) || '—'}</strong><span>Window units</span></div>
										<div class="pmetric"><strong>{grouped(property['Total Glass Panes']) || '—'}</strong><span>Glass panes</span></div>
										<div class="pmetric"><strong>{grouped(property['Screen Count']) || '—'}</strong><span>Screens</span></div>
										<div class="pmetric"><strong>{grouped(property['Track Count']) || '—'}</strong><span>Tracks</span></div>
									</div>
									<div class="pcard-footer">
										<span class={inventoryVerifiedAt ? 'pdot pdot-ok' : 'pdot'}></span>
										<span>{scaleFooter}</span>
										<a class="plink" href={tabHref('inventory')}>verify</a>
									</div>
								</section>

								<section class="pcard">
									<div class="pcard-header"><h2>Difficulty</h2></div>
									<p class={difficultyIsHard ? 'pdifficulty-headline pdifficulty-hard' : 'pdifficulty-headline'}>{difficultySummary}</p>
									{DIFFICULTY_BARS.map((bar) => (
										<div class="pbar-row">
											<span>{bar.label}</span>
											<span class={bar.value === 'Difficult' ? 'pbar pbar-hard' : 'pbar'}>
												<span style={`width:${difficultyFill(bar.value)}%`}></span>
											</span>
											<span>{bar.value || 'Not set'}</span>
										</div>
									))}
									{difficultyFooter && <div class="pcard-footer"><span>{difficultyFooter}</span></div>}
								</section>
							</div>

							<section class="pcard porder-first">
								<div class="pcard-header">
									<h2>Before the truck leaves</h2>
									<a class="plink" href={tabHref('access')}>Access &amp; setup →</a>
								</div>
								<div class="pinset-grid">
									<div class="pinset"><span>Ladder</span><strong>{ladderRequirementValue || '—'}</strong></div>
									<div class="pinset"><span>Water</span><strong>{waterAccessValue || '—'}</strong></div>
									<div class="pinset"><span>Supply</span><strong>{waterSupplyValue || '—'}</strong></div>
									<div class="pinset"><span>Gate / hose</span><strong>{yes(property['Gate Or Entry Restriction (Y/N)']) ? 'Gate restriction' : yes(property['Long Hose Run (Y/N)']) ? 'Long hose run' : 'No restriction'}</strong></div>
								</div>
								{trueFlags.length > 0 && (
									<div class="pflags">{trueFlags.map((f) => <span class="pflag">{f.label}</span>)}</div>
								)}
								{falseFlagLabels.length > 0 && (
									<p class="pflags-none">{falseFlagLabels.join(', ')}: not flagged</p>
								)}
								<p class="pcallout">
									{accessNotesValue || (
										<>Access &amp; setup notes empty — <a class="plink" href={editHref('access', 'access-notes')}>add gate code, parking, spigot location, roof route</a></>
									)}
									{accessNotesValue && <> <a class="plink" href={editHref('access', 'access-notes')}>Edit</a></>}
								</p>
							</section>

							<div class="pcard-row pcard-row-2">
								<section class="pcard">
									<div class="pcard-header"><h2>Pipeline</h2></div>
									<div class="pstepper">
										{PIPELINE_STEPS.map((step, i) => (
											<div class={`pstep${i <= currentStepIndex ? ' pstep-done' : ''}${i === currentStepIndex ? ' pstep-current' : ''}`}>
												<span class="pstep-bar"></span>
												<span>{step.label}</span>
											</div>
										))}
									</div>
									<p class="pstatus-line">{pipelineStatusLine()}</p>
									<div class="pactions">
										<a class="pactions-primary" href={`/walkthroughs/new?propertyId=${id}`}>
											{latestWalkthrough && latestWalkthrough.Status === 'Draft' ? 'Continue walkthrough' : 'Start walkthrough'}
										</a>
										<a href={`/historical-entry?propertyId=${id}`}>Add historical record</a>
									</div>
								</section>

								<section class="pcard">
									<div class="pcard-header">
										<h2>Record</h2>
										{editingGroup !== 'record' && <a class="plink" href={editHref('overview', 'record')}>Edit</a>}
