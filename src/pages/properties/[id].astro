								</div>
								{editingGroup === 'considerations' ? (
									<form method="POST">
										<input type="hidden" name="_action" value="save-considerations" />
										<input type="hidden" name="returnTab" value="access" />
										<div class="checkbox-grid">
											<label><input type="checkbox" name="roofAccessRequired" checked={yes(property['Roof Access Required (Y/N)'])} /> Roof access required</label>
											<label><input type="checkbox" name="highInteriorGlass" checked={yes(property['High Interior Glass (Y/N)'])} /> High interior glass</label>
											<label><input type="checkbox" name="steepOrUnevenTerrain" checked={yes(property['Steep Or Uneven Terrain (Y/N)'])} /> Steep terrain</label>
											<label><input type="checkbox" name="restrictedWorkOrSetupArea" checked={yes(property['Restricted Work Or Setup Area (Y/N)'])} /> Restricted setup</label>
											<label><input type="checkbox" name="longHoseRun" checked={yes(property['Long Hose Run (Y/N)'])} /> Long hose run</label>
											<label><input type="checkbox" name="gateOrEntryRestriction" checked={yes(property['Gate Or Entry Restriction (Y/N)'])} /> Gate restriction</label>
											<label><input type="checkbox" name="waterSourceFarFromWorkArea" checked={yes(property['Water Source Far From Work Area (Y/N)'])} /> Limited water access</label>
										</div>
										<div class="button-row">
											<button type="submit">Save</button>
											<a class="plink" href={tabHref('access')}>Cancel</a>
										</div>
									</form>
								) : (
									<>
										{trueFlags.length > 0 ? (
											<div class="pflags">{trueFlags.map((f) => <span class="pflag">{f.label}</span>)}</div>
										) : (
											<p class="pflags-none">Nothing flagged.</p>
										)}
										<p class="pflags-none">
											{trueFlags.length} of {CONSIDERATION_FLAGS.length} flagged
											{falseFlagLabels.length > 0 ? ` — ${falseFlagLabels.join(', ')}: not flagged` : ''}
										</p>
									</>
								)}
							</section>

							<section class="pcard">
								<div class="pcard-header">
									<h2>Water</h2>
									{editingGroup !== 'water' && <a class="plink" href={editHref('access', 'water')}>Edit</a>}
								</div>
								{editingGroup === 'water' ? (
									<form method="POST">
										<input type="hidden" name="_action" value="save-water" />
										<input type="hidden" name="returnTab" value="access" />
										<p class="field-label">Water access</p>
										<div class="segmented">
											{WATER_ACCESS_OPTIONS.map((o) => (
												<label><input type="radio" name="waterAccessMethod" value={o} checked={o === waterAccessValue} />{o}</label>
											))}
										</div>
										<p class="field-label">Water supply</p>
										<div class="segmented">
											{WATER_SUPPLY_OPTIONS.map((o) => (
												<label><input type="radio" name="waterSupply" value={o} checked={o === waterSupplyValue} />{o}</label>
											))}
										</div>
										<div class="button-row">
											<button type="submit">Save</button>
											<a class="plink" href={tabHref('access')}>Cancel</a>
										</div>
									</form>
								) : (
									<div class="prows">
										<div class="prow"><span>Water access</span><span class={waterAccessValue ? '' : 'pmissing'}>{waterAccessValue || 'Missing'}</span></div>
										<div class="prow"><span>Water supply</span><span class={waterSupplyValue ? '' : 'pmissing'}>{waterSupplyValue || 'Missing'}</span></div>
									</div>
								)}
							</section>

							<section class="pcard">
								<div class="pcard-header">
									<h2>Parking &amp; setup</h2>
									{editingGroup !== 'parking' && <a class="plink" href={editHref('access', 'parking')}>Edit</a>}
								</div>
								{editingGroup === 'parking' ? (
									<form method="POST">
										<input type="hidden" name="_action" value="save-parking" />
										<input type="hidden" name="returnTab" value="access" />
										<p class="field-label">Parking difficulty</p>
										<div class="segmented">
											{PARKING_AND_SETUP_OPTIONS.map((o) => (
												<label><input type="radio" name="parkingAndSetupDifficulty" value={o} checked={o === parkingAndSetupValue} />{o}</label>
											))}
										</div>
										<p class="field-hint">
											Gate, hose and water-distance flags live in Considerations above — they are the same seven flags the
											rail counts, so they are edited in one place rather than two.
										</p>
										<div class="button-row">
											<button type="submit">Save</button>
											<a class="plink" href={tabHref('access')}>Cancel</a>
										</div>
									</form>
								) : (
									<div class="prows">
										<div class="prow"><span>Parking difficulty</span><span class={parkingAndSetupValue ? '' : 'pmissing'}>{parkingAndSetupValue || 'Missing'}</span></div>
										<div class="prow"><span>Gate or entry restriction</span><span>{yes(property['Gate Or Entry Restriction (Y/N)']) ? 'Yes' : 'No'}</span></div>
										<div class="prow"><span>Long hose run</span><span>{yes(property['Long Hose Run (Y/N)']) ? 'Yes' : 'No'}</span></div>
										<div class="prow"><span>Water far from work area</span><span>{yes(property['Water Source Far From Work Area (Y/N)']) ? 'Yes' : 'No'}</span></div>
									</div>
								)}
							</section>

							<section class="pcard">
								<div class="pcard-header">
									<h2>Notes</h2>
									{editingGroup !== 'access-notes' && <a class="plink" href={editHref('access', 'access-notes')}>{accessNotesValue ? 'Edit' : 'Add'}</a>}
								</div>
								{editingGroup === 'access-notes' ? (
									<form method="POST">
										<input type="hidden" name="_action" value="save-access-notes" />
										<input type="hidden" name="returnTab" value="access" />
										<label>
											Access &amp; setup notes
											<span class="field-hint">Gate code, parking, spigot location, roof route — whatever you'd want to know before the truck leaves.</span>
											<textarea name="accessNotes">{accessNotesValue}</textarea>
										</label>
										<div class="button-row">
											<button type="submit">Save</button>
											<a class="plink" href={tabHref('access')}>Cancel</a>
										</div>
									</form>
								) : (
									<p class="pcallout">{accessNotesValue || 'No access & setup notes yet.'}</p>
								)}
							</section>
						</>
					)}

					{activeTab === 'inventory' && (
						<>
							<section class="pcard">
								<div class="pcard-header">
									<h2>Standing reference counts</h2>
