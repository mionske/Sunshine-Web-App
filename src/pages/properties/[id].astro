---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { createRow, findById, listActiveRows, logActivity, updateRow } from '../../lib/sheets';
import { readRows } from '../../lib/sheets/rows';
import { deleteProperty, restoreProperty, duplicateProperty } from '../../lib/properties';
import {
	propertyConfig,
	PROPERTY_TYPES,
	ACCESS_LEVEL_OPTIONS,
	WATER_ACCESS_OPTIONS,
	WATER_SUPPLY_OPTIONS,
	EXTERIOR_CLEANING_METHOD_OPTIONS,
	LADDER_REQUIREMENT_OPTIONS,
	PARKING_AND_SETUP_OPTIONS,
	REPEAT_BUSINESS_STATUS_OPTIONS,
	derivePropertyCompatDefaults,
} from '../../lib/models/property';
import { clientConfig, type Client } from '../../lib/models/client';
import { walkthroughConfig } from '../../lib/models/walkthrough';
import { quoteConfig } from '../../lib/models/quote';
import { jobConfig, type Job } from '../../lib/models/job';
import { pipelineConfig, type Opportunity } from '../../lib/models/pipeline';
import { getActivePricingConfig } from '../../lib/pricing/config';
import { computeJobPerformance, computePropertyPerformance } from '../../lib/pricing/calibration';
import { googleMapsUrl, fullAddress } from '../../lib/mapsLink';
import { formatTimestamp } from '../../lib/format';
import { listPropertyPhotos } from '../../lib/propertyPhotos';
import PropertyPhotos from '../../components/PropertyPhotos';

const { id } = Astro.params;
let error: string | null = null;

// Marks a Walkthrough created by the one-time legacy-condition migration
// action below — lets the notice/action detect it already ran for this
// property, without a dedicated schema flag.
const LEGACY_MIGRATION_NOTES_PREFIX = 'Migrated from legacy Property condition data';

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = String(form.get('_action') ?? '');
	try {
		// Checked first and independent of `_action`: the Mark Inventory
		// Verified button lives inside the same <form> as every other field
		// (forms can't nest), so a click submits both this and the hidden
		// `_action=update-property` input — this field's presence, not
		// `_action`, decides which branch runs.
		if (form.get('markInventoryVerified')) {
			await updateRow(env, propertyConfig, id!, { 'Inventory Verified At': new Date().toISOString() });
		} else if (action === 'update-property') {
			await updateRow(env, propertyConfig, id!, {
				'Property Type': String(form.get('propertyType') ?? '') as (typeof PROPERTY_TYPES)[number],
				'Street Address': String(form.get('streetAddress') ?? ''),
				City: String(form.get('city') ?? ''),
				State: String(form.get('state') ?? ''),
				Zip: String(form.get('zip') ?? ''),
				'Year Built': String(form.get('yearBuilt') ?? ''),
				'Square Footage': String(form.get('squareFootage') ?? ''),
				Stories: String(form.get('stories') ?? ''),
				'Interior Access Difficulty': String(form.get('interiorAccessDifficulty') ?? ''),
				'Exterior Access Difficulty': String(form.get('exteriorAccessDifficulty') ?? ''),
				'Roof Access Required (Y/N)': form.get('roofAccessRequired') === 'on' ? 'Y' : 'N',
				'High Interior Glass (Y/N)': form.get('highInteriorGlass') === 'on' ? 'Y' : 'N',
				'Steep Or Uneven Terrain (Y/N)': form.get('steepOrUnevenTerrain') === 'on' ? 'Y' : 'N',
				'Restricted Work Or Setup Area (Y/N)': form.get('restrictedWorkOrSetupArea') === 'on' ? 'Y' : 'N',
				'Water Access Method': String(form.get('waterAccessMethod') ?? ''),
				'Water Supply': String(form.get('waterSupply') ?? ''),
				'Exterior Cleaning Method': String(form.get('exteriorCleaningMethod') ?? ''),
				'Parking And Setup Difficulty': String(form.get('parkingAndSetupDifficulty') ?? ''),
				'Gate Or Entry Restriction (Y/N)': form.get('gateOrEntryRestriction') === 'on' ? 'Y' : 'N',
				'Long Hose Run (Y/N)': form.get('longHoseRun') === 'on' ? 'Y' : 'N',
				'Water Source Far From Work Area (Y/N)': form.get('waterSourceFarFromWorkArea') === 'on' ? 'Y' : 'N',
				'Access Notes': String(form.get('accessNotes') ?? ''),
				'Ladder Requirement': String(form.get('highestLadderRequired') ?? ''),
				'Total Window Units': String(form.get('totalWindowUnits') ?? ''),
				'Total Glass Panes': String(form.get('totalGlassPanes') ?? ''),
				'Count - Standard': String(form.get('countStandard') ?? ''),
				'Count - Double Hung': String(form.get('countDoubleHung') ?? ''),
				'Count - Casement': String(form.get('countCasement') ?? ''),
				'Count - Picture': String(form.get('countPicture') ?? ''),
				'Count - Sliding': String(form.get('countSliding') ?? ''),
				'Count - French': String(form.get('countFrench') ?? ''),
				'Count - Awning': String(form.get('countAwning') ?? ''),
				'Count - Skylights': String(form.get('countSkylights') ?? ''),
				'Count - Solar Panels': String(form.get('countSolarPanels') ?? ''),
				'Sliding Glass Door Pane Count': String(form.get('slidingGlassDoorPaneCount') ?? ''),
				'Screen Count': String(form.get('screenCount') ?? ''),
				'Track Count': String(form.get('trackCount') ?? ''),
				'Repeat Business Status': String(form.get('repeatBusinessStatus') ?? ''),
				'Pet Notes': String(form.get('petNotes') ?? ''),
				'General Notes': String(form.get('generalNotes') ?? ''),
				'Building/Complex Name': String(form.get('buildingComplexName') ?? ''),
				'Unit Identifier': String(form.get('unitIdentifier') ?? ''),
			});

			// Data-ownership separation: copy-on-read-then-write-once migration
			// for the two customer-preference fields that moved to Client — only
			// fills a blank Client field, never overwrites an existing one, and
			// only runs alongside a real Save rather than on every page view.
			const savedProperty = await findById(env, propertyConfig, id!);
			if (savedProperty?.['Client ID']) {
				const linkedClient = await findById(env, clientConfig, savedProperty['Client ID']);
				if (linkedClient) {
					const clientPatch: Partial<Client> = {};
					if (!linkedClient['Desired Maintenance Frequency'] && savedProperty['Desired Maintenance Frequency']) {
						clientPatch['Desired Maintenance Frequency'] = savedProperty['Desired Maintenance Frequency'];
					}
					if (!linkedClient['Preferred Service Season'] && savedProperty['Preferred Service Season']) {
						clientPatch['Preferred Service Season'] = savedProperty['Preferred Service Season'];
					}
					if (Object.keys(clientPatch).length > 0) {
						await updateRow(env, clientConfig, linkedClient['Client ID'], clientPatch);
					}
				}
			}
		} else if (action === 'migrate-legacy-condition') {
			const legacyProperty = await findById(env, propertyConfig, id!);
			if (legacyProperty) {
				await createRow(env, walkthroughConfig, {
					'Client ID': legacyProperty['Client ID'],
					'Property ID': id!,
					'Walkthrough Date': legacyProperty['Updated At']?.slice(0, 10) ?? '',
					Status: 'Completed',
					'Story Count Observed': legacyProperty.Stories,
					'Exterior Condition': legacyProperty['Window Condition'],
					'Hard Water Present (Y/N)': legacyProperty['Hard Water History (Y/N)'],
					'Construction Debris Present (Y/N)': legacyProperty['Construction Debris (Y/N)'],
					'Silicone Adhesive Or Sticker Residue (Y/N)': legacyProperty['Silicone Adhesive Or Sticker Residue (Y/N)'],
					'Heavy Interior Residue (Y/N)': legacyProperty['Heavy Interior Residue (Y/N)'],
					'Oxidized Frames Or Screens (Y/N)': legacyProperty['Oxidized Frames Or Screens (Y/N)'],
					'Condition Varies By Area (Y/N)': legacyProperty['Condition Varies By Area (Y/N)'],
					'Condition Notes': legacyProperty['Condition Notes'],
					'Exterior Access Obstructed (Y/N)': legacyProperty['Exterior Access Obstructed (Y/N)'],
					'Furniture Or Belongings Movement Required (Y/N)': legacyProperty['Furniture Or Belongings Movement Required (Y/N)'],
					Notes: `${LEGACY_MIGRATION_NOTES_PREFIX} — exact observation date unknown (property last updated ${legacyProperty['Updated At']}).`,
				});
			}
		} else if (action === 'add-note') {
			const note = String(form.get('note') ?? '').trim();
			if (note) {
				await logActivity(env, { entityType: 'Property', entityId: id!, action: 'Note added', notes: note });
			}
		} else if (action === 'duplicate-property') {
			const duplicate = await duplicateProperty(env, id!);
			return Astro.redirect(`/properties/${duplicate['Property ID']}`);
		} else if (action === 'delete-property') {
			await deleteProperty(env, id!);
			return Astro.redirect('/properties');
		} else if (action === 'restore-property') {
			await restoreProperty(env, id!);
		}
		return Astro.redirect(`/properties/${id}`);
	} catch (e) {
		error = (e as Error).message;
	}
}

const property = await findById(env, propertyConfig, id!);
if (!property) {
	return new Response('Property not found', { status: 404 });
}

const client = property['Client ID'] ? await findById(env, clientConfig, property['Client ID']) : null;

// One-time compatibility defaults for the enum fields renamed/split during
// past redesigns — see derivePropertyCompatDefaults in lib/models/property.ts
// (shared with the Quoter's read-only property summary). None of these
// ever write to Sheets; the raw legacy value stays exactly as stored until
// the owner actually saves this property. accessNotesValue additionally
// merges the deprecated 'Site Access Notes' into 'Access Notes' for display.
const { exteriorCleaningMethodValue, ladderRequirementValue, waterAccessValue, waterSupplyValue, parkingAndSetupValue, accessNotesValue } =
	derivePropertyCompatDefaults(property);

const [allQuotes, allJobs, allOpportunities, allWalkthroughs, pricingConfig, activityRows] = await Promise.all([
	listActiveRows(env, quoteConfig),
	listActiveRows(env, jobConfig),
	listActiveRows(env, pipelineConfig),
	listActiveRows(env, walkthroughConfig),
	property['Property Type'] ? getActivePricingConfig(env, property['Property Type']) : Promise.resolve(null),
	readRows(env, 'ActivityLog', { idColumn: 'Activity ID' }),
]);
const propertyWalkthroughs = allWalkthroughs.filter((w) => w['Property ID'] === id);

const streetAddress = property['Street Address'].toLowerCase();
const propertyQuotes = allQuotes.filter((q) => q['Property ID'] === id);
const propertyOpportunities = allOpportunities.filter((o) => o['Property ID'] === id);
// Matched primarily by Property ID; falls back to address-substring matching
// for jobs that predate that column.
const propertyJobs: Job[] = allJobs.filter((j) =>
	j['Property ID'] ? j['Property ID'] === id : j['Property Address'].toLowerCase().includes(streetAddress)
);

const OPEN_OPPORTUNITY_STAGES = new Set(['New Lead', 'Contacted', 'Walkthrough Scheduled', 'Quote Draft', 'Quote Sent', 'Follow-up']);
const ACTIVE_JOB_STATUSES = new Set(['Scheduled', 'In Progress']);
const COMPLETED_JOB_STATUSES = new Set(['Completed', 'Invoiced', 'Paid']);

function derivePropertyStatus(opportunities: Opportunity[], jobs: Job[]): string {
	if (property!['Archived At']) return 'Archived';
	if (jobs.some((j) => COMPLETED_JOB_STATUSES.has(j['Job Status']))) return 'Established Client';
	if (jobs.some((j) => ACTIVE_JOB_STATUSES.has(j['Job Status']))) return 'Active — Job Scheduled';
	if (opportunities.some((o) => OPEN_OPPORTUNITY_STAGES.has(o.Stage))) return 'Prospect';
	return 'New';
}
const propertyStatus = derivePropertyStatus(propertyOpportunities, propertyJobs);

const targetHourlyRate = Number(pricingConfig?.['Target Hourly Rate'] ?? 0);
const jobRows = propertyJobs.map((job) => ({ job, perf: computeJobPerformance(job, targetHourlyRate) }));
const performance = computePropertyPerformance(propertyJobs);

const propertyPhotos = await listPropertyPhotos(env, id!);
const propertyPhotoDtos = propertyPhotos.map((p) => ({
	id: p['Photo ID'],
	filename: p['Original Filename'],
	contentType: p['Content Type'],
	sizeBytes: p['Size Bytes'],
	caption: p.Caption,
	createdAt: p['Created At'],
}));

// Data-ownership separation: "Next Service" is now derived from real Job
// data instead of a manually-typed Property field — the earliest future
// Scheduled Date among this property's Scheduled jobs, falling back to the
// most recent completed job's already-computed Next Maintenance Follow-up
// Date (see jobLifecycle.ts), never a plain editable field again.
const today = new Date().toISOString().slice(0, 10);
const upcomingScheduledJobs = propertyJobs
	.filter((j) => j['Job Status'] === 'Scheduled' && j['Scheduled Date'] && j['Scheduled Date'] >= today)
	.sort((a, b) => a['Scheduled Date'].localeCompare(b['Scheduled Date']));
const mostRecentCompletedJob = propertyJobs
	.filter((j) => COMPLETED_JOB_STATUSES.has(j['Job Status']) && j['Date Completed'])
	.sort((a, b) => b['Date Completed'].localeCompare(a['Date Completed']))[0];
const nextServiceLabel = upcomingScheduledJobs[0]
	? `Next visit: ${upcomingScheduledJobs[0]['Scheduled Date']}`
	: mostRecentCompletedJob?.['Next Maintenance Follow-up Date']
		? `Next recommended: ${mostRecentCompletedJob['Next Maintenance Follow-up Date']}`
		: 'Not scheduled';

// Data-ownership separation: one-time notice offering to preserve legacy
// Glass Condition / temporary-access data (now deprecated on Property) as a
// real historical Walkthrough, rather than silently discarding it or
// silently pretending it describes today. Never shown again once that
// migration Walkthrough exists for this property.
const hasLegacyConditionData = Boolean(
	property['Window Condition'] ||
		property['Hard Water History (Y/N)'] === 'Y' ||
		property['Construction Debris (Y/N)'] === 'Y' ||
		property['Silicone Adhesive Or Sticker Residue (Y/N)'] === 'Y' ||
		property['Heavy Interior Residue (Y/N)'] === 'Y' ||
		property['Oxidized Frames Or Screens (Y/N)'] === 'Y' ||
		property['Condition Varies By Area (Y/N)'] === 'Y' ||
		property['Condition Notes'] ||
		property['Exterior Access Obstructed (Y/N)'] === 'Y' ||
		property['Furniture Or Belongings Movement Required (Y/N)'] === 'Y'
);
const legacyConditionAlreadyMigrated = propertyWalkthroughs.some((w) => w.Notes.startsWith(LEGACY_MIGRATION_NOTES_PREFIX));
const showLegacyMigrationNotice = hasLegacyConditionData && !legacyConditionAlreadyMigrated;

// Timeline: every ActivityLog entry whose Entity ID belongs to this
// property — directly, or via its client/quotes/jobs/opportunities.
const relevantIds = new Set<string>([
	id!,
	...(client ? [client['Client ID']] : []),
	...propertyQuotes.map((q) => q['Quote ID']),
	...propertyJobs.map((j) => j['Job ID']),
	...propertyOpportunities.map((o) => o['Opportunity ID']),
	...propertyWalkthroughs.map((w) => w['Walkthrough ID']),
]);
const quoteIdByJobId = Object.fromEntries(propertyJobs.map((j) => [j['Job ID'], j['Quote ID']]));

function timelineLink(entityType: string, entityId: string): string | null {
	if (entityType === 'Quote') return `/quotes/${entityId}`;
	if (entityType === 'Job') return quoteIdByJobId[entityId] ? `/quotes/${quoteIdByJobId[entityId]}` : null;
	if (entityType === 'Client') return `/clients/${entityId}`;
	if (entityType === 'Walkthrough') return `/walkthroughs/${entityId}`;
	if (entityType === 'Opportunity') return '/pipeline';
	if (entityType === 'PricingConfig') return '/pricing-config';
	if (entityType === 'CalibrationSnapshot') return '/calibration';
	return null;
}

const timeline = activityRows
	.map((r) => r.data)
	.filter((entry) => relevantIds.has(String(entry['Entity ID'] ?? '')))
	.sort((a, b) => String(b.Timestamp ?? '').localeCompare(String(a.Timestamp ?? '')));
---

<BaseLayout title={property['Unit Identifier'] ? `${property['Street Address']} — Unit ${property['Unit Identifier']}` : property['Street Address']}>
	<main>
		<p><a href={`/clients/${property['Client ID']}`}>← Client</a></p>
		<div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.5rem;">
			<h1 style="margin: 0; white-space: nowrap;">
				<a href={googleMapsUrl(fullAddress(property))} target="_blank" rel="noopener noreferrer">
					{property['Street Address']}, {property.City}{property['Unit Identifier'] && <> — Unit {property['Unit Identifier']}</>}
				</a>
			</h1>
			<span class="badge badge-accent">{propertyStatus}</span>
			{property['Repeat Business Status'] && <span class="badge">{property['Repeat Business Status']}</span>}
			{property['Building/Complex Name'] && <span class="badge">{property['Building/Complex Name']}</span>}
		</div>
		{error && <p role="alert">{error}</p>}

		<div class="stats-grid">
			<div class="card">
				<span class="stat-label">Type</span>
				<div class="stat" style="font-size: 1.25rem;">{property['Property Type']}</div>
			</div>
			<div class="card">
				<span class="stat-label">Window Units</span>
				<div class="stat" style="font-size: 1.25rem;">{property['Total Window Units'] || '0'}</div>
			</div>
			<div class="card">
				<span class="stat-label">Glass Panes</span>
				<div class="stat" style="font-size: 1.25rem;">{property['Total Glass Panes'] || '0'}</div>
			</div>
			<div class="card">
				<span class="stat-label">Stories</span>
				<div class="stat" style="font-size: 1.25rem;">{property.Stories || '— not set'}</div>
			</div>
			<div class="card">
				<span class="stat-label">Next Service</span>
				<div class="stat" style={{ fontSize: '1.25rem', color: nextServiceLabel === 'Not scheduled' ? 'var(--color-ink-muted)' : undefined }}>
					{nextServiceLabel}
				</div>
			</div>
		</div>

		<p class="field-hint" style="margin-top: -0.75rem;">
			<a href={`/walkthroughs/new?propertyId=${property['Property ID']}`}><strong>Start walkthrough</strong></a>
			{' · '}
			<a href={`/quoter?propertyId=${property['Property ID']}&clientId=${property['Client ID']}`}>Create quote</a>
			{' · '}
			<a href={`/clients/${property['Client ID']}`}>Edit client</a>
			{' · '}
			<a href={`/historical-entry?propertyId=${property['Property ID']}&clientId=${property['Client ID']}`}>Add historical record</a>
			{' · '}
			<form method="POST" style="display:inline">
				<input type="hidden" name="_action" value="duplicate-property" />
				<button type="submit" class="link-button">Duplicate property</button>
			</form>
			{!property['Archived At'] && (
				<>
					{' · '}
					<form
						method="POST"
						style="display:inline"
						onsubmit="return confirm('Delete this property? It will be archived and removed from view everywhere in the app.')"
					>
						<input type="hidden" name="_action" value="delete-property" />
						<button type="submit" class="link-button">Delete property</button>
					</form>
				</>
			)}
			{client?.['Referral Source'] && <> · Referral source: {client['Referral Source']}</>}
			{client?.['Desired Maintenance Frequency'] && <> · Maintenance: {client['Desired Maintenance Frequency']}</>}
		</p>

		{property['Archived At'] && (
			<div class="card">
				<p role="alert">This property was deleted {formatTimestamp(property['Archived At'])}. It's hidden from lists but still reachable by direct link.</p>
				<form method="POST" onsubmit="return confirm('Restore this property? It will reappear everywhere in the app.')">
					<input type="hidden" name="_action" value="restore-property" />
					<button type="submit" class="btn-secondary">Restore this property</button>
				</form>
			</div>
		)}

		{showLegacyMigrationNotice && (
			<form method="POST" class="diff-notice">
				Legacy condition information exists on this property — copy it into a historical walkthrough?
				<br />
				<button type="submit" class="pipeline-card-add-property">Copy into a historical walkthrough</button>
				<input type="hidden" name="_action" value="migrate-legacy-condition" />
			</form>
		)}

		<div class="property-layout">
			<div>
				<form method="POST">
					<input type="hidden" name="_action" value="update-property" />

					<section class="card">
						<h2>Property Information</h2>
						<label>
							Property type
							<select name="propertyType" required>
								{PROPERTY_TYPES.map((t) => <option value={t} selected={t === property['Property Type']}>{t}</option>)}
							</select>
						</label>
						<label>Street address <input type="text" name="streetAddress" value={property['Street Address']} required /></label>
						<label>City <input type="text" name="city" value={property.City} /></label>
						<label>State <input type="text" name="state" maxlength="2" value={property.State} placeholder="CO" /></label>
						<label>Zip <input type="text" name="zip" value={property.Zip} /></label>
						<label>Year built <input type="text" name="yearBuilt" value={property['Year Built']} /></label>
						<label>Square footage <input type="text" name="squareFootage" value={property['Square Footage']} /></label>
						<label>Stories <input type="text" name="stories" value={property.Stories} /></label>
						<label>Building/complex name (optional) <input type="text" name="buildingComplexName" value={property['Building/Complex Name']} /></label>
						<label>Unit identifier (optional) <input type="text" name="unitIdentifier" value={property['Unit Identifier']} /></label>
					</section>

					<details class="card" open>
						<summary>Permanent Access &amp; Setup</summary>
						<div class="card-grid">
							<div>
								<p class="field-label">Interior Access</p>
								<div class="segmented">
									{ACCESS_LEVEL_OPTIONS.map((o) => (
										<label><input type="radio" name="interiorAccessDifficulty" value={o} checked={o === property['Interior Access Difficulty']} /> {o}</label>
									))}
								</div>
							</div>
							<div>
								<p class="field-label">Exterior Access</p>
								<div class="segmented">
									{ACCESS_LEVEL_OPTIONS.map((o) => (
										<label><input type="radio" name="exteriorAccessDifficulty" value={o} checked={o === property['Exterior Access Difficulty']} /> {o}</label>
									))}
								</div>
							</div>
							<div>
								<p class="field-label">Typical Exterior Method</p>
								<div class="segmented">
									{EXTERIOR_CLEANING_METHOD_OPTIONS.map((o) => (
										<label><input type="radio" name="exteriorCleaningMethod" value={o} checked={o === exteriorCleaningMethodValue} /> {o}</label>
									))}
								</div>
							</div>
							<div>
								<p class="field-label">Ladder Requirement</p>
								<div class="segmented">
									{LADDER_REQUIREMENT_OPTIONS.map((o) => (
										<label><input type="radio" name="highestLadderRequired" value={o} checked={o === ladderRequirementValue} /> {o}</label>
									))}
								</div>
							</div>
						</div>

						<p class="field-label" style="margin-top: 1rem;">Access Considerations</p>
						<label><input type="checkbox" name="roofAccessRequired" checked={property['Roof Access Required (Y/N)'] === 'Y'} /> Roof Access Required</label>
						<label><input type="checkbox" name="highInteriorGlass" checked={property['High Interior Glass (Y/N)'] === 'Y'} /> High Interior Glass</label>
						<label><input type="checkbox" name="steepOrUnevenTerrain" checked={property['Steep Or Uneven Terrain (Y/N)'] === 'Y'} /> Steep Or Uneven Terrain</label>
						<label><input type="checkbox" name="restrictedWorkOrSetupArea" checked={property['Restricted Work Or Setup Area (Y/N)'] === 'Y'} /> Restricted Work Or Setup Area</label>

						<div class="card-grid" style="margin-top: 1rem;">
							<div>
								<p class="field-label">Water Access</p>
								<div class="segmented">
									{WATER_ACCESS_OPTIONS.map((o) => (
										<label><input type="radio" name="waterAccessMethod" value={o} checked={o === waterAccessValue} /> {o}</label>
									))}
								</div>
							</div>
							<div>
								<p class="field-label">Water Supply</p>
								<div class="segmented">
									{WATER_SUPPLY_OPTIONS.map((o) => (
										<label><input type="radio" name="waterSupply" value={o} checked={o === waterSupplyValue} /> {o}</label>
									))}
								</div>
							</div>
							<div>
								<p class="field-label">Parking &amp; Setup</p>
								<div class="segmented">
									{PARKING_AND_SETUP_OPTIONS.map((o) => (
										<label><input type="radio" name="parkingAndSetupDifficulty" value={o} checked={o === parkingAndSetupValue} /> {o}</label>
									))}
								</div>
							</div>
						</div>

						<label><input type="checkbox" name="gateOrEntryRestriction" checked={property['Gate Or Entry Restriction (Y/N)'] === 'Y'} /> Gate Or Entry Restriction</label>
						<label><input type="checkbox" name="longHoseRun" checked={property['Long Hose Run (Y/N)'] === 'Y'} /> Long Hose Run</label>
						<label><input type="checkbox" name="waterSourceFarFromWorkArea" checked={property['Water Source Far From Work Area (Y/N)'] === 'Y'} /> Water Source Far From Work Area</label>

						<label>Access &amp; Setup Notes <textarea name="accessNotes" placeholder="Gate code, parking, spigot location, hose length, roof access route">{accessNotesValue}</textarea></label>
					</details>

					<details class="card" open>
						<summary>Window &amp; Door Inventory</summary>
						<label>
							Window Units
							<span class="field-hint">Approximate number of window assemblies.</span>
							<input type="number" class="field-numeric" name="totalWindowUnits" value={property['Total Window Units']} />
						</label>
						<label>
							Total Glass Panes
							<span class="field-hint">Total number of individual glass panes.</span>
							<input type="number" class="field-numeric" id="totalPanes" name="totalGlassPanes" value={property['Total Glass Panes']} />
						</label>
						<p id="paneBreakdownStatus" class="field-status"></p>

						<div class="count-grid">
							<label>Standard Windows <input type="number" class="field-numeric pane-field" id="countStandard" name="countStandard" value={property['Count - Standard']} /></label>
							<label>French / Divided-Light <input type="number" class="field-numeric pane-field" name="countFrench" value={property['Count - French']} /></label>
							<label>Sliding Glass Doors <input type="number" class="field-numeric pane-field" name="slidingGlassDoorPaneCount" value={property['Sliding Glass Door Pane Count']} /></label>
							<label>Skylights <input type="number" class="field-numeric pane-field" name="countSkylights" value={property['Count - Skylights']} /></label>
						</div>

						<p class="field-label">Accessories</p>
						<span class="field-hint">Not included in pane totals.</span>
						<div class="count-grid">
							<label>Screens <input type="number" class="field-numeric" name="screenCount" value={property['Screen Count']} /></label>
							<label>Tracks <input type="number" class="field-numeric" name="trackCount" value={property['Track Count']} /></label>
							<label>Solar Panels <input type="number" class="field-numeric" name="countSolarPanels" value={property['Count - Solar Panels']} /></label>
						</div>

						<details style="margin-top: 0.75rem;">
							<summary>Detailed inventory</summary>
							<span class="field-hint">Optional — only fill in if you want to track windows by operating style. Total Glass Panes validation uses these instead of Standard Windows above once any of them are entered.</span>
							<div class="count-grid" style="margin-top: 0.5rem;">
								<label>Double Hung <input type="number" class="field-numeric detailed-inventory-field" name="countDoubleHung" value={property['Count - Double Hung']} /></label>
								<label>Casement <input type="number" class="field-numeric detailed-inventory-field" name="countCasement" value={property['Count - Casement']} /></label>
								<label>Picture <input type="number" class="field-numeric detailed-inventory-field" name="countPicture" value={property['Count - Picture']} /></label>
								<label>Sliding Window <input type="number" class="field-numeric detailed-inventory-field" name="countSliding" value={property['Count - Sliding']} /></label>
								<label>Awning <input type="number" class="field-numeric detailed-inventory-field" name="countAwning" value={property['Count - Awning']} /></label>
							</div>
						</details>

						<p class="field-hint" style="margin-top: 1rem;">
							Inventory last verified: {property['Inventory Verified At'] ? new Date(property['Inventory Verified At']).toLocaleDateString() : 'Not verified'}
							{' · '}
							<button type="submit" name="markInventoryVerified" value="1" class="pipeline-card-add-property">Mark Inventory Verified</button>
						</p>
					</details>

					<details class="card">
						<summary>Property Notes</summary>
						<label>
							Repeat business status
							<span class="field-hint">Flags a second property/add-on request from this existing Client — not a new sales pipeline. Leave blank when there's no active repeat-business request.</span>
							<select name="repeatBusinessStatus">
								<option value="" selected={!property['Repeat Business Status']} />
								{REPEAT_BUSINESS_STATUS_OPTIONS.map((v) => <option value={v} selected={v === property['Repeat Business Status']}>{v}</option>)}
							</select>
						</label>
						<label>Pet notes <textarea name="petNotes">{property['Pet Notes']}</textarea></label>
						<label>Property Notes <textarea name="generalNotes">{property['General Notes']}</textarea></label>
					</details>

					<button type="submit">Save</button>
				</form>
			</div>

			<div>
				<section class="card">
					<h2>Walkthroughs</h2>
					{propertyWalkthroughs.map((w) => (
						<div class="sidebar-row">
							<div class="sidebar-row-main">
								<a href={`/walkthroughs/${w['Walkthrough ID']}`}>{w['Walkthrough Date']}</a>
								<span class="badge">{w.Status}</span>
							</div>
							{w['Suggested Target Price'] && <div class="sidebar-row-meta">${w['Suggested Target Price']} suggested</div>}
						</div>
					))}
					{propertyWalkthroughs.length === 0 && <p>No walkthroughs yet.</p>}
				</section>

				<section class="card">
					<h2>Quotes</h2>
					{propertyQuotes.map((q) => (
						<div class="sidebar-row">
							<div class="sidebar-row-main">
								<a href={`/quotes/${q['Quote ID']}`}>{q['Quote ID'].slice(0, 8)}</a>
								<span class="badge">{q['Quote Status']}</span>
							</div>
							<div class="sidebar-row-meta">
								${q['Final Quoted Price']} · calc v{q['Calculator Version']} · created {q['Created At']}
								{q['Sent At'] && <> · sent {q['Sent At']}</>}
								{q['Accepted At'] && <> · accepted {q['Accepted At']}</>}
							</div>
						</div>
					))}
					{propertyQuotes.length === 0 && <p>No quotes yet.</p>}
				</section>

				<section class="card">
					<h2>Jobs</h2>
					{jobRows.map(({ job, perf }) => (
						<div class="sidebar-row">
							<div class="sidebar-row-main">
								<span>{job['Date Completed']}</span>
								<span class="badge">{job['Job Status']}</span>
							</div>
							<div class="sidebar-row-meta">
								${perf.finalRevenue.toFixed(2)} · {perf.actualHours.toFixed(2)} on-site hrs · ${perf.actualRevenuePerLaborHour.toFixed(2)}/hr
								{job['Callback Required (Y/N)'] === 'Y' && <> · callback</>}
							</div>
							<div class="sidebar-row-meta">
								{job['Quote ID'] && <a href={`/quotes/${job['Quote ID']}`}>View quote</a>}
								{' '}<a href={`/jobs/${job['Job ID']}`}>Job Day</a>
							</div>
						</div>
					))}
					{jobRows.length === 0 && <p>No jobs logged yet.</p>}
				</section>

				<section class="card">
					<h2>Photos</h2>
					<PropertyPhotos client:load propertyId={id} photos={propertyPhotoDtos} />
				</section>

				{performance.completedJobCount > 0 && (
					<section class="card">
						<h2>Historical property performance</h2>
						{performance.completedJobCount <= 2 && <p><em>Limited history. Treat as directional only.</em></p>}
						<p>
							<span class="stat-label">Completed jobs</span>
							<span class="stat">{performance.completedJobCount}</span>
						</p>
						<ul>
							<li>Included in calibration: {performance.includedCount}</li>
							<li>Excluded from calibration: {performance.excludedCount}</li>
							<li>Average on-site hours: {performance.averageOnSiteHours.toFixed(2)}</li>
							<li>Average final revenue: ${performance.averageFinalRevenue.toFixed(2)}</li>
							<li>Average revenue per on-site hour: ${performance.averageRevenuePerOnSiteHour.toFixed(2)}</li>
							<li>Total callbacks: {performance.totalCallbacks}</li>
							<li>Most recent service date: {performance.mostRecentServiceDate || 'unknown'}</li>
						</ul>
					</section>
				)}

				<section class="card timeline-card">
					<h2>Activity timeline</h2>
					<form method="POST" style="margin-bottom: 1rem;">
						<input type="hidden" name="_action" value="add-note" />
						<label>Add a note <textarea name="note" required></textarea></label>
						<button type="submit">Add note</button>
					</form>
					{timeline.map((entry) => {
						const link = timelineLink(String(entry['Entity Type'] ?? ''), String(entry['Entity ID'] ?? ''));
						return (
							<div class="sidebar-row">
								<div class="sidebar-row-main">
									<span class="badge">{String(entry['Entity Type'] ?? '')}</span>
									<span>{formatTimestamp(String(entry.Timestamp ?? ''))}</span>
								</div>
								<div class="sidebar-row-meta">
									{String(entry.Action ?? '')}
									{entry.Notes ? ` — ${entry.Notes}` : ''}
									{link && <> (<a href={link}>view</a>)</>}
								</div>
							</div>
						);
					})}
					{timeline.length === 0 && <p>No activity recorded yet.</p>}
				</section>
			</div>
		</div>
	</main>

	<script>
		const totalPanesInput = document.getElementById('totalPanes') as HTMLInputElement;
		const standardInput = document.getElementById('countStandard') as HTMLInputElement;
		const otherPaneFields = Array.from(document.querySelectorAll('.pane-field:not(#countStandard)')) as HTMLInputElement[];
		const detailedFields = Array.from(document.querySelectorAll('.detailed-inventory-field')) as HTMLInputElement[];
		const status = document.getElementById('paneBreakdownStatus') as HTMLElement;

		// Total Glass Panes validation only counts categories that are
		// explicitly panes (Standard/French/Sliding Glass Door/Skylights) —
		// Screens/Tracks/Solar Panels never contribute. The detailed
		// breakdown (Double Hung/Casement/Picture/Sliding Window/Awning)
		// stands in for Standard Windows once any of it is used, so nothing
		// double-counts between the aggregate and its own detailed parts. No
		// warning renders until the rep has actually entered something.
		function checkPaneBreakdown() {
			const detailedTotal = detailedFields.reduce((sum, field) => sum + (Number(field.value) || 0), 0);
			const standardContribution = detailedTotal > 0 ? detailedTotal : Number(standardInput.value) || 0;
			const otherTotal = otherPaneFields.reduce((sum, field) => sum + (Number(field.value) || 0), 0);
			const breakdownTotal = standardContribution + otherTotal;
			const totalPanes = Number(totalPanesInput.value) || 0;

			if (breakdownTotal === 0) {
				status.textContent = '';
				status.className = 'field-status';
				return;
			}
			if (breakdownTotal === totalPanes) {
				status.textContent = `✓ Pane breakdown matches total panes`;
				status.className = 'field-status field-status-ok';
			} else {
				status.textContent = `⚠ Pane breakdown totals ${breakdownTotal} of ${totalPanes} panes`;
				status.className = 'field-status mismatch';
			}
		}

		totalPanesInput.addEventListener('input', checkPaneBreakdown);
		standardInput.addEventListener('input', checkPaneBreakdown);
		otherPaneFields.forEach((field) => field.addEventListener('input', checkPaneBreakdown));
		detailedFields.forEach((field) => field.addEventListener('input', checkPaneBreakdown));
		checkPaneBreakdown();
	</script>
</BaseLayout>
