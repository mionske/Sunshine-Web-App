---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HistoricalEntryForm from '../../components/HistoricalEntryForm.astro';
import { env } from 'cloudflare:workers';
import { findById } from '../../lib/sheets';
import { clientConfig } from '../../lib/models/client';
import { propertyConfig } from '../../lib/models/property';
import { jobConfig } from '../../lib/models/job';
import { updateHistoricalEntry } from '../../lib/pricing/historicalEntry';
import {
	formValuesFromRecords,
	formValuesFromRequest,
	payloadForUpdate,
	validateFormValues,
} from '../../lib/historicalEntryForm';

const { jobId } = Astro.params;

const job = await findById(env, jobConfig, jobId!);
if (!job) {
	return new Response('Historical record not found', { status: 404 });
}

// Both links are optional: the compact entry form lets a job be recorded
// with no client and no property at all, and such a record still has to be
// editable afterward.
const property = job['Property ID'] ? await findById(env, propertyConfig, job['Property ID']) : null;
const client = property?.['Client ID'] ? await findById(env, clientConfig, property['Client ID']) : null;
const records = { client, property, job };

let error: string | null = null;
let values = formValuesFromRecords(records);

if (Astro.request.method === 'POST') {
	values = formValuesFromRequest(await Astro.request.formData());
	error = validateFormValues(values);
	if (!error) {
		try {
			await updateHistoricalEntry(env, payloadForUpdate(values, records));
			return Astro.redirect('/historical-records');
		} catch (e) {
			error = (e as Error).message;
		}
	}
}

const clientName = client ? `${client['First Name']} ${client['Last Name']}`.replace(/\s+/g, ' ').trim() : '';
const linkedLabel = property
	? [
			`${property['Street Address']}, ${property.City}${property['Unit Identifier'] ? ` — Unit ${property['Unit Identifier']}` : ''}`,
			clientName,
		]
			.filter(Boolean)
			.join(' · ')
	: 'No client or property is linked to this record.';
---

<BaseLayout title="Edit historical record">
	<main>
		<p><a href="/historical-records">← Historical Records</a></p>
		<h1>Edit historical record</h1>

		<HistoricalEntryForm
			mode="edit"
			values={values}
			error={error}
			linkedLabel={linkedLabel}
			cancelHref="/historical-records"
		/>
	</main>
</BaseLayout>
