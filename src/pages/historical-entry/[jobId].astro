---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HistoricalEntryWizard, { buildEditState } from '../../components/HistoricalEntryWizard';
import { env } from 'cloudflare:workers';
import { findById, listActiveRows } from '../../lib/sheets';
import { clientConfig } from '../../lib/models/client';
import { propertyConfig } from '../../lib/models/property';
import { walkthroughConfig } from '../../lib/models/walkthrough';
import { quoteConfig } from '../../lib/models/quote';
import { jobConfig } from '../../lib/models/job';

const { jobId } = Astro.params;

const job = await findById(env, jobConfig, jobId!);
if (!job) {
	return new Response('Historical record not found', { status: 404 });
}

const property = job['Property ID'] ? await findById(env, propertyConfig, job['Property ID']) : null;
if (!property) {
	return new Response('This job has no linked Property — cannot be edited here.', { status: 404 });
}
const client = await findById(env, clientConfig, property['Client ID']);
if (!client) {
	return new Response('This property has no linked Client — cannot be edited here.', { status: 404 });
}
// A Job links to its Walkthrough only indirectly, via its Quote — if no
// Quote was recorded for this historical entry, there's no way to reach a
// Walkthrough from the Job alone (matches the app's real data model, not a
// gap introduced by this route).
const quote = job['Quote ID'] ? await findById(env, quoteConfig, job['Quote ID']) : null;
const walkthrough = quote?.['Walkthrough ID'] ? await findById(env, walkthroughConfig, quote['Walkthrough ID']) : null;

const [clients, properties] = await Promise.all([listActiveRows(env, clientConfig), listActiveRows(env, propertyConfig)]);

const initialState = buildEditState({
	client,
	property,
	walkthrough: walkthrough ?? undefined,
	quote: quote ?? undefined,
	job,
});
---

<BaseLayout title="Edit historical record">
	<main>
		<h1>Edit historical record</h1>
		<p>
			Editing the property/job/quote/walkthrough entered for
			{' '}{property['Street Address']}, {property.City}{property['Unit Identifier'] && <> — Unit {property['Unit Identifier']}</>}. See <a href="/historical-records">all Historical Records</a>.
		</p>
		<HistoricalEntryWizard client:load mode="edit" initialState={initialState} clients={clients} properties={properties} />
	</main>
</BaseLayout>
