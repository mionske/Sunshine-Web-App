---
import BaseLayout from '../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { createRow, listActiveRows } from '../lib/sheets';
import { pipelineConfig, PIPELINE_STAGES } from '../lib/models/pipeline';
import { clientConfig } from '../lib/models/client';
import { propertyConfig } from '../lib/models/property';
import { fullAddress } from '../lib/mapsLink';
import PipelineBoard from '../components/PipelineBoard';

let error: string | null = null;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	try {
		await createRow(env, pipelineConfig, {
			id: String(form.get('id') ?? ''),
			'Client ID': String(form.get('clientId') ?? ''),
			'Property ID': String(form.get('propertyId') ?? ''),
			'Primary Quote ID': '',
			Stage: 'New Lead',
			Status: 'Open',
			'Estimated Value': String(form.get('estimatedValue') ?? ''),
			'Referral Source': String(form.get('referralSource') ?? ''),
			'Next Follow-up Date': String(form.get('nextFollowUpDate') ?? ''),
			'Last Contact Date': '',
			'Lost Reason': '',
			Notes: '',
		});
		return Astro.redirect('/pipeline');
	} catch (e) {
		error = (e as Error).message;
	}
}

const [opportunities, clients, properties] = await Promise.all([
	listActiveRows(env, pipelineConfig),
	listActiveRows(env, clientConfig),
	listActiveRows(env, propertyConfig),
]);

const clientById = Object.fromEntries(clients.map((c) => [c['Client ID'], c]));
const propertyById = Object.fromEntries(properties.map((p) => [p['Property ID'], p]));

const cards = opportunities.map((o) => {
	const client = clientById[o['Client ID']];
	const property = propertyById[o['Property ID']];
	return {
		id: o['Opportunity ID'],
		stage: o.Stage,
		clientName: client ? `${client['First Name']} ${client['Last Name']}` : o['Client ID'],
		propertyAddress: property ? fullAddress(property) : '',
		estimatedValue: o['Estimated Value'],
		nextFollowUpDate: o['Next Follow-up Date'],
	};
});

const propertyOptions = properties.map((p) => ({
	id: p['Property ID'],
	label: `${p['Street Address']} (${clientById[p['Client ID']]?.['Last Name'] ?? '?'})`,
	address: fullAddress(p),
}));

const newOpportunityId = crypto.randomUUID();
---

<BaseLayout title="Pipeline">
	<main>
		<h1>Pipeline</h1>
		{error && <p role="alert">{error}</p>}

		<PipelineBoard client:load stages={PIPELINE_STAGES} cards={cards} properties={propertyOptions} />

		<h2>New opportunity</h2>
		<form method="POST">
			<input type="hidden" name="id" value={newOpportunityId} />
			<label>
				Client
				<select name="clientId" required>
					{clients.map((c) => (
						<option value={c['Client ID']}>{c['First Name']} {c['Last Name']}</option>
					))}
				</select>
			</label>
			<label>
				Property (optional — a contact often comes in before a property is attached)
				<select name="propertyId">
					<option value="">— none yet —</option>
					{properties.map((p) => (
						<option value={p['Property ID']}>{p['Street Address']}</option>
					))}
				</select>
			</label>
			<label>Estimated value <input type="text" name="estimatedValue" /></label>
			<label>Referral source <input type="text" name="referralSource" /></label>
			<label>Next follow-up date <input type="date" name="nextFollowUpDate" /></label>
			<button type="submit">Create opportunity</button>
		</form>
	</main>
</BaseLayout>
