---
import BaseLayout from '../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import {
	activatePricingConfig,
	createPricingConfig,
	listPricingConfigs,
	seedInitialPricingConfig,
	updatePricingConfigDraft,
} from '../lib/pricing/config';
import { PROPERTY_TYPES } from '../lib/models/property';

let error: string | null = null;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = String(form.get('_action') ?? '');
	try {
		if (action === 'create') {
			await createPricingConfig(env, {
				id: String(form.get('id') ?? ''),
				'Config Name': String(form.get('configName') ?? ''),
				'Property Type': String(form.get('propertyType') ?? ''),
				'Target Hourly Rate': String(form.get('targetHourlyRate') ?? ''),
				'Minimum Job Price': String(form.get('minimumJobPrice') ?? ''),
				Notes: String(form.get('notes') ?? ''),
			});
		} else if (action === 'activate') {
			await activatePricingConfig(env, String(form.get('id') ?? ''));
		} else if (action === 'edit-draft') {
			await updatePricingConfigDraft(env, String(form.get('id') ?? ''), {
				'Config Name': String(form.get('configName') ?? ''),
				'Target Hourly Rate': String(form.get('targetHourlyRate') ?? ''),
				'Minimum Job Price': String(form.get('minimumJobPrice') ?? ''),
				Notes: String(form.get('notes') ?? ''),
			});
		}
		return Astro.redirect('/pricing-config');
	} catch (e) {
		error = (e as Error).message;
	}
}

await seedInitialPricingConfig(env);
const configs = await listPricingConfigs(env);
configs.sort((a, b) => b['Created At'].localeCompare(a['Created At']));
const newId = crypto.randomUUID();
---

<BaseLayout title="Pricing Config">
	<main>
		<h1>Pricing Config</h1>
		<p>
			The <strong>Active</strong> config for each Property Type is what controls that segment's
			quote calculations today — exactly one Active row per Property Type (Residential/Commercial/
			New Build-Construction are independently priced and versioned). Historical performance never
			changes this automatically — activating a new config is always an explicit action taken here.
		</p>
		{error && <p role="alert">{error}</p>}

		<section class="card">
		<table>
			<thead>
				<tr>
					<th>Name</th>
					<th>Property Type</th>
					<th>Status</th>
					<th>Target $/hr</th>
					<th>Min job price</th>
					<th>Effective</th>
					<th>End</th>
					<th>Notes</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				{configs.map((c) => (
					<tr>
						<td>{c['Config Name']}</td>
						<td>{c['Property Type'] || <em>unset</em>}</td>
						<td>{c.Status}</td>
						<td>{c['Target Hourly Rate']}</td>
						<td>{c['Minimum Job Price']}</td>
						<td>{c['Effective Date']}</td>
						<td>{c['End Date']}</td>
						<td>{c.Notes}</td>
						<td>
							{c.Status !== 'Active' && (
								<>
									<details>
										<summary>Edit</summary>
										<form method="POST">
											<input type="hidden" name="_action" value="edit-draft" />
											<input type="hidden" name="id" value={c['Pricing Config ID']} />
											<label>Config name <input type="text" name="configName" value={c['Config Name']} /></label>
											<label>Target hourly rate <input type="text" name="targetHourlyRate" value={c['Target Hourly Rate']} /></label>
											<label>Minimum job price <input type="text" name="minimumJobPrice" value={c['Minimum Job Price']} /></label>
											<label>Notes <textarea name="notes">{c.Notes}</textarea></label>
											<button type="submit">Save changes</button>
										</form>
									</details>
									<form method="POST">
										<input type="hidden" name="_action" value="activate" />
										<input type="hidden" name="id" value={c['Pricing Config ID']} />
										<button type="submit">Activate</button>
									</form>
								</>
							)}
						</td>
					</tr>
				))}
			</tbody>
		</table>
		</section>

		<section class="card card-narrow">
			<h2>New pricing config (draft)</h2>
			<form method="POST">
				<input type="hidden" name="_action" value="create" />
				<input type="hidden" name="id" value={newId} />
				<label>Config name <input type="text" name="configName" required /></label>
				<label>
					Property type
					<select name="propertyType" required>
						<option value="" />
						{PROPERTY_TYPES.map((t) => <option value={t}>{t}</option>)}
					</select>
				</label>
				<label>Target hourly rate <input type="text" name="targetHourlyRate" required /></label>
				<label>Minimum job price <input type="text" name="minimumJobPrice" /></label>
				<label>Notes <textarea name="notes"></textarea></label>
				<button type="submit">Save as draft</button>
			</form>
		</section>
	</main>
</BaseLayout>
