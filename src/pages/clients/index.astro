---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { listActiveRows, listArchivedRows } from '../../lib/sheets';
import { clientConfig } from '../../lib/models/client';
import { deleteClient, restoreClient, duplicateClient } from '../../lib/clients';
import { formatTimestamp } from '../../lib/format';

let error: string | null = null;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = String(form.get('_action') ?? '');
	const clientId = String(form.get('clientId') ?? '');
	try {
		if (action === 'delete-client') {
			await deleteClient(env, clientId);
		} else if (action === 'restore-client') {
			await restoreClient(env, clientId);
		} else if (action === 'duplicate-client') {
			const duplicate = await duplicateClient(env, clientId);
			return Astro.redirect(`/clients/${duplicate['Client ID']}`);
		}
	} catch (e) {
		error = (e as Error).message;
	}
}

const showArchived = Astro.url.searchParams.get('archived') === '1';
const clients = showArchived ? await listArchivedRows(env, clientConfig) : await listActiveRows(env, clientConfig);
clients.sort((a, b) =>
	showArchived ? (b['Archived At'] || '').localeCompare(a['Archived At'] || '') : a['Last Name'].localeCompare(b['Last Name'])
);
---

<BaseLayout title="Clients">
	<main>
		<div class="card-header-row">
			<h1>Clients</h1>
			<a class="btn" href="/clients/new">+ New client</a>
		</div>
		<p>
			{showArchived ? <a href="/clients">← Back to active clients</a> : <a href="/clients?archived=1">View deleted/archived clients →</a>}
		</p>
		{error && <p role="alert">{error}</p>}

		<table>
			<thead>
				<tr>
					<th>Name</th>
					<th>Phone</th>
					<th>Email</th>
					<th>Referral Source</th>
					{showArchived && <th>Deleted</th>}
					<th></th>
				</tr>
			</thead>
			<tbody>
				{
					clients.map((c) => (
						<tr>
							<td>
								<a href={`/clients/${c['Client ID']}`}>
									{c['First Name']} {c['Last Name']}
								</a>
							</td>
							<td>{c.Phone}</td>
							<td>{c.Email}</td>
							<td>{c['Referral Source']}</td>
							{showArchived && <td>{formatTimestamp(c['Archived At'])}</td>}
							<td>
								{showArchived ? (
									<form method="POST" style="display:inline" onsubmit="return confirm('Restore this client? It will reappear everywhere in the app.')">
										<input type="hidden" name="_action" value="restore-client" />
										<input type="hidden" name="clientId" value={c['Client ID']} />
										<button type="submit" class="link-button">restore</button>
									</form>
								) : (
									<>
										<form method="POST" style="display:inline">
											<input type="hidden" name="_action" value="duplicate-client" />
											<input type="hidden" name="clientId" value={c['Client ID']} />
											<button type="submit" class="link-button">duplicate</button>
										</form>
										{' · '}
										<form
											method="POST"
											style="display:inline"
											onsubmit="return confirm('Delete this client? It will be archived and removed from view everywhere in the app.')"
										>
											<input type="hidden" name="_action" value="delete-client" />
											<input type="hidden" name="clientId" value={c['Client ID']} />
											<button type="submit" class="link-button">delete</button>
										</form>
									</>
								)}
							</td>
						</tr>
					))
				}
				{clients.length === 0 && <tr><td colspan={showArchived ? 6 : 5}>{showArchived ? 'No deleted clients.' : 'No clients yet.'}</td></tr>}
			</tbody>
		</table>

	</main>

</BaseLayout>
