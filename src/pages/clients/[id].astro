---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { createRow, findById, listActiveRows, updateRow } from '../../lib/sheets';
import { clientConfig } from '../../lib/models/client';
import { propertyConfig, PROPERTY_TYPES, MAINTENANCE_FREQUENCY_OPTIONS } from '../../lib/models/property';
import { formatPhoneDigits } from '../../lib/phoneFormat';
import { googleMapsUrl, fullAddress } from '../../lib/mapsLink';
import { qboEstimateWebUrl, qboInvoiceWebUrl, suggestQBLinksForClient } from '../../lib/qb/matching';

const { id } = Astro.params;
let error: string | null = null;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = String(form.get('_action') ?? '');
	try {
		if (action === 'update-client') {
			await updateRow(env, clientConfig, id!, {
				'First Name': String(form.get('firstName') ?? ''),
				'Last Name': String(form.get('lastName') ?? ''),
				Phone: formatPhoneDigits(String(form.get('phone') ?? '')),
				Email: String(form.get('email') ?? ''),
				'Referral Source': String(form.get('referralSource') ?? ''),
				'Preferred Contact Method': String(form.get('preferredContactMethod') ?? ''),
				Notes: String(form.get('notes') ?? ''),
			});
		} else if (action === 'add-property') {
			const newProperty = await createRow(env, propertyConfig, {
				id: String(form.get('id') ?? ''),
				'Client ID': id!,
				'Property Type': String(form.get('propertyType') ?? '') as (typeof PROPERTY_TYPES)[number],
				'Street Address': String(form.get('streetAddress') ?? ''),
				City: String(form.get('city') ?? ''),
				State: String(form.get('state') ?? ''),
				Zip: String(form.get('zip') ?? ''),
				Stories: String(form.get('stories') ?? ''),
				'Total Window Units': String(form.get('totalWindowUnits') ?? ''),
				'Total Glass Panes': String(form.get('totalGlassPanes') ?? ''),
				'Desired Maintenance Frequency': String(form.get('desiredMaintenanceFrequency') ?? ''),
				'Building/Complex Name': String(form.get('buildingComplexName') ?? ''),
				'Unit Identifier': String(form.get('unitIdentifier') ?? ''),
			});
			// Straight to the full property page — that's where every other
			// characteristic (and the Save button for editing them) lives, so
			// there's no separate "add" vs "save" surface to get lost between.
			return Astro.redirect(`/properties/${newProperty['Property ID']}`);
		}
		return Astro.redirect(`/clients/${id}`);
	} catch (e) {
		error = (e as Error).message;
	}
}

const client = await findById(env, clientConfig, id!);
if (!client) {
	return new Response('Client not found', { status: 404 });
}

const allProperties = await listActiveRows(env, propertyConfig);
const properties = allProperties.filter((p) => p['Client ID'] === id);
const newPropertyId = crypto.randomUUID();

const qbLinked = client['QB Customer ID'] ? await suggestQBLinksForClient(env, id!) : null;
---

<BaseLayout title={`${client['First Name']} ${client['Last Name']}`}>
	<main>
		<p><a href="/clients">← Clients</a></p>
		<h1>{client['First Name']} {client['Last Name']}</h1>
		{error && <p role="alert">{error}</p>}

		<form method="POST" id="update-client-form">
			<input type="hidden" name="_action" value="update-client" />
			<label>First name <input type="text" name="firstName" value={client['First Name']} required /></label>
			<label>Last name <input type="text" name="lastName" value={client['Last Name']} required /></label>
			<label>Phone <input type="tel" name="phone" inputmode="numeric" value={client.Phone} placeholder="303-931-3903" /></label>
			<label>Email <input type="email" name="email" value={client.Email} /></label>
			<label>Referral source <input type="text" name="referralSource" value={client['Referral Source']} /></label>
			<label>Preferred contact method <input type="text" name="preferredContactMethod" value={client['Preferred Contact Method']} /></label>
			<label>Notes <textarea name="notes">{client.Notes}</textarea></label>
			<button type="submit">Save</button>
		</form>

		<h2>Properties</h2>
		<ul>
			{properties.map((p) => (
				<li>
					<a href={`/properties/${p['Property ID']}`}>{p['Street Address']}, {p.City}</a>
					{' '}
					<a href={googleMapsUrl(fullAddress(p))} target="_blank" rel="noopener noreferrer">(map)</a>
				</li>
			))}
			{properties.length === 0 && <li>No properties yet.</li>}
		</ul>

		<h3>Add property</h3>
		<form method="POST">
			<input type="hidden" name="_action" value="add-property" />
			<input type="hidden" name="id" value={newPropertyId} />
			<label>
				Property type
				<select name="propertyType" required>
					<option value="" />
					{PROPERTY_TYPES.map((t) => <option value={t}>{t}</option>)}
				</select>
			</label>
			<label>Street address <input type="text" name="streetAddress" required /></label>
			<label>City <input type="text" name="city" /></label>
			<label>State <input type="text" name="state" maxlength="2" placeholder="CO" /></label>
			<label>Zip <input type="text" name="zip" /></label>
			<label>Stories <input type="number" class="field-numeric" name="stories" /></label>
			<label>Total window units (subjective — what counts as one "window" varies) <input type="number" class="field-numeric" name="totalWindowUnits" /></label>
			<label>Total panes (all glass — objective count) <input type="number" class="field-numeric" name="totalGlassPanes" /></label>
			<label>
			Desired maintenance frequency
			<select name="desiredMaintenanceFrequency">
				<option value="" selected />
				{MAINTENANCE_FREQUENCY_OPTIONS.map((v) => <option value={v}>{v}</option>)}
			</select>
		</label>
			<label>Building/complex name (optional — groups units in the same building) <input type="text" name="buildingComplexName" /></label>
			<label>Unit identifier (optional) <input type="text" name="unitIdentifier" /></label>
			<button type="submit">Add property</button>
		</form>

		<section class="card">
			<h2>QuickBooks</h2>
			{client['QB Customer ID'] ? (
				<>
					<p>Linked to QB Customer <code>{client['QB Customer ID']}</code></p>
					<h3>Estimates ({qbLinked?.estimates.length ?? 0})</h3>
					<ul>
						{qbLinked?.estimates.map((e) => (
							<li><a href={qboEstimateWebUrl(e['QB Estimate ID'])} target="_blank" rel="noopener noreferrer">{e['Doc Number'] || e['QB Estimate ID']}</a> — {e.Status} — ${e.Total} ({e['Txn Date']})</li>
						))}
						{(qbLinked?.estimates.length ?? 0) === 0 && <li>None synced.</li>}
					</ul>
					<h3>Invoices ({qbLinked?.invoices.length ?? 0})</h3>
					<ul>
						{qbLinked?.invoices.map((i) => (
							<li><a href={qboInvoiceWebUrl(i['QB Invoice ID'])} target="_blank" rel="noopener noreferrer">{i['Doc Number'] || i['QB Invoice ID']}</a> — {i.Status} — ${i.Total} (balance ${i.Balance}, due {i['Due Date']})</li>
						))}
						{(qbLinked?.invoices.length ?? 0) === 0 && <li>None synced.</li>}
					</ul>
					<h3>Payments ({qbLinked?.payments.length ?? 0})</h3>
					<ul>
						{qbLinked?.payments.map((p) => (
							<li>${p.Total} — {p['Payment Date']} — {p.Method} {p['Linked Invoice IDs'] && <>(applied to invoice(s) {p['Linked Invoice IDs']})</>}</li>
						))}
						{(qbLinked?.payments.length ?? 0) === 0 && <li>None synced.</li>}
					</ul>
				</>
			) : (
				<p>Not linked to QuickBooks yet — see the <a href="/qb-match-review">match review queue</a>.</p>
			)}
		</section>
	</main>

	<script>
		import { formatPhoneDigits } from '../../lib/phoneFormat';
		const form = document.getElementById('update-client-form') as HTMLFormElement;
		const phone = form.querySelector('input[name="phone"]') as HTMLInputElement;
		phone.addEventListener('input', () => {
			phone.value = formatPhoneDigits(phone.value);
		});
	</script>
</BaseLayout>
