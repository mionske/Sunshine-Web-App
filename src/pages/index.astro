---
import BaseLayout from '../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { listActiveRows, updateRow } from '../lib/sheets';
import { pipelineConfig } from '../lib/models/pipeline';
import { clientConfig } from '../lib/models/client';
import { propertyConfig } from '../lib/models/property';
import { jobConfig } from '../lib/models/job';
import { walkthroughConfig } from '../lib/models/walkthrough';
import { quoteConfig } from '../lib/models/quote';
import { qbInvoiceConfig } from '../lib/models/qbInvoice';
import { calibrationExclusionReasons, getLatestCalibrationSnapshot, isCalibrationEligible, mean, median } from '../lib/pricing/calibration';
import { getActivePricingConfig } from '../lib/pricing/config';
import { googleMapsUrl, fullAddress } from '../lib/mapsLink';
import { listEventsInRange, type CalendarEvent } from '../lib/calendar/client';

// Phase 8 (follow-up reminders) and the dashboard redesign are the same
// page: every reminder type the spec asks for (Quote follow-up,
// Walkthrough follow-up, Schedule accepted job, Collect payment, Request
// review, Seasonal service reminder) is fully derivable from fields
// that already exist on Pipeline/Walkthroughs/Jobs/Properties, so no
// separate Tasks tab was needed — this only ever surfaces reminders in
// the app, never sends anything automatically.

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = String(form.get('_action') ?? '');
	if (action === 'dismiss-walkthrough-followup') {
		const walkthroughId = String(form.get('walkthroughId') ?? '');
		await updateRow(env, walkthroughConfig, walkthroughId, { 'Follow-up Dismissed (Y/N)': 'Y' });
	}
	return Astro.redirect('/');
}

const today = new Date().toISOString().slice(0, 10);

const [opportunities, clients, properties, jobs, walkthroughs, quotes, qbInvoices, snapshot, pricingConfig] = await Promise.all([
	listActiveRows(env, pipelineConfig),
	listActiveRows(env, clientConfig),
	listActiveRows(env, propertyConfig),
	listActiveRows(env, jobConfig),
	listActiveRows(env, walkthroughConfig),
	listActiveRows(env, quoteConfig),
	listActiveRows(env, qbInvoiceConfig),
	getLatestCalibrationSnapshot(env),
	// Residential explicitly, as the primary segment — a single dashboard
	// stat can't represent every Property Type's target rate at once; full
	// per-segment reporting is later phase scope.
	getActivePricingConfig(env, 'Residential'),
]);

// --- Calendar (Today / This Week) -------------------------------------------
// Google Calendar is the actual source of truth for scheduled walkthroughs/
// appointments today — this app has no in-app walkthrough-scheduling concept
// of its own (Walkthroughs only ever get created the moment the field visit
// starts). Reads via the same service account already used for Sheets (see
// lib/calendar/client.ts) — the business shares its calendar with that
// account, view-only, no separate OAuth login. A failure here (API not
// enabled, calendar unshared, transient error) never breaks the Dashboard —
// it just quietly omits the calendar sections with a one-line note.
const CALENDAR_TZ = 'America/Denver';
function denverDateStr(date: Date): string {
	return new Intl.DateTimeFormat('en-CA', { timeZone: CALENDAR_TZ, year: 'numeric', month: '2-digit', day: '2-digit' }).format(date);
}
const todayInCalendarTz = denverDateStr(new Date());
// Weekday math on the plain date string is timezone-safe (a calendar date's
// day-of-week doesn't depend on what offset it's parsed with) — only actual
// event times need the explicit America/Denver conversion above.
const todayWeekday = new Date(`${todayInCalendarTz}T00:00:00Z`).getUTCDay(); // 0=Sun..6=Sat
const daysSinceMonday = (todayWeekday + 6) % 7;
const weekDates: string[] = Array.from({ length: 7 }, (_, i) => {
	const d = new Date(`${todayInCalendarTz}T00:00:00Z`);
	d.setUTCDate(d.getUTCDate() - daysSinceMonday + i);
	return d.toISOString().slice(0, 10);
});
const WEEKDAY_LABELS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

const calendarEventsByDate = new Map<string, CalendarEvent[]>(weekDates.map((d) => [d, []]));
let calendarError = '';
try {
	// Padded a day on each side of the week so no DST/offset edge case can
	// clip an event out of the fetch window before it's bucketed by its real
	// America/Denver calendar date below.
	const timeMin = `${weekDates[0]}T00:00:00Z`;
	const timeMax = new Date(new Date(`${weekDates[6]}T00:00:00Z`).getTime() + 2 * 24 * 60 * 60 * 1000).toISOString();
	const events = await listEventsInRange(env, timeMin, timeMax);
	for (const e of events) {
		const eventDate = e.allDay ? e.start.slice(0, 10) : denverDateStr(new Date(e.start));
		calendarEventsByDate.get(eventDate)?.push(e);
	}
} catch (error) {
	calendarError = (error as Error).message;
}
const todayCalendarEvents = calendarEventsByDate.get(todayInCalendarTz) ?? [];
function eventTimeLabel(e: CalendarEvent): string {
	if (e.allDay) return 'All day';
	return new Date(e.start).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: CALENDAR_TZ });
}

// Once a Job is linked to a real synced QBInvoice, QuickBooks' own Balance
// is authoritative for "is this actually paid" — the app's own manually-set
// 'Payment Status' (Job Day mode's own field, set at completion time,
// often before any invoice exists yet) is only a fallback for jobs that
// have no QuickBooks link at all.
const qbInvoiceById = new Map(qbInvoices.map((i) => [i['QB Invoice ID'], i]));
function isJobPaid(j: (typeof jobs)[number]): boolean {
	const linkedInvoice = j['QB Invoice ID'] ? qbInvoiceById.get(j['QB Invoice ID']) : undefined;
	if (linkedInvoice) return Number(linkedInvoice.Balance) <= 0;
	return j['Payment Status'] === 'Paid in Full';
}

const clientById = Object.fromEntries(clients.map((c) => [c['Client ID'], c]));
const propertyById = Object.fromEntries(properties.map((p) => [p['Property ID'], p]));

function clientNameFor(clientId: string): string {
	const c = clientById[clientId];
	return c ? `${c['First Name']} ${c['Last Name']}` : clientId;
}
function addressFor(propertyId: string): string {
	const p = propertyById[propertyId];
	return p ? fullAddress(p) : '';
}

const COMPLETED_JOB_STATUSES = new Set(['Completed', 'Invoiced', 'Paid']);
const completedJobs = jobs.filter((j) => COMPLETED_JOB_STATUSES.has(j['Job Status']));

// --- Today -----------------------------------------------------------------

const OPEN_PIPELINE_STAGES = new Set(['New Lead', 'Contacted', 'Walkthrough Scheduled', 'Quote Draft', 'Quote Sent', 'Follow-up']);
const quoteFollowUps = opportunities
	.filter((o) => OPEN_PIPELINE_STAGES.has(o.Stage) && o['Next Follow-up Date'] && o['Next Follow-up Date'] <= today)
	.sort((a, b) => a['Next Follow-up Date'].localeCompare(b['Next Follow-up Date']));

const scheduledJobsToday = jobs.filter((j) => j['Job Status'] === 'Scheduled' && j['Scheduled Date'] && j['Scheduled Date'] <= today);

// Walkthrough follow-up: a walkthrough that happened but never became a
// quote — no arbitrary "days since" threshold, purely status-derived.
const walkthroughFollowUps = walkthroughs.filter(
	(w) => w.Status === 'Completed' && !w['Quote ID'] && w['Follow-up Dismissed (Y/N)'] !== 'Y'
);

// Collect payment: work is done but payment isn't confirmed in full yet.
const unpaidJobs = jobs.filter(
	(j) => (j['Job Status'] === 'Completed' || j['Job Status'] === 'Invoiced') && !isJobPaid(j)
);

// Request review: completed work with no review requested yet, or
// requested but no answer recorded.
const reviewReminders = jobs.filter(
	(j) => COMPLETED_JOB_STATUSES.has(j['Job Status']) && (!j['Review Requested At'] || (!j['Review Left'] || j['Review Left'] === 'Unknown'))
);

// Seasonal service reminder: Jobs' own maintenance follow-up date/status,
// set at job completion from the linked Client's Desired Maintenance
// Frequency (see jobLifecycle.ts's computeNextMaintenanceFollowUpDate).
// Data-ownership separation: this used to also fall back to Properties'
// manually-typed 'Next Recommended Service Date' for properties with no
// completed-job history yet — that field is deprecated (see property.ts),
// and there's no other data to derive a reminder from for a property with
// zero completed jobs, so that fallback is simply gone rather than faked.
const CLOSED_MAINTENANCE_STATUSES = new Set(['Scheduled', 'Declined']);
const maintenanceFollowUps = jobs
	.filter((j) => j['Next Maintenance Follow-up Date'] && j['Next Maintenance Follow-up Date'] <= today && !CLOSED_MAINTENANCE_STATUSES.has(j['Maintenance Follow-up Status']))
	.sort((a, b) => a['Next Maintenance Follow-up Date'].localeCompare(b['Next Maintenance Follow-up Date']));

// --- Pipeline ----------------------------------------------------------------

const newLeadCount = opportunities.filter((o) => o.Stage === 'New Lead').length;
const walkthroughScheduledCount = opportunities.filter((o) => o.Stage === 'Walkthrough Scheduled').length;
const quotesAwaitingResponse = quotes.filter((q) => q['Quote Status'] === 'Sent').length;
const acceptedJobsAwaitingScheduling = jobs.filter((j) => j['Job Status'] === 'Unscheduled');

// --- Recent performance (revenue line chart, toggleable time frame) --------

const RANGE_OPTIONS = ['week', 'month', 'quarter', 'ytd'] as const;
type RangeOption = (typeof RANGE_OPTIONS)[number];
const RANGE_LABELS: Record<RangeOption, string> = { week: 'Last Week', month: 'Last Month', quarter: 'Last Quarter', ytd: 'YTD' };
const requestedRange = Astro.url.searchParams.get('range');
const selectedRange: RangeOption = (RANGE_OPTIONS as readonly string[]).includes(requestedRange ?? '')
	? (requestedRange as RangeOption)
	: 'month';

const todayDate = new Date(`${today}T00:00:00.000Z`);
function daysAgo(n: number): Date {
	const d = new Date(todayDate);
	d.setUTCDate(d.getUTCDate() - n);
	return d;
}
// Rolling windows for week/month/quarter (matches how most small-business
// dashboards frame "recent" — not calendar-aligned); YTD is the one
// unambiguous calendar-aligned option.
const RANGE_START: Record<RangeOption, Date> = {
	week: daysAgo(6),
	month: daysAgo(29),
	quarter: daysAgo(89),
	ytd: new Date(`${today.slice(0, 4)}-01-01T00:00:00.000Z`),
};
const rangeStart = RANGE_START[selectedRange];
const rangeStartStr = rangeStart.toISOString().slice(0, 10);

const rangeJobs = completedJobs.filter((j) => (j['Date Completed'] || '') >= rangeStartStr && (j['Date Completed'] || '') <= today);
const rangeRevenue = rangeJobs.reduce((sum, j) => sum + (Number(j['Final Price ($)']) || Number((j as Record<string, string>)['Total Revenue ($)']) || 0), 0);
const rangeOnSiteHours = rangeJobs.reduce((sum, j) => sum + (Number(j['Actual Time (hrs)']) || 0), 0);
const rangeRevenuePerHour = rangeOnSiteHours > 0 ? rangeRevenue / rangeOnSiteHours : 0;
const rangeCallbacks = rangeJobs.filter((j) => j['Callback Required (Y/N)']?.toUpperCase() === 'Y').length;

// Bucketing for the chart: daily for week/month (few enough points to read),
// weekly for quarter (~13 points instead of ~90 daily ones), monthly for YTD
// (up to 12). Buckets are built across the whole range up front — including
// zero-revenue days — so the line reflects real gaps instead of skipping them.
const BUCKET_UNIT: Record<RangeOption, 'day' | 'week' | 'month'> = { week: 'day', month: 'day', quarter: 'week', ytd: 'month' };
const bucketUnit = BUCKET_UNIT[selectedRange];

interface RevenueBucket {
	key: string;
	label: string;
	revenue: number;
}
const buckets: RevenueBucket[] = [];
if (bucketUnit === 'day') {
	const numDays = Math.round((todayDate.getTime() - rangeStart.getTime()) / 86400000) + 1;
	for (let i = 0; i < numDays; i++) {
		const d = daysAgo(numDays - 1 - i);
		buckets.push({ key: d.toISOString().slice(0, 10), label: d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }), revenue: 0 });
	}
} else if (bucketUnit === 'week') {
	const numDays = Math.round((todayDate.getTime() - rangeStart.getTime()) / 86400000) + 1;
	const numWeeks = Math.ceil(numDays / 7);
	for (let i = 0; i < numWeeks; i++) {
		const weekStart = new Date(rangeStart);
		weekStart.setUTCDate(weekStart.getUTCDate() + i * 7);
		buckets.push({ key: `w${i}`, label: weekStart.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }), revenue: 0 });
	}
} else {
	const startYear = rangeStart.getUTCFullYear();
	const startMonth = rangeStart.getUTCMonth();
	const numMonths = (todayDate.getUTCFullYear() - startYear) * 12 + (todayDate.getUTCMonth() - startMonth) + 1;
	for (let i = 0; i < numMonths; i++) {
		const d = new Date(Date.UTC(startYear, startMonth + i, 1));
		buckets.push({ key: `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}`, label: d.toLocaleDateString('en-US', { month: 'short' }), revenue: 0 });
	}
}
const bucketByKey = new Map(buckets.map((b) => [b.key, b]));
function bucketKeyFor(dateStr: string): string {
	if (bucketUnit === 'month') return dateStr.slice(0, 7);
	if (bucketUnit === 'day') return dateStr;
	const d = new Date(`${dateStr}T00:00:00.000Z`);
	const daysSinceStart = Math.floor((d.getTime() - rangeStart.getTime()) / 86400000);
	return `w${Math.floor(daysSinceStart / 7)}`;
}
for (const j of rangeJobs) {
	const dateStr = j['Date Completed'] || '';
	if (!dateStr) continue;
	const bucket = bucketByKey.get(bucketKeyFor(dateStr));
	if (bucket) bucket.revenue += Number(j['Final Price ($)']) || Number((j as Record<string, string>)['Total Revenue ($)']) || 0;
}

// Plain inline SVG (no charting library, matching this app's zero-JS
// convention) — a single-series line needs no legend per the dataviz
// house style, just a title naming what's plotted.
const chartWidth = 640;
const chartHeight = 200;
const chartPad = { top: 16, right: 16, bottom: 8, left: 52 };
const plotWidth = chartWidth - chartPad.left - chartPad.right;
const plotHeight = chartHeight - chartPad.top - chartPad.bottom;
function niceMax(value: number): number {
	if (value <= 0) return 100;
	const magnitude = 10 ** Math.floor(Math.log10(value));
	const normalized = value / magnitude;
	const step = normalized <= 1 ? 1 : normalized <= 2 ? 2 : normalized <= 5 ? 5 : 10;
	return step * magnitude;
}
const chartAxisMax = niceMax(Math.max(...buckets.map((b) => b.revenue), 0));
const chartPoints = buckets.map((b, i) => ({
	...b,
	x: chartPad.left + (buckets.length > 1 ? (i / (buckets.length - 1)) * plotWidth : plotWidth / 2),
	y: chartPad.top + plotHeight - (b.revenue / chartAxisMax) * plotHeight,
}));
const chartPolyline = chartPoints.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
const chartYTicks = [0, 0.5, 1].map((f) => ({ value: chartAxisMax * f, y: chartPad.top + plotHeight - f * plotHeight }));

const targetHourlyRate = Number(pricingConfig?.['Target Hourly Rate'] ?? 0);

// --- Calibration summary -----------------------------------------------------

const eligibleJobs = completedJobs.filter(isCalibrationEligible);
const excludedCount = completedJobs.length - eligibleJobs.length;
const perHourRates = eligibleJobs.map((j) => Number(j['Final Price ($)']) || 0).map((revenue, i) => {
	const hours = Number(eligibleJobs[i]['Actual Time (hrs)']) || 0;
	return hours > 0 ? revenue / hours : 0;
});

// --- Data quality ------------------------------------------------------------

const jobsMissingLaborTime = completedJobs.filter((j) => !(Number(j['Actual Time (hrs)']) > 0));
const jobsMissingDirectCosts = completedJobs.filter((j) => !(Number(j['Total Job Cost']) > 0) && !(Number(j['Supplies Cost']) || Number(j.Gas) || Number(j['Other Expenses'])));
const jobsMissingCallbackInfo = completedJobs.filter((j) => !j['Callback Required (Y/N)']);
const jobsMissingFinalRevenue = completedJobs.filter((j) => !(Number(j['Final Price ($)']) > 0) && !(Number((j as Record<string, string>)['Total Revenue ($)']) > 0));
const propertiesMissingCounts = properties.filter((p) => !(Number(p['Total Window Units']) > 0));
const walkthroughsNotClosed = walkthroughs.filter((w) => w.Status !== 'Converted to Quote' && w.Status !== 'Cancelled');
---

<BaseLayout title="Dashboard">
	<main>
		<h1>Dashboard</h1>
		<p><a href="/historical-entry">+ Add historical record</a> · <a href="/historical-records">View historical records</a></p>

		<section class="card">
			<h2>Today</h2>

			{calendarError ? (
				<p class="field-hint">Calendar unavailable — check today's appointments directly in Google Calendar.</p>
			) : todayCalendarEvents.length > 0 ? (
				<>
					<h3>Appointments today ({todayCalendarEvents.length})</h3>
					<ul>
						{todayCalendarEvents.map((e) => (
							<li>
								<strong>{eventTimeLabel(e)}</strong> —{' '}
								{e.htmlLink ? (
									<a href={e.htmlLink} target="_blank" rel="noopener noreferrer">{e.summary}</a>
								) : (
									e.summary
								)}
								{e.location && <> · {e.location}</>}
							</li>
						))}
					</ul>
				</>
			) : (
				<p class="field-hint">Appointments today: nothing on the calendar.</p>
			)}

			{scheduledJobsToday.length > 0 ? (
				<>
					<h3>Scheduled jobs ({scheduledJobsToday.length})</h3>
					<ul>
						{scheduledJobsToday.map((j) => (
							<li>
								{j['Property Address'] && <a href={googleMapsUrl(j['Property Address'])} target="_blank" rel="noopener noreferrer">{j['Property Address']}</a>}
								{' · '}<a href={`/jobs/${j['Job ID']}`}>Job Day</a>
							</li>
						))}
					</ul>
				</>
			) : (
				<p class="field-hint">Scheduled jobs: none due today.</p>
			)}

			{walkthroughFollowUps.length > 0 ? (
				<>
					<h3>Walkthroughs needing follow-up ({walkthroughFollowUps.length})</h3>
					<ul>
						{walkthroughFollowUps.map((w) => (
							<li>
								{clientNameFor(w['Client ID'])} — {addressFor(w['Property ID'])} · <a href={`/walkthroughs/${w['Walkthrough ID']}`}>view</a>
								{' · '}
								<form method="POST" class="inline-field-form" style="display: inline">
									<input type="hidden" name="_action" value="dismiss-walkthrough-followup" />
									<input type="hidden" name="walkthroughId" value={w['Walkthrough ID']} />
									<button type="submit" class="btn-secondary">Mark quote sent</button>
								</form>
							</li>
						))}
					</ul>
				</>
			) : (
				<p class="field-hint">Walkthroughs needing follow-up: none waiting.</p>
			)}

			{quoteFollowUps.length > 0 ? (
				<>
					<h3>Open follow-ups ({quoteFollowUps.length})</h3>
					<ul>
						{quoteFollowUps.map((o) => (
							<li>
								<strong>{o['Next Follow-up Date']}</strong> —{' '}
								{addressFor(o['Property ID']) ? (
									<a href={googleMapsUrl(addressFor(o['Property ID']))} target="_blank" rel="noopener noreferrer">{addressFor(o['Property ID'])}</a>
								) : (
									o['Property ID']
								)}
								{' '}({clientNameFor(o['Client ID'])}) — <span class="badge">{o.Stage}</span>
							</li>
						))}
					</ul>
				</>
			) : (
				<p class="field-hint">Open follow-ups: nothing overdue.</p>
			)}

			{unpaidJobs.length > 0 ? (
				<>
					<h3>Unpaid jobs ({unpaidJobs.length})</h3>
					<ul>
						{unpaidJobs.map((j) => {
							const linkedInvoice = j['QB Invoice ID'] ? qbInvoiceById.get(j['QB Invoice ID']) : undefined;
							const label = linkedInvoice
								? `QuickBooks: ${linkedInvoice.Status || 'Open'} · balance $${Number(linkedInvoice.Balance).toFixed(2)}`
								: j['Payment Status'] || 'unknown';
							return (
								<li>
									{j['Property Address']} — <span class="badge">{label}</span> · <a href={`/quotes/${j['Quote ID']}`}>view</a>
								</li>
							);
						})}
					</ul>
				</>
			) : (
				<p class="field-hint">Unpaid jobs: nothing outstanding.</p>
			)}
		</section>

		<section class="card">
			<h2>This week</h2>
			{calendarError ? (
				<p class="field-hint">Calendar unavailable: could not load this week's appointments.</p>
			) : (
				<div class="week-glance">
					{weekDates.map((date, i) => {
						const dayEvents = calendarEventsByDate.get(date) ?? [];
						const isToday = date === todayInCalendarTz;
						return (
							<div class={`week-glance-day${isToday ? ' week-glance-day-today' : ''}`}>
								<div class="week-glance-day-label">
									{WEEKDAY_LABELS[i]} {date.slice(5).replace('-', '/')}
								</div>
								{dayEvents.length > 0 ? (
									<ul>
										{dayEvents.map((e) => (
											<li>
												<strong>{eventTimeLabel(e)}</strong>{' '}
												{e.htmlLink ? (
													<a href={e.htmlLink} target="_blank" rel="noopener noreferrer">{e.summary}</a>
												) : (
													e.summary
												)}
											</li>
										))}
									</ul>
								) : (
									<p class="field-hint">Nothing scheduled.</p>
								)}
							</div>
						);
					})}
				</div>
			)}
		</section>

		<div class="card-grid">
			<section class="card">
				<h2>Pipeline</h2>
				<ul>
					<li>New leads: {newLeadCount}</li>
					<li>Walkthroughs scheduled: {walkthroughScheduledCount}</li>
					<li>Quotes awaiting response: {quotesAwaitingResponse}</li>
					<li>Accepted jobs awaiting scheduling: {acceptedJobsAwaitingScheduling.length}</li>
				</ul>
				{acceptedJobsAwaitingScheduling.length > 0 && (
					<ul>
						{acceptedJobsAwaitingScheduling.map((j) => (
							<li>{j['Property Address']} · <a href={`/quotes/${j['Quote ID']}`}>schedule</a></li>
						))}
					</ul>
				)}
			</section>

			<section class="card">
				<h2>Recent performance</h2>
				<div class="button-row" role="tablist" aria-label="Time frame">
					{RANGE_OPTIONS.map((r) => (
						<a
							href={`/?range=${r}`}
							class={selectedRange === r ? 'badge badge-accent' : 'badge'}
							style="text-decoration: none;"
							aria-current={selectedRange === r ? 'true' : undefined}
						>
							{RANGE_LABELS[r]}
						</a>
					))}
				</div>
				<svg viewBox={`0 0 ${chartWidth} ${chartHeight}`} width="100%" role="img" aria-label={`Revenue by ${bucketUnit}, ${RANGE_LABELS[selectedRange]}`}>
					{chartYTicks.map((t) => (
						<>
							<line x1={chartPad.left} y1={t.y} x2={chartWidth - chartPad.right} y2={t.y} stroke="#d8c6ac" stroke-width="1" />
							<text x={chartPad.left - 8} y={t.y + 4} text-anchor="end" font-size="11" fill="#4c545b">${Math.round(t.value).toLocaleString()}</text>
						</>
					))}
					<polyline points={chartPolyline} fill="none" stroke="#012441" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
					{chartPoints.map((p, i) => (
						<circle cx={p.x} cy={p.y} r={i === chartPoints.length - 1 ? 5 : 3} fill="#012441" stroke="#faf5eb" stroke-width="2">
							<title>{p.label}: ${p.revenue.toFixed(0)}</title>
						</circle>
					))}
					{chartPoints.length > 0 && (
						<text
							x={chartPoints[chartPoints.length - 1].x}
							y={Math.max(12, chartPoints[chartPoints.length - 1].y - 10)}
							text-anchor="end"
							font-size="12"
							font-weight="600"
							fill="#012441"
						>
							${chartPoints[chartPoints.length - 1].revenue.toFixed(0)}
						</text>
					)}
				</svg>
				<div class="stats-grid stats-grid-compact" style="margin-bottom: 0;">
					<div class="card"><span class="stat">{rangeJobs.length}</span><span class="stat-label">Completed jobs</span></div>
					<div class="card"><span class="stat">${rangeRevenue.toFixed(0)}</span><span class="stat-label">Revenue</span></div>
					<div class="card"><span class="stat">{rangeOnSiteHours.toFixed(1)}</span><span class="stat-label">On-site hours</span></div>
					<div class="card"><span class="stat">${rangeRevenuePerHour.toFixed(2)}</span><span class="stat-label">Revenue/on-site hr</span></div>
					<div class="card"><span class="stat">{rangeCallbacks}</span><span class="stat-label">Callbacks</span></div>
				</div>
			</section>
		</div>

		<div class="card-grid">
			<section class="card">
				<h2>Calibration</h2>
				{snapshot ? (
					<>
						<p><span class="badge badge-accent">{snapshot['Confidence Level']}</span> — {snapshot['Comparable Job Count']} comparable jobs — {excludedCount} excluded</p>
						<p>
							Target: ${targetHourlyRate}/on-site hour — Observed average: ${Number(snapshot['Observed Revenue Per Hour']).toFixed(2)}/hour
							{' '}— Observed median: ${median(perHourRates).toFixed(2)}/hour
						</p>
						<p class="field-hint">No automatic pricing changes — see <a href="/calibration">Calibration</a> to review and, if warranted, create a draft PricingConfig for explicit review and activation.</p>
					</>
				) : (
					<p>No calibration data yet — <a href="/calibration">recalculate</a> once jobs are completed.</p>
				)}
			</section>

			<section class="card">
				<h2>Data quality</h2>
				<ul>
					<li>
						Jobs missing labor time: {jobsMissingLaborTime.length}
						{jobsMissingLaborTime.length > 0 && (
							<>
								{' — '}
								{jobsMissingLaborTime.map((j, i) => (
									<>
										{i > 0 && ', '}
										<a href={`/jobs/${j['Job ID']}`}>{j['Property Address'] || j['Job ID']}</a>
									</>
								))}
							</>
						)}
					</li>
					<li>Jobs missing direct costs: {jobsMissingDirectCosts.length}</li>
					<li>Jobs missing callback information: {jobsMissingCallbackInfo.length}</li>
					<li>Jobs missing final revenue: {jobsMissingFinalRevenue.length}</li>
					<li>
						Properties missing window counts: {propertiesMissingCounts.length}
						{propertiesMissingCounts.length > 0 && (
							<>
								{' — '}
								{propertiesMissingCounts.map((p, i) => (
									<>
										{i > 0 && ', '}
										<a href={`/properties/${p['Property ID']}`}>{p['Street Address'] || p['Property ID']}</a>
									</>
								))}
							</>
						)}
					</li>
					<li>
						Walkthroughs not converted or closed: {walkthroughsNotClosed.length}
						{walkthroughsNotClosed.length > 0 && (
							<>
								{' — '}
								{walkthroughsNotClosed.map((w, i) => (
									<>
										{i > 0 && ', '}
										<a href={`/walkthroughs/${w['Walkthrough ID']}`}>{addressFor(w['Property ID']) || w['Walkthrough ID']}</a>
									</>
								))}
							</>
						)}
					</li>
				</ul>
			</section>
		</div>

		<div class="card-grid">
			<section class="card">
				<h2>Maintenance follow-ups due ({maintenanceFollowUps.length})</h2>
				{maintenanceFollowUps.length === 0 ? (
					<p class="field-hint">Nothing due.</p>
				) : (
					<ul>
						{maintenanceFollowUps.map((j) => (
							<li>
								<strong>{j['Next Maintenance Follow-up Date']}</strong> —{' '}
								{j['Property Address'] && <a href={googleMapsUrl(j['Property Address'])} target="_blank" rel="noopener noreferrer">{j['Property Address']}</a>}
								{' '}— <span class="badge">{j['Maintenance Follow-up Status'] || 'Not yet due'}</span>
								{' · '}<a href={`/quotes/${j['Quote ID']}`}>view job</a>
							</li>
						))}
					</ul>
				)}
			</section>

			<section class="card">
				<h2>Requesting reviews ({reviewReminders.length})</h2>
				{reviewReminders.length === 0 ? <p class="field-hint">Nothing pending.</p> : (
					<ul>
						{reviewReminders.map((j) => (
							<li>
								{j['Property Address']} — {j['Review Requested At'] ? `requested ${j['Review Requested At']}, no answer yet` : 'not yet requested'}
								{' · '}<a href={`/quotes/${j['Quote ID']}`}>view job</a>
							</li>
						))}
					</ul>
				)}
			</section>
		</div>
	</main>
</BaseLayout>
