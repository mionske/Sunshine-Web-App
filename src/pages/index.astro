---
import BaseLayout from '../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { listActiveRows, updateRow } from '../lib/sheets';
import { readRows } from '../lib/sheets/rows';
import { pipelineConfig, OPEN_PIPELINE_STAGES, WON_PIPELINE_STAGES } from '../lib/models/pipeline';
import { leadConfig } from '../lib/models/lead';
import { clientConfig } from '../lib/models/client';
import { propertyConfig } from '../lib/models/property';
import { jobConfig } from '../lib/models/job';
import { walkthroughConfig } from '../lib/models/walkthrough';
import { quoteConfig } from '../lib/models/quote';
import { qbInvoiceConfig } from '../lib/models/qbInvoice';
import { qbPaymentConfig } from '../lib/models/qbPayment';
import { getLastSyncAt } from '../lib/qb/sync';
import { formatTimestamp } from '../lib/format';
import { googleMapsUrl, fullAddress } from '../lib/mapsLink';
import { listEventsInRange, type CalendarEvent } from '../lib/calendar/client';

// Four sections, in the order the day actually runs: what's happening
// today, what's stuck, where the sales work stands, and how the month is
// going. Anything that isn't one of those four is gone from here:
// Calibration is its own Admin page (/calibration, already in the Admin
// nav menu, so this page doesn't repeat the link), and the Data Quality
// checklist was dropped outright rather than kept as a sixth thing to
// scroll past every morning.
//
// Empty means absent: every block below is rendered only when it has rows.
// There are no "Nothing due." placeholders — a quiet day should look
// quiet, not like a wall of negations.

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = String(form.get('_action') ?? '');
	if (action === 'dismiss-walkthrough-followup') {
		const walkthroughId = String(form.get('walkthroughId') ?? '');
		await updateRow(env, walkthroughConfig, walkthroughId, { 'Follow-up Dismissed (Y/N)': 'Y' });
	}
	return Astro.redirect('/');
}

const today = new Date().toISOString().slice(0, 10);

const [opportunities, leads, clients, properties, jobs, walkthroughs, quotes, qbInvoices, qbPayments] = await Promise.all([
	listActiveRows(env, pipelineConfig),
	listActiveRows(env, leadConfig),
	listActiveRows(env, clientConfig),
	listActiveRows(env, propertyConfig),
	listActiveRows(env, jobConfig),
	listActiveRows(env, walkthroughConfig),
	listActiveRows(env, quoteConfig),
	listActiveRows(env, qbInvoiceConfig),
	listActiveRows(env, qbPaymentConfig),
]);

// --- QuickBooks freshness ----------------------------------------------------
// Every QuickBooks-derived figure on this page comes from the local mirror
// tabs, which only change when the owner presses "Sync now" on QB Settings.
// This reads the KV value that sync writes — never QuickBooks itself; no
// page render in this app is allowed to produce API traffic.
let lastSyncAt: string | null = null;
try {
	lastSyncAt = await getLastSyncAt(env.QB_TOKENS);
} catch {
	lastSyncAt = null;
}
const qbAsOf = lastSyncAt ? `last manual sync (${formatTimestamp(lastSyncAt)})` : 'no manual sync yet';

// --- Calendar ----------------------------------------------------------------
// Google Calendar is the actual source of truth for scheduled walkthroughs/
// appointments — this app has no in-app appointment-time concept of its own
// (Jobs carry a Scheduled Date but no time or arrival window, and
// Walkthroughs only ever get created the moment the field visit starts), so
// the event times below are the only "arrival window" that exists. Reads via
// the same service account already used for Sheets (see
// lib/calendar/client.ts). A failure here never breaks the Dashboard — it
// just leaves a one-line note in place of the calendar rows.
const CALENDAR_TZ = 'America/Denver';
function denverDateStr(date: Date): string {
	return new Intl.DateTimeFormat('en-CA', { timeZone: CALENDAR_TZ, year: 'numeric', month: '2-digit', day: '2-digit' }).format(date);
}
const todayInCalendarTz = denverDateStr(new Date());
// Weekday math on the plain date string is timezone-safe (a calendar date's
// day-of-week doesn't depend on what offset it's parsed with) — only actual
// event times need the explicit America/Denver conversion above.
const todayWeekday = new Date(`${todayInCalendarTz}T00:00:00Z`).getUTCDay(); // 0=Sun..6=Sat
const daysSinceMonday = (todayWeekday + 6) % 7;
// Two weeks, because by Thursday "this week" is mostly answered and the
// question that matters is what's coming. Rendered as two rows of seven
// rather than one row of fourteen: at fourteen columns a day cell is too
// narrow to hold an appointment title, which is the only thing the strip is
// for.
const CALENDAR_DAYS = 14;
const calendarDates: string[] = Array.from({ length: CALENDAR_DAYS }, (_, i) => {
	const d = new Date(`${todayInCalendarTz}T00:00:00Z`);
	d.setUTCDate(d.getUTCDate() - daysSinceMonday + i);
	return d.toISOString().slice(0, 10);
});
const weekDates = calendarDates.slice(0, 7);
const nextWeekDates = calendarDates.slice(7);
const WEEKDAY_LABELS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

const calendarEventsByDate = new Map<string, CalendarEvent[]>(calendarDates.map((d) => [d, []]));
let calendarError = '';
try {
	// Padded a day on each side of the range so no DST/offset edge case can
	// clip an event out of the fetch window before it's bucketed by its real
	// America/Denver calendar date below. Widening from one week to two costs
	// no extra request — it's the same single call with a longer window.
	const timeMin = `${calendarDates[0]}T00:00:00Z`;
	const timeMax = new Date(
		new Date(`${calendarDates[CALENDAR_DAYS - 1]}T00:00:00Z`).getTime() + 2 * 24 * 60 * 60 * 1000
	).toISOString();
	const events = await listEventsInRange(env, timeMin, timeMax);
	for (const e of events) {
		const eventDate = e.allDay ? e.start.slice(0, 10) : denverDateStr(new Date(e.start));
		calendarEventsByDate.get(eventDate)?.push(e);
	}
} catch (error) {
	calendarError = (error as Error).message;
}
const todayCalendarEvents = calendarEventsByDate.get(todayInCalendarTz) ?? [];
const weekEventCount = weekDates.reduce((n, d) => n + (calendarEventsByDate.get(d)?.length ?? 0), 0);
const nextWeekEventCount = nextWeekDates.reduce((n, d) => n + (calendarEventsByDate.get(d)?.length ?? 0), 0);
const calendarEventCount = weekEventCount + nextWeekEventCount;

// Both rows render whenever either has anything, so the strip doesn't change
// shape as the week empties out — and "nothing left this week" is itself
// worth seeing next to what's coming.
const CALENDAR_ROWS = [
	{ heading: 'This week', dates: weekDates },
	{ heading: 'Next week', dates: nextWeekDates },
];
function eventTimeLabel(e: CalendarEvent): string {
	if (e.allDay) return 'All day';
	return new Date(e.start).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: CALENDAR_TZ });
}

/**
 * Whether an appointment's time has already passed.
 *
 * Deliberately NOT "completed" — nothing here knows whether the work
 * actually happened, so past events are dimmed rather than struck through.
 * A strikethrough would claim something this page can't know, and would read
 * as "cancelled" besides.
 *
 * An all-day event is only past once the whole day is over; one on today's
 * date is still outstanding at 9am, whatever the clock says.
 */
const nowMs = Date.now();
function isPastEvent(e: CalendarEvent): boolean {
	if (e.allDay) return e.start.slice(0, 10) < todayInCalendarTz;
	return new Date(e.end || e.start).getTime() < nowMs;
}

// --- Lookups -----------------------------------------------------------------

const clientById = Object.fromEntries(clients.map((c) => [c['Client ID'], c]));
const propertyById = Object.fromEntries(properties.map((p) => [p['Property ID'], p]));
const jobByQBInvoiceId = new Map(jobs.filter((j) => j['QB Invoice ID']).map((j) => [j['QB Invoice ID'], j]));

function clientNameFor(clientId: string): string {
	const c = clientById[clientId];
	return c ? `${c['First Name']} ${c['Last Name']}`.trim() : clientId;
}
function addressFor(propertyId: string): string {
	const p = propertyById[propertyId];
	return p ? fullAddress(p) : '';
}
/** Where to go to *manage* a job — scheduling, invoicing and the
 * QuickBooks link all live on the quote's own detail page. /jobs/:id is
 * Job Day mode (the in-the-field timer), so it's only linked from Today,
 * and it's the fallback for legacy rows that have no quote. */
function jobHref(j: (typeof jobs)[number]): string {
	return j['Quote ID'] ? `/quotes/${j['Quote ID']}` : `/jobs/${j['Job ID']}`;
}

/** The one-tap contact shortcut used throughout Today: the client's own
 * record plus a `tel:` link when a number is on file. Null when the row
 * isn't linked to a client at all, rather than a half-filled placeholder. */
interface Contact {
	clientId: string;
	name: string;
	phone: string;
}
function contactFor(clientId: string): Contact | null {
	const c = clientById[clientId];
	if (!c) return null;
	return { clientId, name: `${c['First Name']} ${c['Last Name']}`.trim(), phone: c.Phone };
}
function contactForProperty(propertyId: string): Contact | null {
	const p = propertyById[propertyId];
	return p ? contactFor(p['Client ID']) : null;
}

// --- 1. Today ----------------------------------------------------------------

// Anything still flagged Scheduled on or before today — a job that slipped a
// day is exactly what needs to be on today's list, not silently dropped.
const todayJobs = jobs
	.filter((j) => j['Job Status'] === 'Scheduled' && j['Scheduled Date'] && j['Scheduled Date'] <= today)
	.map((j) => ({
		jobId: j['Job ID'],
		address: j['Property Address'] || addressFor(j['Property ID']),
		scheduledDate: j['Scheduled Date'],
		contact: contactForProperty(j['Property ID']),
	}));

const todayWalkthroughs = walkthroughs
	.filter((w) => w['Walkthrough Date'] === today && w.Status !== 'Cancelled')
	.map((w) => ({
		walkthroughId: w['Walkthrough ID'],
		status: w.Status,
		address: addressFor(w['Property ID']),
		contact: contactFor(w['Client ID']),
	}));

const hasToday = todayCalendarEvents.length > 0 || todayJobs.length > 0 || todayWalkthroughs.length > 0;
const showTodaySection = hasToday || calendarEventCount > 0 || Boolean(calendarError);

// --- 2. Needs Attention ------------------------------------------------------

// Imported, not re-declared — this list drifted out of step with the model
// the last time the stage set changed.
const OPEN_STAGES = new Set<string>(OPEN_PIPELINE_STAGES);
const opportunityFollowUps = opportunities
	.filter((o) => OPEN_STAGES.has(o.Stage) && o['Next Follow-up Date'] && o['Next Follow-up Date'] <= today)
	.sort((a, b) => a['Next Follow-up Date'].localeCompare(b['Next Follow-up Date']));

// Same pattern against the Leads tab (see lib/models/lead.ts) — Won/Lost
// leads are already archived out of listActiveRows.
const leadFollowUps = leads
	.filter((l) => l['Next Follow-up Date'] && l['Next Follow-up Date'] <= today)
	.sort((a, b) => a['Next Follow-up Date'].localeCompare(b['Next Follow-up Date']));

// A walkthrough that happened but never became a quote — no arbitrary "days
// since" threshold, purely status-derived. Dismissed by the POST handler above.
const walkthroughFollowUps = walkthroughs.filter(
	(w) => w.Status === 'Completed' && !w['Quote ID'] && w['Follow-up Dismissed (Y/N)'] !== 'Y'
);

// Accepted quotes not yet scheduled: quote acceptance is what creates the
// Job row, so an Unscheduled job *is* an accepted quote with no date on it.
const unscheduledJobs = jobs.filter((j) => j['Job Status'] === 'Unscheduled');

// QuickBooks is the source of truth for invoices, so "not invoiced" means
// "no QuickBooks invoice linked to this job" (see lib/qb/recordLinking.ts).
const uninvoicedJobs = jobs.filter((j) => j['Job Status'] === 'Completed' && !j['QB Invoice ID']);

const unpaidInvoices = qbInvoices
	.filter((i) => Number(i.Balance) > 0)
	.sort((a, b) => (a['Due Date'] || '').localeCompare(b['Due Date'] || ''));

// Sync failures newer than the last success. logActivity writes both
// outcomes to ActivityLog under Entity Type "QBSync" (see lib/qb/sync.ts);
// once a later sync succeeds, the earlier failure is resolved and drops off.
let qbSyncErrors: Array<{ timestamp: string; notes: string }> = [];
try {
	const qbSyncLog = (await readRows(env, 'ActivityLog', { idColumn: 'Activity ID' }))
		.map((r) => r.data)
		.filter((r) => r['Entity Type'] === 'QBSync')
		.sort((a, b) => String(b.Timestamp ?? '').localeCompare(String(a.Timestamp ?? '')));
	const lastSuccessAt = String(qbSyncLog.find((r) => String(r.Action ?? '').includes('succeeded'))?.Timestamp ?? '');
	qbSyncErrors = qbSyncLog
		.filter((r) => String(r.Action ?? '').includes('failed') && String(r.Timestamp ?? '') > lastSuccessAt)
		.map((r) => ({ timestamp: String(r.Timestamp ?? ''), notes: String(r.Notes ?? '') }));
} catch {
	// ActivityLog is a plain read — a transient Sheets blip here shouldn't
	// take the whole Dashboard down, it just means no error rows this load.
	qbSyncErrors = [];
}

// Seasonal service reminder: Jobs' own maintenance follow-up date/status,
// set at job completion from the linked Client's Desired Maintenance
// Frequency (see jobLifecycle.ts's computeNextMaintenanceFollowUpDate).
// Kept here rather than dropped because it's genuinely date-gated — it only
// ever lists work that is due now, the same shape as the follow-ups above.
const CLOSED_MAINTENANCE_STATUSES = new Set(['Scheduled', 'Declined']);
const maintenanceFollowUps = jobs
	.filter((j) => j['Next Maintenance Follow-up Date'] && j['Next Maintenance Follow-up Date'] <= today && !CLOSED_MAINTENANCE_STATUSES.has(j['Maintenance Follow-up Status']))
	.sort((a, b) => a['Next Maintenance Follow-up Date'].localeCompare(b['Next Maintenance Follow-up Date']));

const needsAttentionCount =
	opportunityFollowUps.length +
	leadFollowUps.length +
	walkthroughFollowUps.length +
	unscheduledJobs.length +
	uninvoicedJobs.length +
	unpaidInvoices.length +
	qbSyncErrors.length +
	maintenanceFollowUps.length;

// --- 3. Pipeline Snapshot ----------------------------------------------------

// Built from the model's own stage constants rather than a hand-written list
// of six labels — the last time the stage set changed, every hardcoded copy
// of it on this page silently stopped matching.
const SNAPSHOT_STAGES = [...OPEN_PIPELINE_STAGES, ...WON_PIPELINE_STAGES];
const pipelineSnapshot = SNAPSHOT_STAGES.map((stage) => {
	const rows = opportunities.filter((o) => o.Stage === stage);
	return {
		stage,
		count: rows.length,
		value: rows.reduce((sum, o) => sum + (Number(o['Estimated Value']) || 0), 0),
	};
});
const pipelineTotalCount = pipelineSnapshot.reduce((n, s) => n + s.count, 0);

// --- 4. This Month -----------------------------------------------------------

// Pinned to the calendar month — the Dashboard no longer offers a range
// selector, so there is exactly one "recent" window and it's the one the
// section is named after.
const monthPrefix = today.slice(0, 7);
const monthLabel = new Date(`${today}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
function inThisMonth(dateStr: string): boolean {
	return Boolean(dateStr) && dateStr.slice(0, 7) === monthPrefix;
}
function sumOf<T>(rows: T[], amount: (row: T) => number): number {
	return rows.reduce((sum, row) => sum + (amount(row) || 0), 0);
}

const quotedThisMonth = quotes.filter((q) => inThisMonth(q['Sent At']));
const approvedThisMonth = quotes.filter((q) => inThisMonth(q['Accepted At']));
const completedThisMonth = jobs.filter((j) => inThisMonth(j['Date Completed']));
const invoicedThisMonth = qbInvoices.filter((i) => inThisMonth(i['Txn Date']));
const collectedThisMonth = qbPayments.filter((p) => inThisMonth(p['Payment Date']));

const totalQuoted = sumOf(quotedThisMonth, (q) => Number(q['Final Quoted Price']));
const totalApproved = sumOf(approvedThisMonth, (q) => Number(q['Final Quoted Price']));
// 'Total Revenue ($)' is the legacy Jobs column that predates 'Final Price ($)'
// — read through the passthrough schema so historical rows still count.
const totalCompleted = sumOf(completedThisMonth, (j) => Number(j['Final Price ($)']) || Number((j as Record<string, string>)['Total Revenue ($)']));
const totalInvoiced = sumOf(invoicedThisMonth, (i) => Number(i.Total));
const totalCollected = sumOf(collectedThisMonth, (p) => Number(p.Total));
const monthLaborHours = sumOf(completedThisMonth, (j) => Number(j['Actual Time (hrs)']));
const monthRevenuePerHour = monthLaborHours > 0 ? totalCompleted / monthLaborHours : 0;

const monthRowCount = quotedThisMonth.length + approvedThisMonth.length + completedThisMonth.length + invoicedThisMonth.length + collectedThisMonth.length;

const nothingToShow = !showTodaySection && needsAttentionCount === 0 && pipelineTotalCount === 0 && monthRowCount === 0;

function money(amount: number): string {
	return `$${Math.round(amount).toLocaleString()}`;
}
---

<BaseLayout title="Dashboard">
	<main>
		<h1>Dashboard</h1>

		{nothingToShow && (
			<p class="field-hint">Nothing scheduled, nothing waiting, and no activity yet this month.</p>
		)}

		{showTodaySection && (
			<section class="card">
				<h2>Today</h2>

				{calendarError && (
					<p class="field-hint">Calendar unavailable — check appointments directly in Google Calendar.</p>
				)}

				{todayCalendarEvents.length > 0 && (
					<>
						<h3>Appointments ({todayCalendarEvents.length})</h3>
						<ul>
							{todayCalendarEvents.map((e) => (
								<li class={isPastEvent(e) ? 'event-past' : undefined}>
									<strong>{eventTimeLabel(e)}</strong> —{' '}
									{e.htmlLink ? (
										<a href={e.htmlLink} target="_blank" rel="noopener noreferrer">{e.summary}</a>
									) : (
										e.summary
									)}
									{e.location && <> · <a href={googleMapsUrl(e.location)} target="_blank" rel="noopener noreferrer">{e.location}</a></>}
								</li>
							))}
						</ul>
					</>
				)}

				{todayWalkthroughs.length > 0 && (
					<>
						<h3>Walkthroughs ({todayWalkthroughs.length})</h3>
						<ul>
							{todayWalkthroughs.map((w) => (
								<li>
									{w.address ? (
										<a href={googleMapsUrl(w.address)} target="_blank" rel="noopener noreferrer">{w.address}</a>
									) : (
										w.walkthroughId
									)}
									{w.contact && (
										<>
											{' · '}<a href={`/clients/${w.contact.clientId}`}>{w.contact.name}</a>
											{w.contact.phone && <> · <a href={`tel:${w.contact.phone}`}>{w.contact.phone}</a></>}
										</>
									)}
									{' · '}<span class="badge">{w.status}</span>
									{' · '}<a href={`/walkthroughs/${w.walkthroughId}`}>Open walkthrough</a>
								</li>
							))}
						</ul>
					</>
				)}

				{todayJobs.length > 0 && (
					<>
						<h3>Jobs ({todayJobs.length})</h3>
						<ul>
							{todayJobs.map((j) => (
								<li>
									{j.address ? (
										<a href={googleMapsUrl(j.address)} target="_blank" rel="noopener noreferrer">{j.address}</a>
									) : (
										j.jobId
									)}
									{j.scheduledDate < today && <> · <span class="badge">Scheduled {j.scheduledDate}</span></>}
									{j.contact && (
										<>
											{' · '}<a href={`/clients/${j.contact.clientId}`}>{j.contact.name}</a>
											{j.contact.phone && <> · <a href={`tel:${j.contact.phone}`}>{j.contact.phone}</a></>}
										</>
									)}
									{' · '}<a href={`/jobs/${j.jobId}`}>Open Job Day</a>
								</li>
							))}
						</ul>
						<p class="field-hint">Arrival times live on Google Calendar — Jobs carry a scheduled date only.</p>
					</>
				)}

				{calendarEventCount > 0 &&
					CALENDAR_ROWS.map((row) => (
						<div class="week-glance-block">
							<h3>{row.heading}</h3>
							<div class="week-glance">
								{row.dates.map((date, i) => {
									const dayEvents = calendarEventsByDate.get(date) ?? [];
									const isToday = date === todayInCalendarTz;
									return (
										<div class={`week-glance-day${isToday ? ' week-glance-day-today' : ''}`}>
											<div class="week-glance-day-label">
												{WEEKDAY_LABELS[i]} {date.slice(5).replace('-', '/')}
											</div>
											{dayEvents.length > 0 && (
												<ul>
													{dayEvents.map((e) => (
														<li class={isPastEvent(e) ? 'event-past' : undefined}>
															<strong>{eventTimeLabel(e)}</strong>{' '}
															{e.htmlLink ? (
																<a href={e.htmlLink} target="_blank" rel="noopener noreferrer">{e.summary}</a>
															) : (
																e.summary
															)}
														</li>
													))}
												</ul>
											)}
										</div>
									);
								})}
							</div>
						</div>
					))}
			</section>
		)}

		{needsAttentionCount > 0 && (
			<section class="card">
				<h2>Needs Attention ({needsAttentionCount})</h2>

				{opportunityFollowUps.length > 0 && (
					<>
						<h3>Opportunity follow-ups due ({opportunityFollowUps.length})</h3>
						<ul>
							{opportunityFollowUps.map((o) => (
								<li>
									<strong>{o['Next Follow-up Date']}</strong> —{' '}
									{addressFor(o['Property ID']) ? (
										<a href={googleMapsUrl(addressFor(o['Property ID']))} target="_blank" rel="noopener noreferrer">{addressFor(o['Property ID'])}</a>
									) : (
										o['Property ID']
									)}
									{' '}({clientNameFor(o['Client ID'])}) — <span class="badge">{o.Stage}</span>
								</li>
							))}
						</ul>
					</>
				)}

				{leadFollowUps.length > 0 && (
					<>
						<h3>Lead follow-ups due ({leadFollowUps.length})</h3>
						<ul>
							{leadFollowUps.map((l) => (
								<li>
									<strong>{l['Next Follow-up Date']}</strong> —{' '}
									<a href={`/leads/${l['Lead ID']}`}>{l['First Name']} {l['Last Name']}</a>
									{' '}— <span class="badge">{l.Stage}</span>
								</li>
							))}
						</ul>
					</>
				)}

				{walkthroughFollowUps.length > 0 && (
					<>
						<h3>Walkthroughs with no quote yet ({walkthroughFollowUps.length})</h3>
						<ul>
							{walkthroughFollowUps.map((w) => (
								<li>
									{clientNameFor(w['Client ID'])} — {addressFor(w['Property ID'])} · <a href={`/walkthroughs/${w['Walkthrough ID']}`}>view</a>
									{' · '}
									<form method="POST" class="inline-field-form" style="display: inline">
										<input type="hidden" name="_action" value="dismiss-walkthrough-followup" />
										<input type="hidden" name="walkthroughId" value={w['Walkthrough ID']} />
										<button type="submit" class="btn-secondary">Mark quote sent</button>
									</form>
								</li>
							))}
						</ul>
					</>
				)}

				{unscheduledJobs.length > 0 && (
					<>
						<h3>Accepted, not scheduled ({unscheduledJobs.length})</h3>
						<ul>
							{unscheduledJobs.map((j) => (
								<li>
									{j['Property Address'] || addressFor(j['Property ID']) || j['Job ID']}
									{' · '}<a href={jobHref(j)}>schedule</a>
								</li>
							))}
						</ul>
					</>
				)}

				{uninvoicedJobs.length > 0 && (
					<>
						<h3>Completed, not invoiced ({uninvoicedJobs.length})</h3>
						<p class="field-hint">No QuickBooks invoice linked as of {qbAsOf}.</p>
						<ul>
							{uninvoicedJobs.map((j) => (
								<li>
									{j['Property Address'] || addressFor(j['Property ID']) || j['Job ID']}
									{j['Date Completed'] && <> — completed {j['Date Completed']}</>}
									{' · '}<a href={jobHref(j)}>view job</a>
								</li>
							))}
						</ul>
					</>
				)}

				{unpaidInvoices.length > 0 && (
					<>
						<h3>Unpaid invoices ({unpaidInvoices.length})</h3>
						<p class="field-hint">Balances per {qbAsOf} — they may have been paid in QuickBooks since.</p>
						<ul>
							{unpaidInvoices.map((i) => {
								const linkedJob = jobByQBInvoiceId.get(i['QB Invoice ID']);
								return (
									<li>
										{linkedJob?.['Property Address'] || `Invoice ${i['Doc Number'] || i['QB Invoice ID']}`}
										{' — '}<span class="badge">{i.Status || 'Open'} · balance {money(Number(i.Balance))}</span>
										{i['Due Date'] && <> — due {i['Due Date']}</>}
										{linkedJob && <> · <a href={jobHref(linkedJob)}>view job</a></>}
									</li>
								);
							})}
						</ul>
					</>
				)}

				{qbSyncErrors.length > 0 && (
					<>
						<h3>QuickBooks sync errors ({qbSyncErrors.length})</h3>
						<ul>
							{qbSyncErrors.map((e) => (
								<li>
									<strong>{formatTimestamp(e.timestamp)}</strong> — {e.notes}
								</li>
							))}
						</ul>
						<p><a href="/qb-settings">Go to QuickBooks Settings →</a></p>
					</>
				)}

				{maintenanceFollowUps.length > 0 && (
					<>
						<h3>Maintenance follow-ups due ({maintenanceFollowUps.length})</h3>
						<ul>
							{maintenanceFollowUps.map((j) => (
								<li>
									<strong>{j['Next Maintenance Follow-up Date']}</strong> —{' '}
									{j['Property Address'] && <a href={googleMapsUrl(j['Property Address'])} target="_blank" rel="noopener noreferrer">{j['Property Address']}</a>}
									{' '}— <span class="badge">{j['Maintenance Follow-up Status'] || 'Due'}</span>
									{' · '}<a href={jobHref(j)}>view job</a>
								</li>
							))}
						</ul>
					</>
				)}
			</section>
		)}

		{pipelineTotalCount > 0 && (
			<section class="card">
				<h2>Pipeline Snapshot</h2>
				<div class="stats-grid" style="margin-bottom: 0;">
					{pipelineSnapshot.map((s) => (
						<div class="card">
							<span class="stat">{s.count}</span>
							<span class="stat-label">{s.stage} · {money(s.value)}</span>
						</div>
					))}
				</div>
			</section>
		)}

		{monthRowCount > 0 && (
			<section class="card">
				<h2>This Month ({monthLabel})</h2>
				<p class="field-hint">Invoiced and Collected come from QuickBooks per {qbAsOf}; everything else is this app's own data.</p>
				<div class="stats-grid" style="margin-bottom: 0;">
					<div class="card"><span class="stat">{money(totalQuoted)}</span><span class="stat-label">Quoted</span></div>
					<div class="card"><span class="stat">{money(totalApproved)}</span><span class="stat-label">Approved</span></div>
					<div class="card"><span class="stat">{money(totalCompleted)}</span><span class="stat-label">Completed</span></div>
					<div class="card"><span class="stat">{money(totalInvoiced)}</span><span class="stat-label">Invoiced (QuickBooks)</span></div>
					<div class="card"><span class="stat">{money(totalCollected)}</span><span class="stat-label">Collected (QuickBooks)</span></div>
					<div class="card"><span class="stat">{monthLaborHours.toFixed(1)}</span><span class="stat-label">Actual labor hours</span></div>
					<div class="card"><span class="stat">${monthRevenuePerHour.toFixed(2)}</span><span class="stat-label">Revenue per labor hour</span></div>
				</div>
			</section>
		)}
	</main>
</BaseLayout>
