---
import BaseLayout from '../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { listActiveRows } from '../lib/sheets';
import { pipelineConfig } from '../lib/models/pipeline';
import { clientConfig } from '../lib/models/client';
import { propertyConfig } from '../lib/models/property';
import { jobConfig } from '../lib/models/job';
import { getLatestCalibrationSnapshot } from '../lib/pricing/calibration';
import { getActivePricingConfig } from '../lib/pricing/config';

const today = new Date().toISOString().slice(0, 10);
const currentMonthPrefix = today.slice(0, 7); // YYYY-MM

const [opportunities, clients, properties, jobs, snapshot, pricingConfig] = await Promise.all([
	listActiveRows(env, pipelineConfig),
	listActiveRows(env, clientConfig),
	listActiveRows(env, propertyConfig),
	listActiveRows(env, jobConfig),
	getLatestCalibrationSnapshot(env),
	// Residential explicitly, as the primary segment — a single dashboard
	// stat can't represent every Property Type's target rate at once; full
	// per-segment reporting is later phase scope.
	getActivePricingConfig(env, 'Residential'),
]);

const clientById = Object.fromEntries(clients.map((c) => [c['Client ID'], c]));
const propertyById = Object.fromEntries(properties.map((p) => [p['Property ID'], p]));

const OPEN_STAGES = new Set(['New Lead', 'Contacted', 'Walkthrough Scheduled', 'Quote Draft', 'Quote Sent', 'Follow-up']);
const followUps = opportunities
	.filter((o) => OPEN_STAGES.has(o.Stage) && o['Next Follow-up Date'] && o['Next Follow-up Date'] <= today)
	.sort((a, b) => a['Next Follow-up Date'].localeCompare(b['Next Follow-up Date']))
	.map((o) => ({
		opportunity: o,
		clientName: clientById[o['Client ID']]
			? `${clientById[o['Client ID']]['First Name']} ${clientById[o['Client ID']]['Last Name']}`
			: o['Client ID'],
		propertyAddress: propertyById[o['Property ID']]?.['Street Address'] ?? o['Property ID'],
	}));

const thisMonthJobs = jobs.filter((j) => (j['Date Completed'] || '').startsWith(currentMonthPrefix));
const thisMonthRevenue = thisMonthJobs.reduce((sum, j) => {
	const revenue = Number(j['Final Price ($)']) || Number((j as Record<string, string>)['Total Revenue ($)']) || 0;
	return sum + revenue;
}, 0);

const targetHourlyRate = Number(pricingConfig?.['Target Hourly Rate'] ?? 0);

const CLOSED_FOLLOW_UP_STATUSES = new Set(['Scheduled', 'Declined']);
const maintenanceFollowUps = jobs
	.filter(
		(j) =>
			j['Next Maintenance Follow-up Date'] &&
			j['Next Maintenance Follow-up Date'] <= today &&
			!CLOSED_FOLLOW_UP_STATUSES.has(j['Maintenance Follow-up Status'])
	)
	.sort((a, b) => a['Next Maintenance Follow-up Date'].localeCompare(b['Next Maintenance Follow-up Date']));
---

<BaseLayout title="Dashboard">
	<main>
		<h1>Dashboard</h1>
		<p><a href="/historical-entry">+ Add historical record</a></p>

		<div class="card">
			<h2>Follow-ups needed ({followUps.length})</h2>
			{followUps.length === 0 ? (
				<p>Nothing overdue.</p>
			) : (
				<ul>
					{followUps.map(({ opportunity, clientName, propertyAddress }) => (
						<li>
							<strong>{opportunity['Next Follow-up Date']}</strong> — {propertyAddress} ({clientName}) — <span class="badge">{opportunity.Stage}</span>
						</li>
					))}
				</ul>
			)}
		</div>

		<div class="card">
			<h2>Maintenance follow-ups due ({maintenanceFollowUps.length})</h2>
			{maintenanceFollowUps.length === 0 ? (
				<p>Nothing due.</p>
			) : (
				<ul>
					{maintenanceFollowUps.map((j) => (
						<li>
							<strong>{j['Next Maintenance Follow-up Date']}</strong> — {j['Property Address']} —{' '}
							<span class="badge">{j['Maintenance Follow-up Status'] || 'Not yet due'}</span>
							{' · '}<a href={`/quotes/${j['Quote ID']}`}>view job</a>
						</li>
					))}
				</ul>
			)}
		</div>

		<div class="card">
			<h2>This month</h2>
			<div style="display: flex; gap: 3rem;">
				<div>
					<span class="stat">{thisMonthJobs.length}</span>
					<span class="stat-label">Job{thisMonthJobs.length === 1 ? '' : 's'} completed</span>
				</div>
				<div>
					<span class="stat">${thisMonthRevenue.toFixed(0)}</span>
					<span class="stat-label">Revenue</span>
				</div>
			</div>
		</div>

		<div class="card">
			<h2>Calibration</h2>
			{snapshot ? (
				<>
					<p><span class="badge badge-accent">{snapshot['Confidence Level']}</span> — {snapshot['Comparable Job Count']} comparable jobs</p>
					<p>Target: ${targetHourlyRate}/on-site hour — Observed: ${Number(snapshot['Observed Revenue Per Hour']).toFixed(2)}/hour</p>
				</>
			) : (
				<p>No calibration data yet — <a href="/calibration">recalculate</a> once jobs are completed.</p>
			)}
		</div>
	</main>
</BaseLayout>
