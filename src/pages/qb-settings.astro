---
import BaseLayout from '../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { readRows } from '../lib/sheets/rows';
import { buildAuthorizeUrl, disconnectQuickBooks } from '../lib/qb/oauth';
import { getCompanyName, getRawEntityCount } from '../lib/qb/client';
import { getStoredTokens } from '../lib/qb/tokens';
import { getLastSyncAt, runFullSync } from '../lib/qb/sync';
import { formatTimestamp } from '../lib/format';

// Reuses the app's session cookie convention (see lib/auth.ts's
// sessionCookieOptions) for the short-lived OAuth state cookie — same
// httpOnly/secure/sameSite=strict shape, much shorter lifetime.
const STATE_COOKIE_NAME = 'qb_oauth_state';

let error: string | null = null;
let syncResult: string | null = null;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = String(form.get('_action') ?? '');
	try {
		if (action === 'disconnect') {
			await disconnectQuickBooks(env);
			return Astro.redirect('/qb-settings?disconnected=1');
		} else if (action === 'sync-now') {
			const result = await runFullSync(env);
			syncResult = `Customers +${result.customers.created}/${result.customers.updated} · Estimates +${result.estimates.created}/${result.estimates.updated} · Invoices +${result.invoices.created}/${result.invoices.updated} · Payments +${result.payments.created}/${result.payments.updated} · Pipeline +${result.pipeline.created}/${result.pipeline.updated}${result.pipeline.skippedUnlinked > 0 ? ` (${result.pipeline.skippedUnlinked} skipped — link the QB Customer first)` : ''}`;
		}
	} catch (e) {
		error = (e as Error).message;
	}
}

const queryError = Astro.url.searchParams.get('error');
if (queryError) error = queryError;
const justConnected = Astro.url.searchParams.get('connected') === '1';
const justDisconnected = Astro.url.searchParams.get('disconnected') === '1';

const credentialsConfigured = Boolean(env.QB_CLIENT_ID && env.QB_CLIENT_SECRET && env.QB_WEBHOOK_VERIFIER_TOKEN && env.QB_REDIRECT_URI);

// Everything below reads from Sheets/KV and can hit a transient failure
// (e.g. Google Sheets' per-minute read quota) that has nothing to do with
// QuickBooks itself — wrapped so a blip there shows a normal page with an
// error banner instead of a raw framework 500.
let connected = false;
let lastSyncAt: string | null = null;
let authorizeUrl: string | null = null;
let syncHistory: Record<string, string>[] = [];
let companyName: string | null = null;
let companyNameError: string | null = null;
const rawCounts: Record<string, number | string> = {};

try {
	const tokens = await getStoredTokens(env);
	connected = Boolean(tokens);
	lastSyncAt = await getLastSyncAt(env.QB_TOKENS);

	if (connected) {
		// Separate try/catch, deliberately non-fatal: a bad company lookup
		// (or a transient QBO API blip) shouldn't take down the whole page —
		// it's a diagnostic aid (confirms which real company this realmId
		// points at, since a wrong-company connection otherwise only shows up
		// as a silent 0-record sync), not something the page's core function
		// depends on.
		try {
			companyName = await getCompanyName(env);
		} catch (e) {
			companyNameError = (e as Error).message;
		}

		// Raw QBO record counts, entirely independent of this app's own
		// pagination/mapping/upsert path — only run on demand (?diag=1) since
		// it's four extra QBO API calls, not part of normal page load. Exists
		// to answer one question directly: does QuickBooks itself see any
		// records at all for this company, regardless of what our own sync
		// reports.
		if (Astro.url.searchParams.get('diag') === '1') {
			for (const entity of ['Customer', 'Estimate', 'Invoice', 'Payment'] as const) {
				try {
					rawCounts[entity] = await getRawEntityCount(env, entity);
				} catch (e) {
					rawCounts[entity] = `error: ${(e as Error).message}`;
				}
			}
		}
	}

	if (credentialsConfigured && !connected) {
		const state = crypto.randomUUID();
		// Lax, not Strict: this cookie has to survive the round trip through
		// Intuit's own domain — the browser lands back on /api/qb/callback via
		// a cross-site top-level redirect *from* appcenter.intuit.com, and a
		// Strict cookie is dropped on exactly that kind of request. Lax still
		// blocks it from being sent on cross-site POSTs/subresource requests,
		// so this doesn't weaken the CSRF protection the state value provides.
		Astro.cookies.set(STATE_COOKIE_NAME, state, {
			path: '/',
			httpOnly: true,
			secure: import.meta.env.PROD,
			sameSite: 'lax',
			maxAge: 600,
		});
		authorizeUrl = buildAuthorizeUrl(env, state);
	}

	// Sync health: last N QuickBooks sync attempts, newest first — lives in
	// ActivityLog (Entity Type "QBSync") rather than a dedicated tab, per the
	// spec's own "can live in ActivityLog if that's simpler" note.
	const activityRows = await readRows(env, 'ActivityLog', { idColumn: 'Activity ID' });
	syncHistory = activityRows
		.map((r) => r.data)
		.filter((r) => r['Entity Type'] === 'QBSync')
		.sort((a, b) => String(b.Timestamp).localeCompare(String(a.Timestamp)))
		.slice(0, 20);
} catch (e) {
	error = error ?? `Could not load current connection status (${(e as Error).message}) — this is usually transient, try refreshing.`;
}
---

<BaseLayout title="QuickBooks Settings">
	<main>
		<h1>QuickBooks Settings</h1>
		{error && <p role="alert">{error}</p>}
		{justConnected && <p>Connected to QuickBooks.</p>}
		{justDisconnected && <p>Disconnected from QuickBooks.</p>}
		{syncResult && <p>Sync complete — {syncResult}</p>}

		<section class="card">
			<h2>Connection</h2>
			<ul>
				<li>Environment: <span class="badge badge-accent">Production</span></li>
				<li>Credentials configured: {credentialsConfigured ? 'Yes' : 'No — set QB_CLIENT_ID, QB_CLIENT_SECRET, QB_WEBHOOK_VERIFIER_TOKEN, QB_REDIRECT_URI as Cloudflare secrets'}</li>
				<li>Status: <span class="badge">{connected ? 'Connected' : 'Not connected'}</span></li>
				{connected && (
					<li>
						Connected company: {companyName ?? (companyNameError ? `Could not look up (${companyNameError})` : 'Looking up…')}
					</li>
				)}
				<li>Last sync: {lastSyncAt || 'never'}</li>
			</ul>

			{!credentialsConfigured && <p class="field-hint">This app never writes back to QuickBooks — one-way, read-only mirror only. See docs/data-dictionary.md's QuickBooks section for the setup checklist.</p>}

			{credentialsConfigured && !connected && authorizeUrl && (
				<p><a class="btn" href={authorizeUrl}>Connect to QuickBooks</a></p>
			)}

			{connected && (
				<div class="button-row">
					<form method="POST">
						<input type="hidden" name="_action" value="sync-now" />
						<button type="submit">Sync now</button>
					</form>
					<form method="POST">
						<input type="hidden" name="_action" value="disconnect" />
						<button type="submit" class="btn-secondary">Disconnect</button>
					</form>
				</div>
			)}

			{connected && Object.keys(rawCounts).length > 0 && (
				<>
					<h3>Raw QuickBooks record counts</h3>
					<p class="field-hint">Straight from QuickBooks (COUNT query), independent of this app's own sync — for confirming whether QuickBooks itself sees existing records.</p>
					<div class="stats-grid">
						{Object.entries(rawCounts).map(([entity, count]) => (
							<div class="card"><span class="stat">{count}</span><span class="stat-label">{entity}</span></div>
						))}
					</div>
				</>
			)}
			{connected && Object.keys(rawCounts).length === 0 && (
				<p><a href="/qb-settings?diag=1">Show raw QuickBooks record counts →</a></p>
			)}
		</section>

		<section class="card">
			<div class="card-header-row">
				<h2>Sync health</h2>
				<a href="/qb-match-review">Match review queue →</a>
			</div>
			{syncHistory.length === 0 ? (
				<p>No sync attempts yet.</p>
			) : (
				<table>
					<thead>
						<tr><th>Timestamp</th><th>Result</th><th>Details</th></tr>
					</thead>
					<tbody>
						{syncHistory.map((entry) => (
							<tr>
								<td>{formatTimestamp(String(entry.Timestamp ?? ''))}</td>
								<td><span class="badge">{entry.Action}</span></td>
								<td>{entry.Notes}</td>
							</tr>
						))}
					</tbody>
				</table>
			)}
		</section>
	</main>
</BaseLayout>
