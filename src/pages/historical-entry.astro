---
import BaseLayout from '../layouts/BaseLayout.astro';
import HistoricalEntryForm from '../components/HistoricalEntryForm.astro';
import { env } from 'cloudflare:workers';
import { listActiveRows } from '../lib/sheets';
import { clientConfig } from '../lib/models/client';
import { propertyConfig } from '../lib/models/property';
import { saveHistoricalEntry } from '../lib/pricing/historicalEntry';
import {
	emptyFormValues,
	formValuesFromRequest,
	payloadForCreate,
	validateFormValues,
} from '../lib/historicalEntryForm';

// Backfilling a job that predates the app. This is deliberately a compact
// form and not a walkthrough: historical records exist to support pricing
// calibration, and calibration needs the date, the money, the hours and a
// sentence on what the job covered — not a re-created window inventory.
let error: string | null = null;
let values = emptyFormValues({
	clientId: Astro.url.searchParams.get('clientId') ?? '',
	propertyId: Astro.url.searchParams.get('propertyId') ?? '',
});

if (Astro.request.method === 'POST') {
	values = formValuesFromRequest(await Astro.request.formData());
	error = validateFormValues(values);
	if (!error) {
		try {
			await saveHistoricalEntry(env, payloadForCreate(values));
			return Astro.redirect('/historical-records');
		} catch (e) {
			error = (e as Error).message;
		}
	}
}

// The full active lists, not a search API: this is a solo business with a
// client list small enough to render as two <select>s.
const [clients, properties] = await Promise.all([
	listActiveRows(env, clientConfig),
	listActiveRows(env, propertyConfig),
]);
---

<BaseLayout title="Add historical record">
	<main>
		<p><a href="/historical-records">← Historical Records</a></p>
		<h1>Add historical record</h1>
		<p>For a job that already happened, before this app existed.</p>

		<HistoricalEntryForm
			mode="create"
			values={values}
			error={error}
			clients={clients}
			properties={properties}
			cancelHref="/historical-records"
		/>
	</main>
</BaseLayout>
