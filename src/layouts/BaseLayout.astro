---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import '../styles/global.css';

interface Props {
	title: string;
	nav?: boolean;
}
const { title, nav = true } = Astro.props;

// Ordered to match the real lifecycle a record moves through: overview,
// then who/where (Clients/Properties), then the sales funnel (Pipeline),
// then quoting (create via Quoter, review via Quotes), then execution
// (Jobs), then reporting/admin (Calibration, Pricing Config, QuickBooks).
const NAV_LINKS = [
	{ href: '/', label: 'Dashboard' },
	{ href: '/clients', label: 'Clients' },
	{ href: '/properties', label: 'Properties' },
	{ href: '/pipeline', label: 'Pipeline' },
	{ href: '/quoter', label: 'Quoter' },
	{ href: '/quotes', label: 'Quotes' },
	{ href: '/jobs', label: 'Jobs' },
	{ href: '/calibration', label: 'Calibration' },
	{ href: '/pricing-config', label: 'Pricing Config' },
	{ href: '/qb-settings', label: 'QuickBooks' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} — Sunshine Window Works</title>
	</head>
	<body>
		{nav && (
			<header class="app-nav">
				<strong>Sunshine Window Works</strong>
				<nav>
					<ul>
						{NAV_LINKS.map((link) => (
							<li>
								<a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
									{link.label}
								</a>
							</li>
						))}
						<li><a href="/logout">Log out</a></li>
					</ul>
				</nav>
			</header>
		)}
		<slot />
	</body>
</html>
