---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
// Body copy moved from Source Sans 3 to Barlow with the design handoff —
// same family as the condensed display face, so numerals and labels sit
// together instead of reading as two typefaces sharing a page.
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow/700.css';
import '../styles/global.css';

interface Props {
	title: string;
	nav?: boolean;
}
const { title, nav = true } = Astro.props;

// Six places you look things up, in lifecycle order. Everything that
// *creates* a record moved into the Create menu, and every configuration or
// reporting tool into Admin — nav is for navigating, not for doing.
// Two directories — who and where — then the work in the order it actually
// happens: an opportunity becomes a walkthrough, becomes a quote, becomes a
// job. Walkthroughs used to sit before Pipeline, which read backwards.
const NAV_LINKS = [
	{ href: '/', label: 'Dashboard' },
	{ href: '/clients', label: 'Clients' },
	{ href: '/properties', label: 'Properties' },
	{ href: '/pipeline', label: 'Pipeline' },
	// Also the field's front door: starting a walkthrough used to mean finding
	// the right Property first, which is the wrong order when you're standing
	// at the house.
	{ href: '/walkthroughs', label: 'Walkthroughs' },
	{ href: '/quotes', label: 'Quotes' },
	{ href: '/jobs', label: 'Jobs' },
];

// Points at the Walkthroughs list rather than /walkthroughs/new, which
// requires a ?propertyId= and 404s without one — the list page is where the
// property gets picked.
const CREATE_LINKS = [
	{ href: '/leads/new', label: 'New Lead' },
	{ href: '/clients/new', label: 'New Client' },
	{ href: '/walkthroughs', label: 'Start Walkthrough' },
	{ href: '/quoter', label: 'New Quote' },
	{ href: '/historical-entry', label: 'Historical Job' },
];

// Configuration, reporting and maintenance. Leads lives here as a list
// surface — day-to-day lead capture happens through Create and the Pipeline.
const ADMIN_LINKS = [
	{ href: '/leads', label: 'Leads' },
	{ href: '/calibration', label: 'Calibration' },
	{ href: '/pricing-config', label: 'Pricing Config' },
	{ href: '/qb-settings', label: 'QuickBooks' },
	{ href: '/qb-match-review', label: 'QuickBooks Match Review' },
	{ href: '/historical-records', label: 'Historical Records' },
];

const currentPath = Astro.url.pathname;
const inAdmin = ADMIN_LINKS.some((l) => currentPath === l.href);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} — Sunshine Window Works</title>
	</head>
	<body>
		{nav && (
			<header class="app-nav">
				<strong>Sunshine Window Works</strong>
				<nav>
					<ul>
						{NAV_LINKS.map((link) => (
							<li>
								<a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
									{link.label}
								</a>
							</li>
						))}
						{/* Native disclosure — the same <details> pattern used for
						    collapsible sections elsewhere in the app, positioned as a
						    dropdown by .nav-menu in global.css.

						    The shared name= makes them an exclusive group, so opening
						    one closes the other. Without it both stayed open and the
						    Admin panel rendered straight over the Create panel's
						    items. That's plain HTML, not script: the browser enforces
						    it, and a browser too old to know the attribute simply
						    behaves the way it did before. */}
						{/* Everything from here on is an action or a setting, not a
						    place — pushed to the right so the bar reads as
						    "7 destinations + 3 controls" rather than 10 equal items. */}
						<li class="nav-actions-start">
							<details class="nav-menu" name="nav-menu">
								<summary>Create</summary>
								<ul>
									{CREATE_LINKS.map((link) => (
										<li><a href={link.href}>{link.label}</a></li>
									))}
								</ul>
							</details>
						</li>
						<li>
							<details class="nav-menu" name="nav-menu">
								<summary aria-current={inAdmin ? 'page' : undefined}>Admin</summary>
								<ul>
									{ADMIN_LINKS.map((link) => (
										<li>
											<a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
												{link.label}
											</a>
										</li>
									))}
								</ul>
							</details>
						</li>
						<li><a href="/logout">Log out</a></li>
					</ul>
				</nav>
			</header>
		)}
		<slot />
		{nav && (
			<script>
				// Dismissing a menu. Everything else about these dropdowns is
				// native <details>, but "click away to close" and Escape have no
				// HTML equivalent, and a menu that only closes by re-clicking the
				// exact word that opened it is a menu people leave open by
				// accident — which is how the overlap above got noticed.
				//
				// Progressive enhancement: without this the menus still open and
				// close from the summary, exactly as they always did.
				document.addEventListener('click', (event) => {
					for (const menu of document.querySelectorAll('details.nav-menu[open]')) {
						if (!menu.contains(event.target as Node)) menu.open = false;
					}
				});
				document.addEventListener('keydown', (event) => {
					if (event.key !== 'Escape') return;
					for (const menu of document.querySelectorAll('details.nav-menu[open]')) {
						menu.open = false;
						menu.querySelector('summary')?.focus();
					}
				});
			</script>
		)}
	</body>
</html>
